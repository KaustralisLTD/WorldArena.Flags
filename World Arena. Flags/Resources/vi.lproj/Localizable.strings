"FACT_04_DESC" = "Jamaica là quốc gia duy nhất có quốc kỳ không có màu đỏ, trắng hoặc xanh.";
"FACT_05_TITLE" = "Cờ không bao giờ hạ xuống";
"FACT_05_DESC" = "Quốc kỳ của Ả Rập Saudi không bao giờ được treo rủ vì có dòng chữ thiêng liêng trên đó.";
"FACT_06_TITLE" = "Lá cờ non trẻ";
"FACT_06_DESC" = "Quốc kỳ của Nam Sudan được thông qua vào năm 2011 sau khi giành độc lập.";
"FACT_07_TITLE" = "Cờ với AK-47";
"FACT_07_DESC" = "Mozambique là quốc gia duy nhất có cờ có hình vũ khí hiện đại - súng trường Kalashnikov.";
"FACT_08_TITLE" = "Cờ gần như giống hệt nhau";
"FACT_08_DESC" = "Cờ của Romania và Tchad rất giống nhau; chúng thường được phân biệt bằng màu xanh lam.";
"FACT_09_TITLE" = "biểu tượng của Ukraine";
"FACT_09_DESC" = "Cờ xanh và vàng của Ukraine theo truyền thống được hiểu là bầu trời trên cánh đồng lúa mì.";
"FACT_10_TITLE" = "Cờ đơn giản nhất";
"FACT_10_DESC" = "Quốc kỳ Libya từ năm 1977 đến năm 2011 có màu xanh lục đặc, không có biểu tượng hay hoa văn.";
"FACT_11_TITLE" = "Gắn cờ bằng bản đồ";
"FACT_11_DESC" = "Quốc kỳ của Síp thể hiện đường viền của hòn đảo—một trường hợp hiếm gặp trong số các quốc kỳ.";
"FACT_12_TITLE" = "Cờ với một cuốn Kinh Thánh";
"FACT_12_DESC" = "Quốc kỳ của Cộng hòa Dominica có hình một cuốn Kinh thánh mở, khiến đây trở thành quốc kỳ duy nhất có sách tôn giáo.";
"FACT_13_TITLE" = "Màu sắc phổ biến nhất";
"FACT_13_DESC" = "Màu đỏ là màu phổ biến nhất trên quốc kỳ các quốc gia trên toàn thế giới.";
"FACT_14_TITLE" = "Gắn cờ bằng văn bản";
"FACT_14_DESC" = "Dòng chữ trên quốc kỳ rất hiếm; một ví dụ nổi tiếng là Ả Rập Saudi.";
"FACT_15_TITLE" = "nghi thức chào cờ";
"FACT_15_DESC" = "Nhiều quốc gia có những quy định nghiêm ngặt về cách đối xử với quốc kỳ.";
"FACT_16_TITLE" = "Cờ có các mặt khác nhau";
"FACT_16_DESC" = "Paraguay có quốc kỳ duy nhất trên thế giới có thiết kế khác nhau ở mặt trước và mặt sau.";
"FACT_17_TITLE" = "biểu tượng Olympic";
"FACT_17_DESC" = "Màu vòng tròn Olympic được chọn sao cho ít nhất một màu xuất hiện trên lá cờ của mỗi quốc gia.";
"FACT_18_TITLE" = "Cờ có quốc huy phức tạp nhất";
"FACT_18_DESC" = "Quốc kỳ Mexico có hình một con đại bàng đậu trên cây xương rồng ôm một con rắn—một trong những quốc huy chi tiết nhất trên bất kỳ lá cờ nào.";
"FACT_19_TITLE" = "Cờ bắt chước";
"FACT_19_DESC" = "Cờ của Monaco và Indonesia gần như giống hệt nhau – màu đỏ ở trên, màu trắng ở dưới. Sự khác biệt duy nhất là tỷ lệ.";
"FACT_20_TITLE" = "Lá cờ có 50 ngôi sao";
"FACT_20_DESC" = "Quốc kỳ Hoa Kỳ có 50 ngôi sao, mỗi ngôi sao tượng trưng cho một tiểu bang. Thiết kế đã được thay đổi 27 lần kể từ năm 1777.";
"FACT_21_TITLE" = "Cờ cực bắc";
"FACT_21_DESC" = "Các vùng Bắc Cực sử dụng cả cờ quốc gia và cờ khu vực với tính biểu tượng độc đáo.";
"FACT_22_TITLE" = "Cờ có hình chữ thập";
"FACT_22_DESC" = "29 quốc gia có hình thánh giá trên quốc kỳ của họ, khiến nó trở thành một trong những biểu tượng phổ biến nhất trên quốc kỳ.";
"FACT_23_TITLE" = "ba màu";
"FACT_23_DESC" = "Nhiều quốc gia sử dụng thiết kế ba sọc đơn giản làm mẫu cờ ổn định về mặt lịch sử.";
"FACT_24_TITLE" = "Cờ có hình lưỡi liềm";
"FACT_24_DESC" = "Hình lưỡi liềm xuất hiện trên lá cờ của 12 quốc gia, chủ yếu là người Hồi giáo, tượng trưng cho đức tin Hồi giáo.";
"FACT_25_TITLE" = "biểu tượng mặt trời";
"FACT_25_DESC" = "Mặt trời là một trong những biểu tượng phổ biến nhất trên các lá cờ ở Châu Á và Nam Mỹ.";
"FACT_26_TITLE" = "Cờ với một cái cây";
"FACT_26_DESC" = "Lebanon là quốc gia duy nhất có cây (cây tuyết tùng Lebanon) trên lá cờ, tượng trưng cho sự vĩnh cửu và hòa bình.";
"FACT_27_TITLE" = "Cờ hẹp nhất";
"FACT_27_DESC" = "Quốc kỳ Qatar có tỷ lệ khung hình khác thường nhất so với bất kỳ quốc kỳ nào—11:28.";
"FACT_28_TITLE" = "Huy hiệu phức tạp";
"FACT_28_DESC" = "Huy hiệu trên các lá cờ Mỹ Latinh thường bao gồm nhiều chi tiết và biểu tượng lịch sử.";
"FACT_29_TITLE" = "Cờ cầu vồng";
"FACT_29_DESC" = "Bolivia có hai lá cờ chính thức—lá cờ ba màu truyền thống và lá cờ cầu vồng Wiphala bản địa.";
"FACT_30_TITLE" = "Cờ với một tòa nhà";
"FACT_30_DESC" = "Quốc kỳ Campuchia có hình ngôi đền Angkor Wat, khiến quốc kỳ này trở thành quốc kỳ duy nhất có tòa nhà.";
"FACT_31_TITLE" = "Tranh chấp lịch sử";
"FACT_31_DESC" = "Thiết kế của một số lá cờ đã thay đổi do tranh chấp lịch sử và chính trị giữa các quốc gia.";
"FACT_32_TITLE" = "Cờ với một thanh kiếm";
"FACT_32_DESC" = "Quốc kỳ Sri Lanka có hình một con sư tử cầm kiếm, tượng trưng cho lòng dũng cảm của người dân Sinhalese.";
"FACT_33_TITLE" = "Cờ không có màu xanh";
"FACT_33_DESC" = "Chỉ có 4 quốc gia không sử dụng màu xanh lam trên quốc kỳ của mình: Jamaica, Mauritania, Sri Lanka và Vatican.";
"FACT_34_TITLE" = "Chim trên cờ";
"FACT_34_DESC" = "Đại bàng và các loài chim khác trên lá cờ tượng trưng cho sức mạnh, sự độc lập và tinh thần cao thượng.";
"FACT_35_TITLE" = "biểu tượng Nam Cực";
"FACT_35_DESC" = "Nam Cực không có quốc kỳ chính thức nhưng có một số thiết kế không chính thức được sử dụng.";
"FACT_36_TITLE" = "Ngôi sao trên lá cờ";
"FACT_36_DESC" = "Ngôi sao là một trong những biểu tượng phổ biến nhất trên các lá cờ trên khắp thế giới.";
"FACT_37_TITLE" = "Cách phối màu tương tự";
"FACT_37_DESC" = "Một số lá cờ có màu sắc tương tự nhưng khác nhau về thứ tự sọc và biểu tượng.";
"FACT_38_TITLE" = "Cờ liên minh quốc tế";
"FACT_38_DESC" = "Các tổ chức siêu quốc gia cũng có lá cờ riêng phản ánh các giá trị chung.";
"FACT_39_TITLE" = "biểu tượng đảo";
"FACT_39_DESC" = "Cờ của các quốc đảo thường có biểu tượng của đại dương, mặt trời và hàng hải.";
"FACT_40_TITLE" = "Thay đổi theo thời gian";
"FACT_40_DESC" = "Một số quốc kỳ đã thay đổi hàng chục lần theo lịch sử chính trị của đất nước họ.";
"FACT_41_TITLE" = "Mặt trời Bắc Macedonia";
"FACT_41_DESC" = "Quốc kỳ Bắc Macedonia có hình mặt trời tám tia báo hiệu một khởi đầu mới.";
"FACT_42_TITLE" = "tiều phu Belize";
"FACT_42_DESC" = "Cờ Belize là một trong số ít hình ảnh con người: những người tiều phu với các công cụ.";
"FACT_43_TITLE" = "Thần ưng Ecuador";
"FACT_43_DESC" = "Cờ Ecuador có hình thần ưng Andean tượng trưng cho sức mạnh và chủ quyền.";
"FACT_44_TITLE" = "Bolivia Wiphala";
"FACT_44_DESC" = "Bolivia sử dụng Wiphala cùng với ba màu làm biểu tượng chính thức.";
"FACT_45_TITLE" = "27 ngôi sao của Brazil";
"FACT_45_DESC" = "Quốc kỳ Brazil có 27 ngôi sao, mỗi ngôi sao tượng trưng cho một bang và một quận liên bang.";
"FACT_46_TITLE" = "Lá phong";
"FACT_46_DESC" = "Quốc kỳ Canada có hình một chiếc lá phong 11 cánh, độc nhất vô nhị trong số các quốc kỳ.";
"FACT_47_TITLE" = "Jack đoàn";
"FACT_47_DESC" = "Quốc kỳ Vương quốc Anh kết hợp hình thánh giá của 3 vị thánh: Anh, Scotland và Ireland.";
"FACT_48_TITLE" = "Mặt trời mọc ở Nhật Bản";
"FACT_48_DESC" = "Vòng tròn màu đỏ trên nền trắng tượng trưng cho mặt trời mọc và được sử dụng trên quốc kỳ Nhật Bản từ thế kỷ thứ 7.";
"FACT_49_TITLE" = "Luân xa Ashoka";
"FACT_49_DESC" = "Quốc kỳ Ấn Độ có bánh xe 24 nan, tượng trưng cho luật pháp và chuyển động.";
"FACT_50_TITLE" = "Southern Cross của Úc";
"FACT_50_DESC" = "Quốc kỳ Australia có hình chòm sao Thập tự phương Nam, chỉ có thể nhìn thấy ở Nam bán cầu.";
"FACT_51_TITLE" = "Southern Cross của New Zealand";
"FACT_51_DESC" = "Quốc kỳ của New Zealand cũng có hình Chữ Thập Phương Nam nhưng có các ngôi sao màu đỏ viền trắng.";
"FACT_52_TITLE" = "Taegeuk của Hàn Quốc";
"FACT_52_DESC" = "Quốc kỳ Hàn Quốc có biểu tượng và bát quái taegeuk (âm dương) truyền thống.";
"FACT_53_TITLE" = "Hỗn dịch cầu của Bồ Đào Nha";
"FACT_53_DESC" = "Quốc kỳ Bồ Đào Nha có hình cầu hỗn thiên, một công cụ điều hướng cổ xưa.";
"FACT_54_TITLE" = "Đại bàng hai đầu của Albania";
"FACT_54_DESC" = "Quốc kỳ Albania có hình đại bàng hai đầu màu đen, biểu tượng của chủ quyền.";
"FACT_55_TITLE" = "Lá chắn của Kenya";
"FACT_55_DESC" = "Quốc kỳ của Kenya có hình khiên Maasai và những ngọn giáo bắt chéo.";
"FACT_56_TITLE" = "Rồng xứ Wales";
"FACT_56_DESC" = "Con rồng đỏ trên lá cờ của xứ Wales là một trong những biểu tượng quốc gia lâu đời nhất trên thế giới.";
"FACT_57_TITLE" = "Thánh giá thánh Andrew";
"FACT_57_DESC" = "Quốc kỳ Scotland có hình chữ thập chéo màu trắng trên nền xanh lam, chữ thập của Thánh Andrew.";
"FACT_58_TITLE" = "vòng tròn Greenland";
"FACT_58_DESC" = "Lá cờ của Greenland có một vòng tròn màu đỏ và trắng tượng trưng cho mặt trời trên băng.";
"FACT_59_TITLE" = "Màu sắc châu Phi";
"FACT_59_DESC" = "Màu xanh lá cây, vàng và đỏ thường được gọi là màu Liên Phi và xuất hiện trên nhiều lá cờ châu Phi.";
"FACT_60_TITLE" = "Thánh giá Bắc Âu";
"FACT_60_DESC" = "Năm quốc gia sử dụng chữ thập Bắc Âu: Đan Mạch, Na Uy, Thụy Điển, Phần Lan và Iceland.";
"FACT_61_TITLE" = "Pháp ba màu";
"FACT_61_DESC" = "Cờ ba màu xanh-trắng-đỏ của Pháp đã trở thành hình mẫu cho nhiều lá cờ cách mạng và quốc kỳ.";
"FACT_62_TITLE" = "Cờ Liên Hiệp Quốc";
"FACT_62_DESC" = "Lá cờ Liên Hợp Quốc thể hiện thế giới được bao quanh bởi những cành ô liu trên nền xanh.";
"FACT_63_TITLE" = "Cờ EU";
"FACT_63_DESC" = "Mười hai ngôi sao vàng trong vòng tròn màu xanh lam tượng trưng cho sự thống nhất của Liên minh châu Âu.";
"FACT_64_TITLE" = "Cờ Olympic";
"FACT_64_DESC" = "Năm vòng tròn màu trắng tượng trưng cho năm lục địa có người sinh sống và tính chất toàn cầu của Thế vận hội.";
"FACT_65_TITLE" = "quảng trường Vatican";
"FACT_65_DESC" = "Vatican có quốc kỳ hình vuông giống Thụy Sĩ.";
"FACT_66_TITLE" = "Nauru 12 điểm";
"FACT_66_DESC" = "Trên cờ Nauru có ngôi sao 12 cánh tượng trưng cho 12 bộ tộc.";
"FACT_67_TITLE" = "Thảm Turkmenistan";
"FACT_67_DESC" = "Cờ Turkmenistan có hoa văn thảm dọc theo tời.";
"FACT_68_TITLE" = "Nhà thờ Hồi giáo Afghanistan";
"FACT_68_DESC" = "Lá cờ Afghanistan có hình ảnh một nhà thờ Hồi giáo trong thiết kế của nó.";

