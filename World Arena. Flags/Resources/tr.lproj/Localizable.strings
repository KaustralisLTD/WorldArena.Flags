/* 68 interesting facts */
"FACT_01_TITLE" = "Efsanesi olan bir bayrak";
"FACT_01_DESC" = "Bir efsane, Danimarka bayrağını 1219 yılındaki bir savaşla ilişkilendirir.";
"FACT_02_TITLE" = "Kare biçimli ulusal bayraklar";
"FACT_02_DESC" = "İsviçre ve Vatikan’ın ulusal bayrakları kare biçimindedir.";
"FACT_03_TITLE" = "Dikdörtgen olmayan bayrak";
"FACT_03_DESC" = "Nepal dünyada dikdörtgen olmayan tek ulusal bayrağa sahiptir.";
"FACT_04_TITLE" = "Kırmızı, beyaz veya mavi yok";
"FACT_04_DESC" = "Bayrağı kırmızı, beyaz ve mavi olmayan tek ülke Jamaika'dır.";
"FACT_05_TITLE" = "Asla indirilmeyen bayrak";
"FACT_05_DESC" = "Suudi Arabistan bayrağı, üzerindeki kutsal metin nedeniyle asla yarıya indirilmez.";
"FACT_06_TITLE" = "Genç ulusal bayrak";
"FACT_06_DESC" = "Güney Sudan, 2011’de bağımsızlığını kazandığından beri bu ulusal bayrağı kullanıyor.";
"FACT_07_TITLE" = "AK-47 bulunan bayrak";
"FACT_07_DESC" = "Mozambik, bayrağında modern bir silah olan Kalaşnikof tüfeği bulunan tek ülkedir.";
"FACT_08_TITLE" = "Neredeyse aynı bayraklar";
"FACT_08_DESC" = "Romanya ve Çad bayrakları birbirine çok benziyor; genellikle mavinin tonuyla ayırt edilirler.";
"FACT_09_TITLE" = "Ukrayna bayrağının simgeleri";
"FACT_09_DESC" = "Ukrayna'nın mavi ve sarı bayrağı geleneksel olarak buğday tarlasının üzerindeki gökyüzü olarak yorumlanır.";
"FACT_10_TITLE" = "En basit bayrak";
"FACT_10_DESC" = "Libya'nın 1977'den 2011'e kadar olan bayrağı hiçbir sembol veya desen olmaksızın düz yeşildi.";
"FACT_11_TITLE" = "Harita bulunan bayrak";
"FACT_11_DESC" = "Kıbrıs bayrağı, ulusal bayraklar arasında nadir görülen bir durum olan adanın ana hatlarını gösterir.";
"FACT_12_TITLE" = "İncil içeren bayrak";
"FACT_12_DESC" = "Dominik Cumhuriyeti'nin bayrağı açık bir İncil'i gösteriyor, bu da onu dini kitap içeren tek ulusal bayrak yapıyor.";
"FACT_13_TITLE" = "Ulusal bayraklarda kırmızı";
"FACT_13_DESC" = "Kırmızı, Kanada, Japonya ve İsviçre dâhil birçok ülkenin bayrağında bulunur.";
"FACT_14_TITLE" = "Metin içeren bayrak";
"FACT_14_DESC" = "Ulusal bayraklarda yazı nadirdir; en bilinen örneklerden biri Suudi Arabistan’dır.";
"FACT_15_TITLE" = "Bayrak kullanım kuralları";
"FACT_15_DESC" = "Birçok ülkenin ulusal bayrağa nasıl davranılacağı konusunda katı kuralları vardır.";
"FACT_16_TITLE" = "Farklı tarafları olan bayrak";
"FACT_16_DESC" = "Paraguay, dünyada ön ve arka yüzünde farklı tasarımlara sahip tek ulusal bayrağa sahiptir.";
"FACT_17_TITLE" = "Olimpiyat sembolizmi";
"FACT_17_DESC" = "Beş Olimpiyat halkası ve beyaz zemin toplam altı renk içerir. Bu renkler, dünyadaki ülkelerin bayraklarını temsil etmek üzere seçilmiştir.";
"FACT_18_TITLE" = "Meksika’nın arması";
"FACT_18_DESC" = "Meksika bayrağında bir kaktüsün üzerinde duran ve yılan tutan bir kartal bulunur.";
"FACT_19_TITLE" = "Benzer kırmızı-beyaz bayraklar";
"FACT_19_DESC" = "Monako ve Endonezya bayraklarında kırmızı üstte, beyaz alttadır; ancak bayrakların oranları farklıdır.";
"FACT_20_TITLE" = "50 yıldızlı bayrak";
"FACT_20_DESC" = "Amerika Birleşik Devletleri bayrağında, her eyalet için bir tane olmak üzere 50 yıldız vardır.";
"FACT_21_TITLE" = "En kuzeydeki bayraklar";
"FACT_21_DESC" = "Kuzey Kutbu bölgeleri, benzersiz sembolizmle hem ulusal hem de bölgesel bayrakları kullanır.";
"FACT_22_TITLE" = "Haç bulunan bayrak";
"FACT_22_DESC" = "Haç, Danimarka, Finlandiya ve İsviçre dâhil birçok ulusal bayrakta bulunur.";
"FACT_23_TITLE" = "Üç renkli bayraklar";
"FACT_23_DESC" = "Birçok ülke, tarihsel olarak istikrarlı bir bayrak formu olarak basit bir üç şeritli tasarım kullanır.";
"FACT_24_TITLE" = "Hilalli bayrak";
"FACT_24_DESC" = "Hilal, Türkiye, Pakistan ve Tunus dâhil çeşitli ülkelerin bayraklarında yer alır.";
"FACT_25_TITLE" = "Güneş sembolü";
"FACT_25_DESC" = "Güneş, Asya ve Güney Amerika'daki bayraklarda en yaygın sembollerden biridir.";
"FACT_26_TITLE" = "Ağaçlı bayrak";
"FACT_26_DESC" = "Lübnan’ın ulusal bayrağında bir sedir ağacı bulunur.";
"FACT_27_TITLE" = "Katar bayrağının oranları";
"FACT_27_DESC" = "Katar’ın ulusal bayrağında yükseklik-genişlik oranı 11:28’dir.";
"FACT_28_TITLE" = "Karmaşık armalar";
"FACT_28_DESC" = "Latin Amerika bayraklarındaki armalar genellikle birçok ayrıntı ve tarihi sembol içerir.";
"FACT_29_TITLE" = "Gökkuşağı bayrağı";
"FACT_29_DESC" = "Bolivya'nın iki resmi bayrağı vardır: geleneksel üç renkli ve yerli Wiphala gökkuşağı bayrağı.";
"FACT_30_TITLE" = "Bina içeren bayrak";
"FACT_30_DESC" = "Kamboçya’nın ulusal bayrağında Angkor Vat tapınağı tasvir edilir.";
"FACT_31_TITLE" = "Tarihsel anlaşmazlıklar";
"FACT_31_DESC" = "Ülkeler arasındaki tarihi ve siyasi anlaşmazlıklar nedeniyle bazı bayrakların tasarımı değişmiştir.";
"FACT_32_TITLE" = "Kılıç bulunan bayrak";
"FACT_32_DESC" = "Sri Lanka bayrağı, Sinhala halkının cesaretini simgeleyen, elinde kılıç tutan bir aslanı gösteriyor.";
"FACT_33_TITLE" = "Mavi içermeyen bayrak";
"FACT_33_DESC" = "Jamaika, Japonya ve İsviçre gibi bazı ülkelerin bayraklarında mavi bulunmaz.";
"FACT_34_TITLE" = "Bayraklardaki kuşlar";
"FACT_34_DESC" = "Bayraklardaki kartal ve diğer kuşlar gücü, bağımsızlığı ve ruhun asaletini simgelemektedir.";
"FACT_35_TITLE" = "Antarktika sembolü";
"FACT_35_DESC" = "Antarktika'nın resmi bir ulusal bayrağı yoktur, ancak birkaç resmi olmayan tasarım kullanılmaktadır.";
"FACT_36_TITLE" = "Bayraklardaki yıldızlar";
"FACT_36_DESC" = "Yıldız, dünya çapında bayraklarda en yaygın kullanılan sembollerden biridir.";
"FACT_37_TITLE" = "Benzer renk şemaları";
"FACT_37_DESC" = "Bazı bayraklar renk bakımından benzerdir ancak şerit ve amblemlerin sırası farklılık gösterir.";
"FACT_38_TITLE" = "Uluslararası birlik bayrakları";
"FACT_38_DESC" = "Uluslar üstü kuruluşların da ortak değerleri yansıtan kendi bayrakları vardır.";
"FACT_39_TITLE" = "Ada sembolizmi";
"FACT_39_DESC" = "Ada uluslarının bayraklarında genellikle okyanus, güneş ve navigasyon sembolleri bulunur.";
"FACT_40_TITLE" = "Zaman içindeki değişiklikler";
"FACT_40_DESC" = "Bazı ulusal bayraklar ülkelerinin siyasi tarihi ile birlikte onlarca kez değişime uğramıştır.";
"FACT_41_TITLE" = "Kuzey Makedonya güneşi";
"FACT_41_DESC" = "Kuzey Makedonya bayrağındaki sekiz ışınlı güneş, yeni bir başlangıcı simgeler.";
"FACT_42_TITLE" = "Belize’nin oduncuları";
"FACT_42_DESC" = "Belize bayrağı, insan figürlerinin bulunduğu az sayıdaki bayraktan biridir; üzerinde aletleriyle iki oduncu yer alır.";
"FACT_43_TITLE" = "Ekvador kondoru";
"FACT_43_DESC" = "Ekvador bayrağı, güç ve egemenlik anlamına gelen And akbabasını içerir.";
"FACT_44_TITLE" = "Bolivya Wiphala";
"FACT_44_DESC" = "Bolivya, üç renkli bayrağının yanında Wiphala’yı da resmî bir sembol olarak kullanır.";
"FACT_45_TITLE" = "Brezilya'nın 27 yıldızı";
"FACT_45_DESC" = "Brezilya bayrağında her eyalet ve federal bölge için bir tane olmak üzere 27 yıldız bulunur.";
"FACT_46_TITLE" = "Akçaağaç yaprağı";
"FACT_46_DESC" = "Kanada bayrağında beyaz bir kare üzerinde 11 uçlu kırmızı akçaağaç yaprağı bulunur.";
"FACT_47_TITLE" = "Union Jack";
"FACT_47_DESC" = "Birleşik Krallık bayrağı, Aziz George, Aziz Andreas ve Aziz Patrick’in haçlarını birleştirir.";
"FACT_48_TITLE" = "Japonya'nın yükselen güneşi";
"FACT_48_DESC" = "Japonya’nın ulusal bayrağında beyaz zemin üzerinde güneşi temsil eden kırmızı bir daire bulunur.";
"FACT_49_TITLE" = "Ashoka Çakra";
"FACT_49_DESC" = "Hindistan bayrağında kanun ve hareketi simgeleyen 24 kollu bir tekerlek bulunur.";
"FACT_50_TITLE" = "Avustralya'nın Güney Haçı";
"FACT_50_DESC" = "Avustralya bayrağındaki beş yıldız, Güney Haçı takımyıldızını temsil eder.";
"FACT_51_TITLE" = "Yeni Zelanda'nın Güney Haçı";
"FACT_51_DESC" = "Yeni Zelanda'nın bayrağında da Güney Haçı yer alıyor, ancak kenarları beyaz olan kırmızı yıldızlar var.";
"FACT_52_TITLE" = "Güney Kore'nin taegeuk'u";
"FACT_52_DESC" = "Güney Kore'nin bayrağında geleneksel taegeuk (yin-yang) sembolü ve trigramlar bulunur.";
"FACT_53_TITLE" = "Portekiz’in halkalı küresi";
"FACT_53_DESC" = "Portekiz bayrağında eski bir seyir aracı olan halkalı küre yer alır.";
"FACT_54_TITLE" = "Arnavutluk'un çift başlı kartalı";
"FACT_54_DESC" = "Arnavutluk'un bayrağında egemenliğin sembolü olan siyah çift başlı kartal bulunmaktadır.";
"FACT_55_TITLE" = "Kenya'nın kalkanı";
"FACT_55_DESC" = "Kenya'nın bayrağında Masai kalkanı ve çapraz mızraklar bulunur.";
"FACT_56_TITLE" = "Galler ejderhası";
"FACT_56_DESC" = "Galler bayrağında beyaz ve yeşil zemin üzerinde kırmızı bir ejderha bulunur. Bu tasarım 1959’da resmen tanınmıştır.";
"FACT_57_TITLE" = "Aziz Andreas’ın haçı";
"FACT_57_DESC" = "İskoçya bayrağında mavi zemin üzerinde beyaz çapraz bir haç, yani Aziz Andreas’ın haçı bulunur.";
"FACT_58_TITLE" = "Grönland’ın dairesi";
"FACT_58_DESC" = "Grönland bayrağında buzun üzerindeki güneşi temsil eden kırmızı-beyaz bir daire var.";
"FACT_59_TITLE" = "Pan-Afrikan renkleri";
"FACT_59_DESC" = "Yeşil, sarı ve kırmızıya genellikle Pan-Afrikan renkleri denir ve birçok Afrika bayrağında görülür.";
"FACT_60_TITLE" = "İskandinav haçları";
"FACT_60_DESC" = "Beş ülke İskandinav haçını kullanıyor: Danimarka, Norveç, İsveç, Finlandiya ve İzlanda.";
"FACT_61_TITLE" = "Fransa’nın üç renkli bayrağı";
"FACT_61_DESC" = "Fransa’nın mavi, beyaz ve kırmızı üç renkli bayrağı, birçok devrimci ve ulusal bayrağa örnek olmuştur.";
"FACT_62_TITLE" = "BM bayrağı";
"FACT_62_DESC" = "BM bayrağı, dünyayı mavi bir arka plan üzerinde zeytin dallarıyla çevrili olarak gösterir.";
"FACT_63_TITLE" = "AB bayrağı";
"FACT_63_DESC" = "Mavi zemin üzerinde daire şeklinde dizilmiş on iki altın yıldız, Avrupa Birliği’nin birliğini simgeler.";
"FACT_64_TITLE" = "Olimpiyat bayrağı";
"FACT_64_DESC" = "Beyaz zemin üzerindeki beş Olimpiyat halkası, beş kıtanın ve dünyanın dört bir yanından sporcuların birliğini simgeler.";
"FACT_65_TITLE" = "Vatikan’ın kare bayrağı";
"FACT_65_DESC" = "Vatikan'ın İsviçre gibi kare bir ulusal bayrağı var.";
"FACT_66_TITLE" = "Nauru’nun 12 ışını";
"FACT_66_DESC" = "Nauru bayrağında 12 kabileyi temsil eden 12 köşeli bir yıldız bulunur.";
"FACT_67_TITLE" = "Türkmenistan halısı";
"FACT_67_DESC" = "Türkmenistan bayrağının direğe yakın kenarında halı desenleri bulunur.";
"FACT_68_TITLE" = "Afganistan camii";
"FACT_68_DESC" = "Afganistan bayrağının geçmişteki bazı tasarımlarında cami yer almıştır.";

