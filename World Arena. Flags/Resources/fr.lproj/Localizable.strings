"FACT_07_TITLE" = "Drapeau avec AK-47";
"FACT_07_DESC" = "Le Mozambique est le seul pays dont le drapeau comporte une arme moderne – le fusil Kalachnikov.";
"FACT_08_TITLE" = "Drapeaux presque identiques";
"FACT_08_DESC" = "Les drapeaux de la Roumanie et du Tchad sont très similaires ; on les distingue généralement par la teinte de bleu.";
"FACT_09_TITLE" = "Symbolique de l'Ukraine";
"FACT_09_DESC" = "Le drapeau bleu et jaune de l'Ukraine est traditionnellement interprété comme le ciel au-dessus d'un champ de blé.";
