"FACT_49_TITLE" = "Ashoka Chakra";
"FACT_49_DESC" = "Le drapeau de l'Inde comporte une roue à 24 rayons, symbolisant la loi et le mouvement.";
"FACT_50_TITLE" = "Croix du Sud de l'Australie";
"FACT_50_DESC" = "Le drapeau australien montre la constellation de la Croix du Sud, visible seulement dans l'hémisphère sud.";
"FACT_51_TITLE" = "Croix du Sud de la Nouvelle-Zélande";
"FACT_51_DESC" = "Le drapeau néo-zélandais montre aussi la Croix du Sud, avec des étoiles rouges bordées de blanc.";
"FACT_52_TITLE" = "Taegeuk de la Corée du Sud";
"FACT_52_DESC" = "Le drapeau sud-coréen comporte le taegeuk (yin-yang) traditionnel et des trigrammes.";
"FACT_53_TITLE" = "Sphère armillaire du Portugal";
"FACT_53_DESC" = "Le drapeau du Portugal comporte une sphère armillaire, un ancien instrument de navigation.";
"FACT_54_TITLE" = "Aigle bicéphale de l'Albanie";
"FACT_54_DESC" = "Le drapeau albanais montre un aigle bicéphale noir, symbole de souveraineté.";
"FACT_55_TITLE" = "Bouclier du Kenya";
"FACT_55_DESC" = "Le drapeau du Kenya comporte un bouclier masaï et des lances croisées.";
"FACT_56_TITLE" = "Dragon du pays de Galles";
"FACT_56_DESC" = "Le dragon rouge du pays de Galles est l'un des plus anciens symboles nationaux au monde.";
"FACT_57_TITLE" = "Croix de saint André";
"FACT_57_DESC" = "Le drapeau écossais est une croix blanche diagonale sur fond bleu, la croix de saint André.";
"FACT_58_TITLE" = "Cercle du Groenland";
"FACT_58_DESC" = "Le drapeau du Groenland a un cercle rouge et blanc pour le soleil sur la glace.";
"FACT_59_TITLE" = "Couleurs panafricaines";
"FACT_59_DESC" = "Le vert, le jaune et le rouge sont souvent appelés couleurs panafricaines et figurent sur de nombreux drapeaux africains.";
"FACT_60_TITLE" = "Croix nordiques";
"FACT_60_DESC" = "Cinq pays utilisent la croix nordique : Danemark, Norvège, Suède, Finlande et Islande.";
"FACT_61_TITLE" = "Tricolore français";
"FACT_61_DESC" = "Le tricolore bleu-blanc-rouge français a servi de modèle à de nombreux drapeaux révolutionnaires et nationaux.";
"FACT_62_TITLE" = "Drapeau de l'ONU";
"FACT_62_DESC" = "Le drapeau de l'ONU montre le monde entouré de rameaux d'olivier sur fond bleu.";
"FACT_63_TITLE" = "Drapeau de l'UE";
"FACT_63_DESC" = "Douze étoiles d'or en cercle sur bleu symbolisent l'unité de l'Union européenne.";
"FACT_64_TITLE" = "Drapeau olympique";
"FACT_64_DESC" = "Les cinq anneaux sur blanc représentent les cinq continents habités et la dimension mondiale des Jeux.";
"FACT_65_TITLE" = "Drapeau carré du Vatican";
"FACT_65_DESC" = "Le Vatican a un drapeau national carré comme la Suisse.";
