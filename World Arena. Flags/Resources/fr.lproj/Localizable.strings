"FACT_01_DESC" = "Une légende associe le drapeau danois à une bataille de 1219.";
"FACT_02_TITLE" = "Des drapeaux nationaux carrés";
"FACT_02_DESC" = "La Suisse et la Cité du Vatican ont toutes deux un drapeau national carré.";
"FACT_03_TITLE" = "Drapeau non rectangulaire";
"FACT_03_DESC" = "Le Népal a le seul drapeau national au monde qui ne soit pas rectangulaire.";
"FACT_04_TITLE" = "Sans rouge, blanc ni bleu";
"FACT_04_DESC" = "La Jamaïque est le seul pays avec un drapeau sans rouge, blanc ni bleu.";
"FACT_05_TITLE" = "Drapeau jamais mis en berne";
"FACT_05_DESC" = "Le drapeau de l'Arabie saoudite n'est jamais mis en berne à cause du texte sacré.";
