"FACT_25_TITLE" = "Symbole du soleil";
"FACT_25_DESC" = "Le soleil est l'un des symboles les plus courants sur les drapeaux en Asie et en Amérique du Sud.";
"FACT_26_TITLE" = "Drapeau avec un arbre";
"FACT_26_DESC" = "Le Liban est le seul pays avec un arbre (le cèdre du Liban) sur son drapeau, symbolisant l'éternité et la paix.";
"FACT_27_TITLE" = "Drapeau le plus étroit";
"FACT_27_DESC" = "Le drapeau du Qatar a le rapport d'aspect le plus inhabituel – 11:28.";
"FACT_28_TITLE" = "Blasons complexes";
"FACT_28_DESC" = "Les blasons sur les drapeaux d'Amérique latine comportent souvent de nombreux détails et symboles historiques.";
"FACT_29_TITLE" = "Drapeau arc-en-ciel";
"FACT_29_DESC" = "La Bolivie a deux drapeaux officiels – le tricolore traditionnel et le Wiphala indigène.";
"FACT_30_TITLE" = "Drapeau avec un bâtiment";
"FACT_30_DESC" = "Le drapeau du Cambodge montre le temple d'Angkor Wat, le seul drapeau national avec un bâtiment.";
"FACT_31_TITLE" = "Différends historiques";
"FACT_31_DESC" = "Le design de certains drapeaux a changé à cause de différends historiques et politiques.";
"FACT_32_TITLE" = "Drapeau avec une épée";
"FACT_32_DESC" = "Le drapeau du Sri Lanka montre un lion tenant une épée, symbolisant le courage des Cinghalais.";
"FACT_33_TITLE" = "Drapeau sans bleu";
"FACT_33_DESC" = "Seuls quatre pays n'utilisent pas le bleu : Jamaïque, Mauritanie, Sri Lanka et Vatican.";
"FACT_34_TITLE" = "Oiseaux sur les drapeaux";
"FACT_34_DESC" = "L'aigle et d'autres oiseaux symbolisent la force, l'indépendance et la noblesse.";
"FACT_35_TITLE" = "Symbole antarctique";
"FACT_35_DESC" = "L'Antarctique n'a pas de drapeau national officiel, mais plusieurs modèles non officiels sont utilisés.";
"FACT_36_TITLE" = "Étoiles sur les drapeaux";
"FACT_36_DESC" = "L'étoile est l'un des symboles les plus répandus sur les drapeaux du monde.";
"FACT_37_TITLE" = "Schémas de couleurs similaires";
"FACT_37_DESC" = "Certains drapeaux se ressemblent par les couleurs mais diffèrent par l'ordre des bandes et des emblèmes.";
"FACT_38_TITLE" = "Drapeaux d'unions internationales";
"FACT_38_DESC" = "Les organisations supranationales ont aussi leurs drapeaux reflétant des valeurs partagées.";
"FACT_39_TITLE" = "Symbolique insulaire";
"FACT_39_DESC" = "Les drapeaux des États insulaires montrent souvent l'océan, le soleil et la navigation.";
"FACT_40_TITLE" = "Changements dans le temps";
"FACT_40_DESC" = "Certains drapeaux nationaux ont changé des dizaines de fois avec l'histoire politique du pays.";
"FACT_41_TITLE" = "Soleil de Macédoine du Nord";
"FACT_41_DESC" = "Le drapeau de la Macédoine du Nord a un soleil à huit rayons pour un nouveau départ.";
"FACT_42_TITLE" = "Bûcherons du Belize";
"FACT_42_DESC" = "Le drapeau du Belize est l'un des rares à montrer des personnes : des bûcherons avec des outils.";
"FACT_43_TITLE" = "Condor de l'Équateur";
"FACT_43_DESC" = "Le drapeau de l'Équateur inclut le condor des Andes pour la force et la souveraineté.";
"FACT_44_TITLE" = "Deux drapeaux de la Bolivie";
"FACT_44_DESC" = "La Bolivie utilise le Wiphala aux côtés du tricolore comme symbole officiel.";
"FACT_45_TITLE" = "27 étoiles du Brésil";
