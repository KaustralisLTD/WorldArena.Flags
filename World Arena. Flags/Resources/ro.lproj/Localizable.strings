"FACT_01_TITLE" = "Cel mai vechi steag folosit continuu";
"FACT_01_DESC" = "Dannebrog al Danemarcei este considerat cel mai vechi steag național în uz continuu din 1219.";
"FACT_02_TITLE" = "Doar steag național pătrat";
"FACT_02_DESC" = "Elveția are singurul steag național pătrat din lume. Vaticanul are și un steag pătrat, dar este un oraș-stat.";
"FACT_03_TITLE" = "Steagul nedreptunghiular";
"FACT_03_DESC" = "Nepalul are singurul steag național din lume care nu este dreptunghiular.";
"FACT_04_TITLE" = "Fără roșu, alb sau albastru";
"FACT_04_DESC" = "Jamaica este singura țară cu un steag fără roșu, alb sau albastru.";
"FACT_05_TITLE" = "Steagul care nu este niciodată coborât";
"FACT_05_DESC" = "Steagul Arabiei Saudite nu este niciodată arborat în berb din cauza textului sacru de pe el.";
"FACT_06_TITLE" = "Steagul național tânăr";
"FACT_06_DESC" = "Steagul Sudanului de Sud a fost adoptat în 2011 după independență.";
"FACT_07_TITLE" = "Steagul cu AK-47";
"FACT_07_DESC" = "Mozambic este singura țară al cărei steag prezintă o armă modernă - pușca Kalașnikov.";
"FACT_08_TITLE" = "Steaguri aproape identice";
"FACT_08_DESC" = "Steagurile României și Ciadului sunt foarte asemănătoare; de obicei se disting prin nuanța de albastru.";
"FACT_09_TITLE" = "Simbolismul Ucrainei";
"FACT_09_DESC" = "Steagul albastru și galben al Ucrainei este interpretat în mod tradițional ca cerul deasupra unui câmp de grâu.";
"FACT_10_TITLE" = "Cel mai simplu steag";
"FACT_10_DESC" = "Steagul Libiei din 1977 până în 2011 a fost verde continuu, fără simboluri sau modele.";
"FACT_11_TITLE" = "Steagul cu o hartă";
"FACT_11_DESC" = "Steagul Ciprului arată conturul insulei - un caz rar printre steaguri naționale.";
"FACT_12_TITLE" = "Steagul cu o Biblie";
"FACT_12_DESC" = "Steagul Republicii Dominicane arată o Biblie deschisă, ceea ce îl face singurul steag național cu o carte religioasă.";
"FACT_13_TITLE" = "Cea mai populară culoare";
"FACT_13_DESC" = "Roșul este cea mai comună culoare pe steaguri naționale din întreaga lume.";
"FACT_14_TITLE" = "Steagul cu text";
"FACT_14_DESC" = "Textul de pe steaguri naționale este rar; un exemplu binecunoscut este Arabia Saudită.";
"FACT_15_TITLE" = "Eticheta steagului";
"FACT_15_DESC" = "Multe țări au reguli stricte cu privire la modul de tratare a drapelului național.";
"FACT_16_TITLE" = "Steagul cu fețe diferite";
"FACT_16_DESC" = "Paraguay are singurul steag național din lume cu diferite modele pe avers și revers.";
"FACT_17_TITLE" = "Simbolismul olimpic";
"FACT_17_DESC" = "Culorile inelului olimpic au fost alese astfel încât cel puțin o culoare să apară pe steagul fiecărei țări.";
"FACT_18_TITLE" = "Steagul cu cea mai complexă stemă";
"FACT_18_DESC" = "Steagul Mexicului arată un vultur cocoțat pe un cactus ținând un șarpe - una dintre cele mai detaliate steme de pe orice steag.";
"FACT_19_TITLE" = "Steagul Copycat";
"FACT_19_DESC" = "Steagulele Monaco și Indonezia sunt aproape identice - roșu deasupra, alb dedesubt. Singura diferență sunt proporțiile.";
"FACT_20_TITLE" = "Steagul cu 50 de stele";
"FACT_20_DESC" = "Steagul SUA are 50 de stele, câte una pentru fiecare stat. Designul a fost schimbat de 27 de ori din 1777.";
"FACT_21_TITLE" = "Steaguri cele mai nordice";
"FACT_21_DESC" = "Regiunile arctice folosesc atât steaguri naționale, cât și regionale cu simbolism unic.";
"FACT_22_TITLE" = "Steagul cu cruce";
"FACT_22_DESC" = "29 de țări au o cruce pe steagul lor, ceea ce îl face unul dintre cele mai populare simboluri de pe steaguri naționale.";
"FACT_23_TITLE" = "Tricolore";
"FACT_23_DESC" = "Multe țări folosesc un design simplu cu trei benzi ca formă de steag stabilă din punct de vedere istoric.";
"FACT_24_TITLE" = "Steagul cu o semilună";
"FACT_24_DESC" = "Semiluna apare pe steagurile a 12 țări, majoritatea musulmane, simbolizând credința islamică.";
"FACT_25_TITLE" = "Simbolul soarelui";
"FACT_25_DESC" = "Soarele este unul dintre cele mai comune simboluri pe steagurile din Asia și America de Sud.";
"FACT_26_TITLE" = "Steagul cu un copac";
"FACT_26_DESC" = "Libanul este singura țară cu un copac (cedrul libanez) pe steagul său, simbolizând eternitatea și pacea.";
"FACT_27_TITLE" = "Cel mai îngust steag";
"FACT_27_DESC" = "Steagul Qatarului are cel mai neobișnuit raport de aspect al oricărui steag național – 11:28.";
"FACT_28_TITLE" = "Steme complexe";
"FACT_28_DESC" = "Stemele de pe steagurile Americii Latine includ adesea multe detalii și simboluri istorice.";
"FACT_29_TITLE" = "Steagul curcubeu";
"FACT_29_DESC" = "Bolivia are două steaguri oficiale - tricolorul tradițional și steagul curcubeu indigen Wiphala.";
"FACT_30_TITLE" = "Steagul cu o clădire";
"FACT_30_DESC" = "Steagul Cambodgiei arată templul Angkor Wat, ceea ce îl face singurul steag național cu o clădire.";
"FACT_31_TITLE" = "Dispute istorice";
"FACT_31_DESC" = "Designul unor steaguri s-a schimbat din cauza disputelor istorice și politice dintre țări.";
"FACT_32_TITLE" = "Steagul cu o sabie";
"FACT_32_DESC" = "Steagul Sri Lanka arată un leu care ține o sabie, simbolizând curajul poporului sinhalez.";
"FACT_33_TITLE" = "Steagul fără albastru";
"FACT_33_DESC" = "Doar patru țări nu folosesc albastru pe steaguri: Jamaica, Mauritania, Sri Lanka și Vatican.";
"FACT_34_TITLE" = "Păsări pe steaguri";
"FACT_34_DESC" = "Vulturul și alte păsări de pe steaguri simbolizează puterea, independența și noblețea spiritului.";
"FACT_35_TITLE" = "Simbol antarctic";
"FACT_35_DESC" = "Antarctica nu are steag național oficial, dar sunt folosite mai multe modele neoficiale.";
"FACT_36_TITLE" = "Stele pe steaguri";
"FACT_36_DESC" = "Steaua este unul dintre cele mai răspândite simboluri pe steagurile din întreaga lume.";
"FACT_37_TITLE" = "Scheme de culori similare";
"FACT_37_DESC" = "Unele steaguri sunt asemănătoare ca culoare, dar diferă în ordinea dungilor și a emblemelor.";
"FACT_38_TITLE" = "Steaguri ale uniunii internaționale";
"FACT_38_DESC" = "Organizațiile supranaționale au, de asemenea, propriile lor steaguri care reflectă valorile comune.";
"FACT_39_TITLE" = "Simbolismul insulei";
"FACT_39_DESC" = "Steagurile națiunilor insulare prezintă adesea simboluri ale oceanului, soarelui și navigației.";
"FACT_40_TITLE" = "Schimbări în timp";
"FACT_40_DESC" = "Unele steaguri naționale s-au schimbat de zeci de ori odată cu istoria politică a țării lor.";
"FACT_41_TITLE" = "Soarele Macedonia de Nord";
"FACT_41_DESC" = "Steagul Macedoniei de Nord are un soare cu opt raze pentru un nou început.";
"FACT_42_TITLE" = "Tăietorii de lemne din Belize";
"FACT_42_DESC" = "Steagul Belizei este unul dintre puținii oameni care arată: tăietorii de lemne cu unelte.";
"FACT_43_TITLE" = "condor ecuadorian";
"FACT_43_DESC" = "Steagul Ecuadorului include condorul andin pentru putere și suveranitate.";
"FACT_44_TITLE" = "Bolivia Wiphala";
"FACT_44_DESC" = "Bolivia folosește Wiphala alături de tricolor ca simbol oficial.";
"FACT_45_TITLE" = "Cele 27 de stele ale Braziliei";
"FACT_45_DESC" = "Steagul brazilian are 27 de stele, câte una pentru fiecare stat și district federal.";
"FACT_46_TITLE" = "Frunza de arțar";
"FACT_46_DESC" = "Steagul Canadei prezintă o singură frunză de arțar cu 11 vârfuri, unică printre steaguri naționale.";
"FACT_47_TITLE" = "Union Jack";
"FACT_47_DESC" = "Steagul Regatului Unit combină crucile a trei sfinți: Anglia, Scoția și Irlanda.";
"FACT_48_TITLE" = "Soarele răsare al Japoniei";
"FACT_48_DESC" = "Cercul roșu pe alb reprezintă soarele răsărit și a fost folosit pe steagul Japoniei încă din secolul al VII-lea.";
"FACT_49_TITLE" = "Ashoka Chakra";
"FACT_49_DESC" = "Steagul Indiei prezintă o roată cu 24 de spițe, simbolizând legea și mișcarea.";
"FACT_50_TITLE" = "Crucea de Sud a Australiei";
"FACT_50_DESC" = "Steagul Australiei arată constelația Southern Cross, vizibilă doar în emisfera sudică.";
"FACT_51_TITLE" = "Crucea de Sud a Noii Zeelande";
"FACT_51_DESC" = "Steagul Noii Zeelande prezintă și Crucea de Sud, dar cu stele roșii tivite în alb.";
"FACT_52_TITLE" = "taegeuk din Coreea de Sud";
"FACT_52_DESC" = "Steagul Coreei de Sud prezintă simbolul tradițional taegeuk (yin-yang) și trigramele.";
"FACT_53_TITLE" = "sfera armilară a Portugaliei";
"FACT_53_DESC" = "Steagul Portugaliei prezintă o sferă armilară, un instrument antic de navigație.";
"FACT_54_TITLE" = "Vulturul bicefal al Albaniei";
"FACT_54_DESC" = "Steagul Albaniei arată un vultur negru cu două capete, un simbol al suveranității.";
"FACT_55_TITLE" = "Scutul Keniei";
"FACT_55_DESC" = "Steagul Keniei prezintă un scut Maasai și sulițe încrucișate.";
"FACT_56_TITLE" = "dragonul Țării Galilor";
"FACT_56_DESC" = "Dragonul roșu de pe steagul Țării Galilor este unul dintre cele mai vechi simboluri naționale din lume.";
"FACT_57_TITLE" = "crucea Sfântului Andrei";
"FACT_57_DESC" = "Steagul Scoției este o cruce diagonală albă pe albastru, crucea Sfântului Andrei.";
"FACT_58_TITLE" = "Cercul Groenlandei";
"FACT_58_DESC" = "Steagul Groenlandei are un cerc roșu și alb reprezentând soarele deasupra gheții.";
"FACT_59_TITLE" = "Culorile panafricane";
"FACT_59_DESC" = "Verde, galben și roșu sunt adesea numite culori panafricane și apar pe multe steaguri africane.";
"FACT_60_TITLE" = "Cruci nordice";
"FACT_60_DESC" = "Cinci țări folosesc crucea nordică: Danemarca, Norvegia, Suedia, Finlanda și Islanda.";
"FACT_61_TITLE" = "tricolor francez";
"FACT_61_DESC" = "Tricolorul francez albastru-alb-roșu a devenit un model pentru multe steaguri revoluționare și naționale.";
"FACT_62_TITLE" = "Steagul ONU";
"FACT_62_DESC" = "Steagul ONU arată lumea înconjurată de ramuri de măslin pe un fundal albastru.";
"FACT_63_TITLE" = "Steagul UE";
"FACT_63_DESC" = "Douăsprezece stele aurii într-un cerc pe albastru simbolizează unitatea Uniunii Europene.";
"FACT_64_TITLE" = "Steagul olimpic";
"FACT_64_DESC" = "Cele cinci inele pe alb reprezintă cele cinci continente locuite și natura globală a Jocurilor.";
"FACT_65_TITLE" = "Piața Vaticanului";
"FACT_65_DESC" = "Vaticanul are un steag național pătrat ca Elveția.";
"FACT_66_TITLE" = "Nauru 12 puncte";
"FACT_66_DESC" = "Steagul Nauru are o stea cu 12 colțuri pentru cele 12 triburi.";
"FACT_67_TITLE" = "covor Turkmenistan";
"FACT_67_DESC" = "Steagul Turkmenistanului are modele de covoare de-a lungul palanului.";
