/* 68 interesting facts */
"FACT_01_TITLE" = "가장 오래되고 지속적으로 사용되는 플래그";
"FACT_01_DESC" = "덴마크의 Dannebrog는 1219년 이후 지속적으로 사용되는 가장 오래된 국기로 간주됩니다.";
"FACT_02_TITLE" = "정사각형 국기만";
"FACT_02_DESC" = "스위스는 세계에서 유일한 정사각형 국기를 보유하고 있습니다. 바티칸도 사각형 깃발을 갖고 있지만 도시국가이다.";
"FACT_03_TITLE" = "직사각형이 아닌 플래그";
"FACT_03_DESC" = "네팔은 직사각형이 아닌 세계 유일의 국기를 가지고 있습니다.";
"FACT_04_TITLE" = "빨간색, 흰색, 파란색 없음";
"FACT_04_DESC" = "자메이카는 빨간색, 흰색, 파란색이 없는 국기를 사용하는 유일한 국가입니다.";
"FACT_05_TITLE" = "결코 내려지지 않는 깃발";
"FACT_05_DESC" = "사우디아라비아의 국기는 신성한 문구가 적혀 있기 때문에 결코 반기둥으로 게양되지 않습니다.";
"FACT_06_TITLE" = "젊은 국기";
"FACT_06_DESC" = "남수단의 국기는 2011년 독립 후 채택됐다.";
"FACT_07_TITLE" = "AK-47로 깃발을 꽂으세요";
"FACT_07_DESC" = "모잠비크는 현대식 무기인 칼라시니코프 소총을 국기로 사용한 유일한 국가입니다.";
"FACT_08_TITLE" = "거의 동일한 플래그";
"FACT_08_DESC" = "루마니아와 차드의 국기는 매우 유사합니다. 그들은 일반적으로 파란색 음영으로 구별됩니다.";
"FACT_09_TITLE" = "우크라이나의 상징주의";
"FACT_09_DESC" = "우크라이나의 파란색과 노란색 깃발은 전통적으로 밀밭 위의 하늘로 해석됩니다.";
"FACT_10_TITLE" = "가장 간단한 플래그";
"FACT_10_DESC" = "1977년부터 2011년까지 리비아의 국기는 상징이나 패턴이 없는 단색 녹색이었습니다.";
"FACT_11_TITLE" = "지도로 깃발을 꽂다";
"FACT_11_DESC" = "키프로스의 국기는 섬의 윤곽을 보여줍니다. 이는 국기 중에서는 드문 경우입니다.";
"FACT_12_TITLE" = "성경으로 깃발을 꽂다";
"FACT_12_DESC" = "도미니카 공화국의 국기에는 성경이 열려 있어 종교 서적이 들어 있는 유일한 국기입니다.";
"FACT_13_TITLE" = "가장 인기있는 색상";
"FACT_13_DESC" = "빨간색은 전 세계적으로 국기의 가장 일반적인 색상입니다.";
"FACT_14_TITLE" = "텍스트로 플래그 지정";
"FACT_14_DESC" = "국기에 대한 텍스트는 드뭅니다. 잘 알려진 사례 중 하나는 사우디아라비아입니다.";
"FACT_15_TITLE" = "깃발 에티켓";
"FACT_15_DESC" = "많은 국가에서는 국기 취급 방법에 대해 엄격한 규정을 두고 있습니다.";
"FACT_16_TITLE" = "다른 면이 있는 플래그";
"FACT_16_DESC" = "파라과이는 앞면과 뒷면의 디자인이 다른 세계 유일의 국기를 보유하고 있습니다.";
"FACT_17_TITLE" = "올림픽 상징주의";
"FACT_17_DESC" = "올림픽 링 색상은 모든 국가의 국기에 최소한 하나의 색상이 나타나도록 선택되었습니다.";
"FACT_18_TITLE" = "가장 복잡한 문장을 가진 깃발";
"FACT_18_DESC" = "멕시코 국기에는 선인장 위에 앉아 있는 독수리가 뱀을 안고 있는 모습이 그려져 있는데, 이는 모든 국기에서 가장 상세한 문장 중 하나입니다.";
"FACT_19_TITLE" = "모방 플래그";
"FACT_19_DESC" = "모나코와 인도네시아의 국기는 위쪽이 빨간색, 아래쪽이 흰색으로 거의 동일합니다. 유일한 차이점은 비율입니다.";
"FACT_20_TITLE" = "별 50개가 있는 깃발";
"FACT_20_DESC" = "미국 국기에는 각 주마다 하나씩 총 50개의 별이 있습니다. 1777년 이후 디자인이 27번이나 변경되었습니다.";
"FACT_21_TITLE" = "최북단 깃발";
"FACT_21_DESC" = "북극 지역에서는 독특한 상징성을 지닌 국기와 지역 국기를 모두 사용합니다.";
"FACT_22_TITLE" = "십자가 깃발";
"FACT_22_DESC" = "29개 국가의 국기에 십자가가 있으며 이는 국기에서 가장 인기 있는 상징 중 하나입니다.";
"FACT_23_TITLE" = "삼색기";
"FACT_23_DESC" = "많은 국가에서는 역사적으로 안정된 깃발 형태로 단순한 삼선 디자인을 사용합니다.";
"FACT_24_TITLE" = "초승달 모양의 깃발";
"FACT_24_DESC" = "초승달은 대부분 이슬람교도인 12개국의 국기에 나타나 이슬람 신앙을 상징합니다.";
"FACT_25_TITLE" = "태양 기호";
"FACT_25_DESC" = "태양은 아시아와 남미의 국기에서 가장 흔한 상징 중 하나입니다.";
"FACT_26_TITLE" = "나무로 깃발을 꽂다";
"FACT_26_DESC" = "레바논은 영원과 평화를 상징하는 나무(레바논 삼나무)를 국기에 넣은 유일한 국가입니다.";
"FACT_27_TITLE" = "가장 좁은 플래그";
"FACT_27_DESC" = "카타르 국기는 모든 국기 중 가장 특이한 종횡비(11:28)를 가지고 있습니다.";
"FACT_28_TITLE" = "복잡한 문장";
"FACT_28_DESC" = "라틴 아메리카 국기의 문장에는 많은 세부 사항과 역사적 상징이 포함되어 있는 경우가 많습니다.";
"FACT_29_TITLE" = "무지개 깃발";
"FACT_29_DESC" = "볼리비아에는 전통적인 삼색기와 토착 Wiphala 무지개 깃발이라는 두 가지 공식 국기가 있습니다.";
"FACT_30_TITLE" = "건물에 깃발을 꽂다";
"FACT_30_DESC" = "캄보디아 국기에는 앙코르와트 사원이 그려져 있어 건물이 있는 유일한 국기입니다.";
"FACT_31_TITLE" = "역사적 분쟁";
"FACT_31_DESC" = "일부 국기의 디자인은 국가 간 역사적, 정치적 분쟁으로 인해 변경되었습니다.";
"FACT_32_TITLE" = "칼로 깃발을 꽂다";
"FACT_32_DESC" = "스리랑카 국기에는 칼을 들고 있는 사자가 그려져 있는데, 이는 싱할라족의 용기를 상징합니다.";
"FACT_33_TITLE" = "파란색이 없는 깃발";
"FACT_33_DESC" = "국기에 파란색을 사용하지 않는 나라는 자메이카, 모리타니, 스리랑카, 바티칸 4개국 뿐이다.";
"FACT_34_TITLE" = "깃발에 새";
"FACT_34_DESC" = "깃발에 있는 독수리와 다른 새들은 힘, 독립, 정신의 고귀함을 상징합니다.";
"FACT_35_TITLE" = "남극의 상징";
"FACT_35_DESC" = "남극 대륙에는 공식 국기가 없지만 여러 비공식 디자인이 사용됩니다.";
"FACT_36_TITLE" = "깃발에 별";
"FACT_36_DESC" = "별은 전 세계 국기에서 가장 널리 사용되는 상징 중 하나입니다.";
"FACT_37_TITLE" = "비슷한 색 구성표";
"FACT_37_DESC" = "일부 깃발은 색상이 비슷하지만 줄무늬와 엠블럼의 순서가 다릅니다.";
"FACT_38_TITLE" = "국제 연합 깃발";
"FACT_38_DESC" = "초국가적 조직은 또한 공유된 가치를 반영하는 자체 깃발을 가지고 있습니다.";
"FACT_39_TITLE" = "섬의 상징";
"FACT_39_DESC" = "섬나라의 국기에는 바다, 태양, 항해의 상징이 자주 등장합니다.";
"FACT_40_TITLE" = "시간에 따른 변화";
"FACT_40_DESC" = "일부 국기는 해당 국가의 정치적 역사에 따라 수십 번 변경되었습니다.";
"FACT_41_TITLE" = "북마케도니아의 태양";
"FACT_41_DESC" = "북마케도니아 국기에는 새로운 시작을 위한 8개의 광선이 있는 태양이 있습니다.";
"FACT_42_TITLE" = "벨리즈 나무꾼";
"FACT_42_DESC" = "벨리즈 국기는 도구를 들고 있는 나무꾼을 보여주는 몇 안 되는 사람 중 하나입니다.";
"FACT_43_TITLE" = "에콰도르 콘도르";
"FACT_43_DESC" = "에콰도르 국기에는 힘과 주권을 상징하는 안데스 콘도르가 포함되어 있습니다.";
"FACT_44_TITLE" = "볼리비아 위팔라";
"FACT_44_DESC" = "볼리비아는 삼색기와 함께 Wiphala를 공식 상징으로 사용합니다.";
"FACT_45_TITLE" = "브라질의 별 27개";
"FACT_45_DESC" = "브라질 국기에는 각 주와 연방구를 상징하는 27개의 별이 있습니다.";
"FACT_46_TITLE" = "단풍잎";
"FACT_46_DESC" = "캐나다 국기에는 국기 중에서 독특한 11개의 뾰족한 단풍잎이 그려져 있습니다.";
"FACT_47_TITLE" = "영국 국기";
"FACT_47_DESC" = "영국 국기는 잉글랜드, 스코틀랜드, 아일랜드 세 성자의 십자가를 합친 것입니다.";
"FACT_48_TITLE" = "일본의 떠오르는 태양";
"FACT_48_DESC" = "흰색 바탕에 빨간색 원은 떠오르는 태양을 나타내며 7세기부터 일본 국기에 사용되었습니다.";
"FACT_49_TITLE" = "아쇼카 차크라";
"FACT_49_DESC" = "인도 국기에는 법과 운동을 상징하는 24개의 바퀴가 달려 있습니다.";
"FACT_50_TITLE" = "호주의 서던 크로스";
"FACT_50_DESC" = "호주 국기에는 남반구에서만 볼 수 있는 남십자성 별자리가 표시되어 있습니다.";
"FACT_51_TITLE" = "뉴질랜드의 서던 크로스";
"FACT_51_DESC" = "뉴질랜드 국기에도 남십자성이 그려져 있지만 테두리가 흰색으로 테두리가 빨간색입니다.";
"FACT_52_TITLE" = "한국의 태극";
"FACT_52_DESC" = "한국의 국기는 전통적인 태극(음양) 기호와 트라이그램을 특징으로 합니다.";
"FACT_53_TITLE" = "포르투갈의 혼천의";
"FACT_53_DESC" = "포르투갈 국기에는 고대 항해 도구인 혼천의가 그려져 있습니다.";
"FACT_54_TITLE" = "알바니아의 쌍두독수리";
"FACT_54_DESC" = "알바니아의 국기에는 주권의 상징인 검은색 쌍두 독수리가 그려져 있습니다.";
"FACT_55_TITLE" = "케냐의 방패";
"FACT_55_DESC" = "케냐의 국기에는 마사이족의 방패와 교차된 창이 그려져 있습니다.";
"FACT_56_TITLE" = "웨일즈의 용";
"FACT_56_DESC" = "웨일스 국기의 붉은 용은 세계에서 가장 오래된 국가 상징 중 하나입니다.";
"FACT_57_TITLE" = "성 안드레아의 십자가";
"FACT_57_DESC" = "스코틀랜드 국기는 파란색 바탕에 흰색 대각선 십자가가 있는 성 안드레아의 십자가입니다.";
"FACT_58_TITLE" = "그린란드의 고리";
"FACT_58_DESC" = "그린란드의 국기에는 얼음 위의 태양을 나타내는 빨간색과 흰색 원이 있습니다.";
"FACT_59_TITLE" = "범아프리카 색상";
"FACT_59_DESC" = "녹색, 노란색, 빨간색은 종종 범아프리카 색상이라고 불리며 많은 아프리카 국기에 나타납니다.";
"FACT_60_TITLE" = "노르딕 십자가";
"FACT_60_DESC" = "노르딕 크로스를 사용하는 국가는 덴마크, 노르웨이, 스웨덴, 핀란드, 아이슬란드 등 5개국입니다.";
"FACT_61_TITLE" = "프랑스 삼색기";
"FACT_61_DESC" = "프랑스의 청백적 삼색기는 많은 혁명기와 국기의 모델이 되었습니다.";
"FACT_62_TITLE" = "유엔 깃발";
"FACT_62_DESC" = "UN 국기는 파란색 배경에 올리브 가지로 둘러싸인 세계를 보여줍니다.";
"FACT_63_TITLE" = "EU 깃발";
"FACT_63_DESC" = "파란색 원 안의 12개의 황금별은 유럽연합의 통합을 상징합니다.";
"FACT_64_TITLE" = "올림픽 깃발";
"FACT_64_DESC" = "흰색 바탕의 5개 고리는 사람이 거주하는 5개 대륙과 게임의 글로벌 성격을 나타냅니다.";
"FACT_65_TITLE" = "바티칸 광장";
"FACT_65_DESC" = "바티칸에는 스위스처럼 정사각형 모양의 국기가 있습니다.";
"FACT_66_TITLE" = "나우루 12점";
"FACT_66_DESC" = "나우루 국기에는 12개 부족을 나타내는 12개의 별이 있습니다.";
"FACT_67_TITLE" = "투르크메니스탄 카펫";
"FACT_67_DESC" = "투르크메니스탄 국기는 호이스트를 따라 카펫 패턴이 있습니다.";
"FACT_68_TITLE" = "아프가니스탄 모스크";
