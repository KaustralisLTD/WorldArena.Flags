/* 68 interesting facts */
"FACT_01_TITLE" = "最古老的連續使用標誌";
"FACT_01_DESC" = "丹麥的丹尼布羅格被認為是自 1219 年以來一直使用的最古老的國旗。";
"FACT_02_TITLE" = "唯一的方形國旗";
"FACT_02_DESC" = "瑞士擁有世界上唯一的方形國旗。梵蒂岡也有方形旗幟，但它是一個城邦。";
"FACT_03_TITLE" = "非矩形標誌";
"FACT_03_DESC" = "尼泊爾擁有全世界唯一一面非長方形的國旗。";
"FACT_04_TITLE" = "沒有紅色、白色或藍色";
"FACT_04_DESC" = "牙買加是唯一一個國旗沒有紅、白、藍的國家。";
"FACT_05_TITLE" = "永不降下的旗幟";
"FACT_05_DESC" = "由於上面有神聖的文字，沙烏地阿拉伯的國旗從未下半旗。";
"FACT_06_TITLE" = "年輕的國旗";
"FACT_06_DESC" = "南蘇丹國旗於2011年獨立後採用。";
"FACT_07_TITLE" = "帶有 AK-47 的旗幟";
"FACT_07_DESC" = "莫三比克是唯一一個在國旗上印有現代武器－卡拉什尼科夫步槍的國家。";
"FACT_08_TITLE" = "幾乎相同的標誌";
"FACT_08_DESC" = "羅馬尼亞和乍得的國旗非常相似；它們通常以藍色陰影來區分。";
"FACT_09_TITLE" = "烏克蘭的象徵意義";
"FACT_09_DESC" = "烏克蘭的藍黃國旗傳統上被解釋為麥田上空的天空。";
"FACT_10_TITLE" = "最簡單的旗幟";
"FACT_10_DESC" = "1977 年至 2011 年間，利比亞國旗為純綠色，沒有任何符號或圖案。";
"FACT_11_TITLE" = "帶有地圖的旗幟";
"FACT_11_DESC" = "塞浦路斯的國旗顯示了該島的輪廓——這在國旗中是罕見的。";
"FACT_12_TITLE" = "帶有聖經的旗幟";
"FACT_12_DESC" = "多明尼加共和國的國旗上有一本打開的聖經，這使其成為唯一帶有宗教書籍的國旗。";
"FACT_13_TITLE" = "最受歡迎的顏色";
"FACT_13_DESC" = "紅色是世界各地國旗上最常見的顏色。";
"FACT_14_TITLE" = "帶有文字的旗幟";
"FACT_14_DESC" = "國旗上的文字很少見；沙烏地阿拉伯就是一個著名的例子。";
"FACT_15_TITLE" = "國旗禮儀";
"FACT_15_DESC" = "許多國家對如何對待國旗有嚴格的規定。";
"FACT_16_TITLE" = "不同面的旗幟";
"FACT_16_DESC" = "巴拉圭擁有全世界唯一一面正反面圖案不同的國旗。";
"FACT_17_TITLE" = "奧林匹克象徵意義";
"FACT_17_DESC" = "奧運五環顏色的選擇是為了使每個國家的國旗上至少出現一種顏色。";
"FACT_18_TITLE" = "擁有最複雜徽章的旗幟";
"FACT_18_DESC" = "墨西哥國旗上有一隻鷹棲息在仙人掌上，叼著一條蛇——這是所有國旗上最細緻的紋章之一。";
"FACT_19_TITLE" = "山寨旗";
"FACT_19_DESC" = "摩納哥和印尼的國旗幾乎相同——上面是紅色，下面是白色。唯一的區別是比例。";
"FACT_20_TITLE" = "帶有 50 顆星的旗幟";
"FACT_20_DESC" = "美國國旗有 50 顆星，每個州一顆。自 1777 年以來，設計已更改了 27 次。";
"FACT_21_TITLE" = "最北端的旗幟";
"FACT_21_DESC" = "北極地區使用具有獨特象徵意義的國家和地區旗幟。";
"FACT_22_TITLE" = "帶有十字架的旗幟";
"FACT_22_DESC" = "29 個國家的國旗上有十字，使其成為國旗上最受歡迎的符號之一。";
"FACT_23_TITLE" = "三色旗";
"FACT_23_DESC" = "許多國家都使用簡單的三條紋設計作為歷史上穩定的旗幟形式。";
"FACT_24_TITLE" = "帶新月的旗幟";
"FACT_24_DESC" = "新月出現在12個國家的國旗上，其中大部分是穆斯林國家，象徵伊斯蘭信仰。";
"FACT_25_TITLE" = "太陽符號";
"FACT_25_DESC" = "太陽是亞洲和南美洲國旗上最常見的符號之一。";
"FACT_26_TITLE" = "帶有樹的旗幟";
"FACT_26_DESC" = "黎巴嫩是唯一國旗上有一棵樹（黎巴嫩雪松）的國家，象徵著永恆與和平。";
"FACT_27_TITLE" = "最窄的旗幟";
"FACT_27_DESC" = "卡達國旗的長寬比是所有國旗中最不尋常的——11:28。";
"FACT_28_TITLE" = "複雜的徽章";
"FACT_28_DESC" = "拉丁美洲國旗上的徽章通常包含許多細節和歷史符號。";
"FACT_29_TITLE" = "彩虹旗";
"FACT_29_DESC" = "玻利維亞有兩種官方旗幟：傳統的三色旗幟和土著維法拉彩虹旗。";
"FACT_30_TITLE" = "帶有建築物的旗幟";
"FACT_30_DESC" = "柬埔寨國旗上有吳哥窟寺廟，使其成為唯一有建築物的國旗。";
"FACT_31_TITLE" = "歷史糾紛";
"FACT_31_DESC" = "由於國家之間的歷史和政治爭端，一些旗幟的設計發生了變化。";
"FACT_32_TITLE" = "拿著劍的旗幟";
"FACT_32_DESC" = "斯里蘭卡國旗上有一隻手持利劍的獅子，象徵著僧伽羅人的勇敢。";
"FACT_33_TITLE" = "沒有藍色的旗幟";
"FACT_33_DESC" = "只有四個國家的國旗上不使用藍色：牙買加、茅利塔尼亞、斯里蘭卡和梵蒂岡。";
"FACT_34_TITLE" = "旗幟上的鳥兒";
"FACT_34_DESC" = "旗幟上的鷹和其他鳥類象徵著力量、獨立和高貴的精神。";
"FACT_35_TITLE" = "南極符號";
"FACT_35_DESC" = "南極洲沒有官方國旗，但使用了幾種非官方設計。";
"FACT_36_TITLE" = "旗幟上的星星";
"FACT_36_DESC" = "這顆星星是世界各地旗幟上最常見的符號之一。";
"FACT_37_TITLE" = "相似的配色方案";
"FACT_37_DESC" = "有些旗幟顏色相似，但條紋和徽章的順序不同。";
"FACT_38_TITLE" = "國際聯盟旗幟";
"FACT_38_DESC" = "超國家組織也有自己的旗幟，反映共同的價值。";
"FACT_39_TITLE" = "島嶼象徵意義";
"FACT_39_DESC" = "島國的國旗通常帶有海洋、太陽和航海的象徵。";
"FACT_40_TITLE" = "隨著時間的推移而變化";
"FACT_40_DESC" = "有些國旗隨著國家的政治歷史改變了數十次。";
"FACT_41_TITLE" = "北馬其頓 太陽";
"FACT_41_DESC" = "北馬其頓國旗上有一個帶有八道光芒的太陽，代表新的開始。";
"FACT_42_TITLE" = "貝里斯樵夫";
"FACT_42_DESC" = "伯利茲國旗是少數展示人物的國旗之一：拿著工具的伐木工人。";
"FACT_43_TITLE" = "厄瓜多禿鷹";
"FACT_43_DESC" = "厄瓜多爾國旗上有代表力量和主權的安地斯禿鷹。";
"FACT_44_TITLE" = "玻利維亞 維帕拉";
"FACT_44_DESC" = "玻利維亞使用威法拉和三色旗作為官方標誌。";
"FACT_45_TITLE" = "巴西27星";
"FACT_45_DESC" = "巴西國旗有 27 顆星，每個州和聯邦區各一顆。";
"FACT_46_TITLE" = "楓葉";
"FACT_46_DESC" = "加拿大國旗上有一片 11 角楓葉，這在各國國旗中是獨一無二的。";
"FACT_47_TITLE" = "英國國旗";
"FACT_47_DESC" = "英國國旗由三位聖人的十字架組成：英格蘭、蘇格蘭和愛爾蘭。";
"FACT_48_TITLE" = "日本初升的太陽";
"FACT_48_DESC" = "白底紅圈代表初升的太陽，自七世紀以來一直被用於日本國旗上。";
"FACT_49_TITLE" = "阿育王脈輪";
"FACT_49_DESC" = "印度國旗上有一個 24 輻輪，象徵法律和運動。";
"FACT_50_TITLE" = "澳洲南十字星";
"FACT_50_DESC" = "澳洲國旗上有南十字星座，只有在南半球才能看到。";
"FACT_51_TITLE" = "紐西蘭南十字星";
"FACT_51_DESC" = "紐西蘭國旗上也有南十字星，但紅星鑲有白邊。";
"FACT_52_TITLE" = "韓國太極";
"FACT_52_DESC" = "韓國國旗上有傳統的太極（陰陽）符號和卦象。";
"FACT_53_TITLE" = "葡萄牙的渾天儀";
"FACT_53_DESC" = "葡萄牙國旗上有一個渾天儀，這是一種古老的航海儀器。";
"FACT_54_TITLE" = "阿爾巴尼亞雙頭鷹";
"FACT_54_DESC" = "阿爾巴尼亞國旗上有一隻黑色雙頭鷹，是主權的象徵。";
"FACT_55_TITLE" = "肯亞的盾牌";
"FACT_55_DESC" = "肯亞國旗上有馬賽盾牌和交叉的長矛。";
"FACT_56_TITLE" = "威爾斯的龍";
"FACT_56_DESC" = "威爾斯國旗上的紅龍是世界上最古老的國家象徵之一。";
"FACT_57_TITLE" = "聖安德魯十字";
"FACT_57_DESC" = "蘇格蘭的國旗是藍底白色斜十字，即聖安德魯十字。";
"FACT_58_TITLE" = "格陵蘭島圈";
"FACT_58_DESC" = "格陵蘭島的國旗有一個紅白相間的圓圈，代表冰面上的太陽。";
"FACT_59_TITLE" = "泛非色彩";
"FACT_59_DESC" = "綠色、黃色和紅色通常被稱為泛非洲顏色，出現在許多非洲國旗上。";
"FACT_60_TITLE" = "北歐十字架";
"FACT_60_DESC" = "五個國家使用北歐十字：丹麥、挪威、瑞典、芬蘭和冰島。";
"FACT_61_TITLE" = "法國三色旗";
"FACT_61_DESC" = "法國藍白紅三色旗成為許多革命旗幟和國旗的典範。";
"FACT_62_TITLE" = "聯合國旗幟";
"FACT_62_DESC" = "聯合國旗幟在藍色背景上展示了被橄欖枝包圍的世界。";
"FACT_63_TITLE" = "歐盟旗幟";
"FACT_63_DESC" = "藍色圓圈內十二顆金色星星象徵歐盟的團結。";
"FACT_64_TITLE" = "奧林匹克會旗";
"FACT_64_DESC" = "白色的五個圓環代表五個有人居住的大陸和奧運會的全球性質。";
"FACT_65_TITLE" = "梵蒂岡廣場";
"FACT_65_DESC" = "梵蒂岡的國旗和瑞士一樣是方形的。";
"FACT_66_TITLE" = "諾魯12分";
"FACT_66_DESC" = "瑙魯國旗上有一顆12角星，代表12個部落。";
"FACT_67_TITLE" = "土庫曼地毯";
"FACT_67_DESC" = "土庫曼國旗沿著葫蘆有地毯圖案。";
"FACT_68_TITLE" = "阿富汗清真寺";
"FACT_68_DESC" = "阿富汗國旗的設計中有一座清真寺。";

