"FACT_38_DESC" = "Supranationale organisaties hebben ook eigen vlaggen met gedeelde waarden.";
"FACT_39_TITLE" = "Eilandsymboliek";
"FACT_39_DESC" = "Vlaggen van eilandstaten tonen vaak oceanen, zon en navigatie.";
