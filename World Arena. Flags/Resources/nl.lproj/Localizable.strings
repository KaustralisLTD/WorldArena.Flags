"FACT_43_TITLE" = "Condor van Ecuador";
"FACT_43_DESC" = "De vlag van Ecuador toont de Andescondor voor kracht en soevereiniteit.";
"FACT_44_TITLE" = "Twee vlaggen van Bolivia";
