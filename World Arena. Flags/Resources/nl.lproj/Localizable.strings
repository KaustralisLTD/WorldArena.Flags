"FACT_47_TITLE" = "Union Jack";
"FACT_47_DESC" = "De Britse vlag combineert de kruisen van drie heiligen: Engeland, Schotland en Ierland.";
"FACT_48_TITLE" = "Rijzende zon van Japan";
