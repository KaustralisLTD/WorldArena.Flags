"FACT_29_DESC" = "Bolivia heeft twee officiële vlaggen – de traditionele driekleur en de inheemse Wiphala.";
"FACT_30_TITLE" = "Vlag met gebouw";
"FACT_30_DESC" = "De vlag van Cambodja toont de tempel Angkor Wat, de enige nationale vlag met een gebouw.";
"FACT_31_TITLE" = "Historische geschillen";
