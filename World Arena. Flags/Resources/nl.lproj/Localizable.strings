"FACT_49_TITLE" = "Ashoka Chakra";
"FACT_49_DESC" = "De vlag van India heeft een wiel met 24 spaken, symbool van wet en beweging.";
"FACT_50_TITLE" = "Zuiderkruis van Australië";
