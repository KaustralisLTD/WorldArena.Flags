"FACT_63_TITLE" = "Vlag van de EU";
"FACT_63_DESC" = "Twaalf gouden sterren in een cirkel op blauw symboliseren de eenheid van de EU.";
"FACT_64_TITLE" = "Olympische vlag";
"FACT_64_DESC" = "De vijf ringen op wit staan voor de vijf bewoonde continenten en het mondiale karakter van de Spelen.";
"FACT_65_TITLE" = "Vierkante vlag van het Vaticaan";
"FACT_65_DESC" = "Het Vaticaan heeft net als Zwitserland een vierkante nationale vlag.";
