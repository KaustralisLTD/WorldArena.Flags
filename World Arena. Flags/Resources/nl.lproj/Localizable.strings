"FACT_53_TITLE" = "Armillairsfeer van Portugal";
"FACT_53_DESC" = "De vlag van Portugal toont een armillairsfeer, een oud navigatie-instrument.";
"FACT_54_TITLE" = "Tweekoppige adelaar van Albanië";
"FACT_54_DESC" = "De vlag van Albanië toont een zwarte tweekoppige adelaar, symbool van soevereiniteit.";
"FACT_55_TITLE" = "Schild van Kenia";
"FACT_55_DESC" = "De vlag van Kenia toont een Massai-schild en gekruiste speren.";
"FACT_56_TITLE" = "Draak van Wales";
"FACT_56_DESC" = "De rode draak van Wales is een van de oudste nationale symbolen ter wereld.";
"FACT_57_TITLE" = "Kruis van Sint-Andreas";
"FACT_57_DESC" = "De Schotse vlag is een wit diagonaal kruis op blauw, het kruis van Sint-Andreas.";
"FACT_58_TITLE" = "Cirkel van Groenland";
"FACT_58_DESC" = "De vlag van Groenland heeft een rood-witte cirkel voor de zon boven het ijs.";
"FACT_59_TITLE" = "Pan-Afrikaanse kleuren";
"FACT_59_DESC" = "Groen, geel en rood worden vaak pan-Afrikaanse kleuren genoemd en komen op veel Afrikaanse vlaggen voor.";
"FACT_60_TITLE" = "Nordische kruisen";
"FACT_60_DESC" = "Vijf landen gebruiken het nordische kruis: Denemarken, Noorwegen, Zweden, Finland en IJsland.";
"FACT_61_TITLE" = "Franse driekleur";
"FACT_61_DESC" = "De Franse blauw-wit-rode driekleur werd een voorbeeld voor veel revolutionaire en nationale vlaggen.";
"FACT_62_TITLE" = "Vlag van de VN";
