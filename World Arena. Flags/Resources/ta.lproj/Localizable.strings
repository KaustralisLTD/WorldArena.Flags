"HELP_GAME_DUEL" = "டூயல் என்பது முடிவுகளை ஒப்பிடுவதற்கு நீங்களும் உங்கள் நண்பரும் ஒரே கேள்விகளுக்கு பதிலளிக்கும் பயன்முறையாகும்.\n\nசண்டையை எவ்வாறு தொடங்குவது:\n1. உங்கள் நண்பரின் சுயவிவரத்தைத் திறக்கவும் (நண்பர்கள் பட்டியல், லீக்ஸ் அல்லது நினைவூட்டல்களிலிருந்து)\n2. \"சவால் டூயல்\" பொத்தானைத் தட்டவும்\n3. உறுதிப்படுத்தவும் - சண்டையானது பகிரப்பட்ட கேள்விகளின் தொகுப்பைப் பயன்படுத்தும்\n\nமுடிவில்:\n• யார் அதிக புள்ளிகள் எடுத்தார்கள் என்பதை நீங்கள் பார்க்கலாம்\n• டூவல் ஊக்கமளிக்கிறது மற்றும் முன்னேற்றத்தை அதிகரிக்கிறது, ஆனால் உங்கள் தினசரி தொடரை மீட்டமைக்காது";
"Как зарабатывать и тратить F-bucks?" = "F-பக்ஸ் சம்பாதிப்பது மற்றும் செலவு செய்வது எப்படி?";
"Внутриигровая валюта" = "விளையாட்டு நாணயம்";
"HELP_PROGRESS_FBUCKS" = "F-bucks (Flags Bucks) என்பது உலக அரங்கக் கொடிகளின் விளையாட்டு நாணயமாகும்.\n\nF-பக்ஸ் சம்பாதிப்பது எப்படி:\n• சரியான விளையாட்டுகளுக்கு (அனைத்து பதில்களும் சரி)\n• நீண்ட தினசரி கோடுகளுக்கு\n• தேடல்கள் மற்றும் சாதனைகளை முடிக்க\n\nஅவற்றை எதற்காக செலவிட வேண்டும்:\n• பிரத்தியேக தோல் மற்றும் அவதார் கூறுகளை வாங்குதல்\n• அரிதான பாகங்கள் மற்றும் விளைவுகளைத் திறக்கிறது\n\nமுக்கியமானது: F-பக்ஸ் உண்மையான பணம் அல்ல. அவற்றை திரும்பப் பெறவோ அல்லது உண்மையான நாணயத்திற்கு மாற்றவோ முடியாது.";
"Как работают квесты и достижения?" = "தேடல்களும் சாதனைகளும் எவ்வாறு செயல்படுகின்றன?";
"Месячные задания и артефакты" = "மாதாந்திர தேடல்கள் மற்றும் கலைப்பொருட்கள்";
"HELP_PROGRESS_QUESTS" = "\"தேடல்கள்\" தாவலில் நீங்கள் பார்ப்பது:\n• தினசரி தேடல்கள் (கிடைத்தால்)\n• மாதாந்திர தேடல்கள் மற்றும் மொத்த முன்னேற்றம் 0–40\n\nஇது எவ்வாறு செயல்படுகிறது:\n1. முழுமையான பணிகள்: தேவையான எண்ணிக்கையிலான கேம்களை விளையாடுதல், குறிப்பிட்ட பகுதிகளின் கொடிகளை யூகித்தல் போன்றவை.\n2. முடிக்கப்பட்ட ஒவ்வொரு தேடலும் முன்னேற்றத்தையும் வெகுமதிகளையும் தருகிறது\n3. மொத்த மாதாந்திர முன்னேற்றம் பட்டியாக வண்ணத் தலைப்பில் காட்டப்பட்டுள்ளது\n\nசிறப்பு நிபந்தனைகளுக்கு சாதனைகள் (கலைப்பொருட்கள்) திறக்கப்படுகின்றன:\n• நீண்ட கோடுகள்\n• உயர் துல்லியம்\n• லீக்குகளில் உயர்ந்த இடங்கள்\nதிறக்கப்பட்ட சாதனைகள் உங்கள் சுயவிவரத்தில் காட்டப்படும்.";

/* Help Center – notifications */
"Уведомления: какие бывают и как их настроить?" = "அறிவிப்புகள்: வகைகள் மற்றும் அவற்றை எவ்வாறு நிர்வகிப்பது?";
"Ежедневный урок, дуэли и напоминания" = "தினசரி பாடம், சண்டைகள் மற்றும் நினைவூட்டல்கள்";
"HELP_NOTIFICATIONS_TYPES" = "பயன்பாடு பல வகையான அறிவிப்புகளை அனுப்பலாம்:\n• தினசரி பாடம் மற்றும் ஸ்ட்ரீக் நினைவூட்டல்கள்\n• நண்பர்களுக்கு நினைவூட்டல்கள் மற்றும் உங்கள் நினைவூட்டல்களுக்கான பதில்கள்\n• சண்டை சவால்கள் மற்றும் சண்டை முடிவுகள்\n\nஅறிவிப்புகளை எவ்வாறு நிர்வகிப்பது:\n1. உங்கள் சாதன அமைப்புகளைத் திறக்கவும்\n2. உலக அரங்கக் கொடிகளைக் கண்டறியவும்\n3. நீங்கள் விரும்பும் அறிவிப்பு வகைகளை இயக்கவும் அல்லது முடக்கவும்\n\nதினசரி பாட நினைவூட்டல்களை இயக்குமாறு பரிந்துரைக்கிறோம், அதனால் உங்கள் தொடர்களை இழக்காதீர்கள்.";

/* Help Center – technical issues */
"Проблемы с загрузкой флагов" = "கொடிகள் ஏற்றப்படவில்லை";
"Что делать если флаги не загружаются" = "கொடிகள் ஏற்றப்படாவிட்டால் என்ன செய்வது";
"HELP_TECH_FLAGS_NOT_LOADING" = "கொடிகள் ஏற்றப்படவில்லை என்றால்:\n1. உங்கள் இணைய இணைப்பைச் சரிபார்க்கவும்\n2. பயன்பாட்டை மறுதொடக்கம் செய்யவும்\n3. பயன்பாட்டு அமைப்புகளில் தற்காலிக சேமிப்பை அழிக்கவும் (கிடைத்தால்)\n4. சமீபத்திய பதிப்பிற்கு பயன்பாட்டைப் புதுப்பிக்கவும்\n5. பிரச்சனை தொடர்ந்தால் ஆதரவைத் தொடர்பு கொள்ளவும்";
"Синхронизация данных" = "தரவு ஒத்திசைவு";
"Как сохранить прогресс" = "உங்கள் முன்னேற்றத்தை எவ்வாறு பாதுகாப்பாக வைத்திருப்பது";
"HELP_TECH_DATA_SYNC" = "உங்கள் முன்னேற்றம் சாதனத்தில் தானாகவே சேமிக்கப்படும்.\n\nகாப்புப் பிரதி எடுக்க:\n• iCloud அல்லது உங்கள் சாதன காப்புப்பிரதியைப் பயன்படுத்தவும்\n• தனியுரிமை அமைப்புகள் மூலம் தரவை ஏற்றுமதி செய்யவும் (கிடைத்தால்)\n• உங்கள் சாதனத்தின் காப்புப்பிரதிகளை வழக்கமாக உருவாக்கவும்\n\nநீங்கள் சாதனங்களை மாற்றினால், கேமைத் தொடங்குவதற்கு முன் காப்புப்பிரதியை மீட்டெடுக்கவும், அதனால் உங்கள் முன்னேற்றத்தை இழக்காதீர்கள்.";

