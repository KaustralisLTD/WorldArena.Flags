/* Help Center topics */
"Как играть в World Arena Flags?" = "World Arena Flags விளையாடுவது எப்படி?";
"Основы игры и правила" = "அடிப்படைகள் மற்றும் விதிகள்";
"HELP_GAME_RULES" = "World Arena Flags என்பது உலகக் கொடிகளைக் கற்க உதவும் சுவாரஸ்யமான விளையாட்டு!\n\nவிதிகள்:\n1. காட்டப்படும் நாட்டின் கொடியைப் பாருங்கள்.\n2. விருப்பங்களிலிருந்து சரியான நாட்டின் பெயரைத் தேர்ந்தெடுங்கள்.\n3. சரியான பதில்களுக்கு XP பெறுங்கள்.\n4. தினமும் விளையாடி தினசரித் தொடரைத் தக்கவையுங்கள்.\n5. நிலையை உயர்த்தி லீக்குகளில் முன்னேறுங்கள்.\n\nஅதிகம் விளையாடும்போது அதிகக் கொடிகளைக் கற்றுக்கொள்வீர்கள்!";
"Что такое серия дней?" = "தினசரித் தொடர் என்றால் என்ன?";
"Как работает система серий" = "தினசரித் தொடர் எவ்வாறு செயல்படுகிறது";
"HELP_STREAK_TEXT" = "தொடர்ந்து எத்தனை நாட்கள் விளையாடினீர்கள் என்பதை தினசரித் தொடர் காட்டுகிறது.\n\n• தொடரை நீட்டிக்க தினமும் குறைந்தது ஒரு ஆட்டமாவது விளையாடுங்கள்.\n• பாதுகாப்பு அட்டைகள் இருந்தால் தவறிய நாட்களிலும் தொடரைப் பாதுகாக்கலாம்.\n• விளையாடிய நாட்களையும் கிடைக்கும் பாதுகாப்பையும் பார்க்க தொடர் நாள்காட்டியைத் திறக்கவும்.\n\nவழக்கமான பயிற்சி கற்றல் பழக்கத்தை வளர்க்கும்!";
"Как работают лиги?" = "லீக்குகள் எவ்வாறு செயல்படுகின்றன?";
"Система рейтингов и соревнований" = "மதிப்பீடு மற்றும் போட்டி அமைப்பு";
"HELP_LEAGUES_TEXT" = "லீக்குகளில் மற்ற வீரர்களுடன் போட்டியிடலாம்.\n\nகீழிருந்து மேலாக:\n• வெண்கலம்\n• வெள்ளி\n• தங்கம்\n• பிளாட்டினம்\n• வைரம்\n• மாஸ்டர்\n\nவாராந்திர இடம் அடிப்படையில் மேலேறுவீர்கள், அதே லீக்கில் இருப்பீர்கள் அல்லது கீழிறங்குவீர்கள். மேலேறும், கீழிறங்கும் பகுதிகள் உங்கள் முன்னேற்றத்தைப் பொறுத்தவை; அவை லீக் அட்டவணையில் காட்டப்படும். மேலேறும்போது F-Bucks கிடைக்கும்.";

