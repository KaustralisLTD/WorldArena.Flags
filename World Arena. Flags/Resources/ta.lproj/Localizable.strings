"premium.story.example" = "எடுத்துக்காட்டுத் திரை · ஆங்கிலம்";
"premium.story.headline" = "கொடிகளைக் கற்றுக்கொள்ளுங்கள். உலகத்தை நினைவில் வையுங்கள்.";
"premium.story.intro" = "ஒவ்வொரு பயிற்சியையும் பயனுள்ளதாக மாற்றுங்கள்: நினைவில் கொள்ளக் கடினமான கொடிகளைப் பயிற்சி செய்யுங்கள், அவை குறிக்கும் நாடுகளை அறிந்துகொள்ளுங்கள், அடுத்து என்ன கற்க வேண்டும் என்பதைத் தேர்ந்தெடுங்கள்.";
"premium.story.map.body" = "எந்தக் கொடிகள் உங்களுக்கு நன்றாகத் தெரியும், எவற்றை மேலும் பயிற்சி செய்ய வேண்டும் என்பதை உங்கள் முன்னேற்ற வரைபடம் காட்டுகிறது. அடுத்து எதைப் பயிற்சி செய்வது என்று தேர்ந்தெடுக்க இது உதவும்.";
"premium.story.map.title" = "அடுத்து என்ன கற்றுக்கொள்ள வேண்டும் என்பதை அறிந்து கொள்ளுங்கள்.";
"premium.story.practice.body" = "உயிர்கள் மீண்டும் நிரம்புவதற்காகக் காத்திருக்காமல் தொடர்ந்து பயிற்சி செய்யுங்கள். மீண்டும் பயிற்சி செய்ய வேண்டிய கொடிகளில் கவனம் செலுத்த «என் தவறுகள்» பகுதி உதவுகிறது.";
"premium.story.practice.title" = "அதிகப் பயிற்சி. வலுவான அறிவு.";
"premium.story.progress.body" = "வழக்கமான பயிற்சியை புலப்படும் முடிவுகளாக மாற்றவும். உங்கள் துல்லியம் மற்றும் சரியான பதில்களை மதிப்பாய்வு செய்து, அடுத்து என்ன பயிற்சி செய்ய வேண்டும் என்பதை தேர்வு செய்ய Premium உலக வரைபடத்தைப் பயன்படுத்தவும்.";
