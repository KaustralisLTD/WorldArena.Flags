/* League motivation messages */
"league_motivation_win_01" = "இந்த வாரம் நீங்கள் சிறந்தவர்களில் ஒருவர். சிறந்த வேலை - இப்போது வேகத்தை வைத்திருங்கள்.";
"league_motivation_win_02" = "முதல் மூன்று இடங்களுக்குள் வந்தது தற்செயல் அல்ல. தொடர்ந்த பயிற்சியும் கவனமும் தந்த பலன் இது.";
"league_motivation_win_03" = "அருமையான வாரம்! இதே வேகத்தில் தொடருங்கள்—அடுத்த லீக் காத்திருக்கிறது.";
"league_motivation_promotion_01" = "பதவி உயர்வு என்றால் நீங்கள் வளர்ந்து வருகிறீர்கள். அடுத்த லீக் கடினமாக இருக்கும், ஆனால் நீங்கள் தயாராக உள்ளீர்கள்.";
"league_motivation_promotion_02" = "நீங்கள் ஒரு படி மேலே சென்றுள்ளீர்கள். இப்போது இலக்கு உயருவது மட்டுமல்ல, அங்கேயே இருக்க வேண்டும்.";
"league_motivation_stayed_01" = "உங்கள் இடத்தைத் தக்கவைத்தீர்கள். இந்த வலுவான அடித்தளத்திலிருந்து மேலும் முன்னேறுங்கள்.";
"league_motivation_stayed_02" = "கீழிறங்காமல் வாரத்தை முடித்ததும் சாதனைதான். அடுத்த இலக்கு: மேலேறும் பகுதியை அடைவது.";
"league_motivation_demotion_01" = "இந்த வாரம் சிறப்பாக அமையாவிட்டாலும் பரவாயில்லை. முயற்சியைத் தொடருங்கள்; அடுத்த வாரம் இன்னும் சிறப்பாகச் செயல்படலாம்.";
"league_motivation_demotion_02" = "கீழிறங்குவது முடிவல்ல. மீண்டும் தொடங்கி சிறப்பாக விளையாடும் வாய்ப்பு இது.";
