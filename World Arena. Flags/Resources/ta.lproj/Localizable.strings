"premium.family.body" = "Apple Family Sharing மூலம் நீங்கள் உட்பட 6 பேர் வரை Premium ஐப் பகிரவும். உங்கள் Apple குடும்ப அமைப்புகளில் சந்தா பகிர்வை இயக்கவும். ஒவ்வொரு வீரரும் தங்கள் சொந்த முன்னேற்றத்தை வைத்திருக்கிறார்கள்.";
"premium.family.title" = "உங்கள் குடும்பத்திற்கு ஒரு சந்தா";
"premium.story.countries.body" = "நாடுகளின் தகவல்கள், தலைநகரங்கள், நாணயங்கள் மற்றும் தேசிய கீதப் பதிவுகளை ஆராயுங்கள். ஒவ்வொரு கொடியையும் அது குறிக்கும் நாட்டுடன் தொடர்புபடுத்தி அறிந்துகொள்ளுங்கள்.";
"premium.story.countries.title" = "ஒவ்வொரு கொடிக்கும் ஒரு கதையைக் கொடுங்கள்.";
