"FACT_08_TITLE" = "கிட்டத்தட்ட ஒரே மாதிரியான கொடிகள்";
"FACT_08_DESC" = "ருமேனியா மற்றும் சாட் கொடிகள் மிகவும் ஒத்தவை; பொதுவாக நீல நிறத்தின் சாயலில் வேறுபடுகின்றன.";
"FACT_09_TITLE" = "உக்ரைனின் சின்னம்";
"FACT_09_DESC" = "உக்ரைனின் நீலம் மற்றும் மஞ்சள் கொடி பாரம்பரியமாக கோதுமை வயலுக்கு மேல் உள்ள வானம் என்று விளக்கப்படுகிறது.";
"FACT_10_TITLE" = "எளிமையான கொடி";
"FACT_10_DESC" = "1977 முதல் 2011 வரை லிபியாவின் கொடியானது சின்னங்கள் அல்லது வடிவங்கள் இல்லாமல் திட பச்சை நிறத்தில் இருந்தது.";
"FACT_11_TITLE" = "வரைபடத்துடன் கொடி";
"FACT_11_DESC" = "சைப்ரஸின் கொடி தீவின் வெளிப்புறத்தைக் காட்டுகிறது-தேசியக் கொடிகளில் அரிதான நிகழ்வு.";
"FACT_12_TITLE" = "பைபிளுடன் கொடி";
"FACT_12_DESC" = "டொமினிகன் குடியரசின் கொடி திறந்த பைபிளைக் காட்டுகிறது, இது ஒரு மத புத்தகத்துடன் கூடிய ஒரே தேசியக் கொடியாகும்.";
"FACT_13_TITLE" = "தேசியக் கொடிகளில் சிவப்பு";
"FACT_13_DESC" = "கனடா, ஜப்பான், சுவிட்சர்லாந்து உள்ளிட்ட பல நாடுகளின் கொடிகளில் சிவப்பு நிறம் உள்ளது.";
"FACT_14_TITLE" = "உரையுடன் கொடி";
"FACT_14_DESC" = "தேசியக் கொடிகளில் உரை எழுதுவது அரிது; ஒரு நன்கு அறியப்பட்ட உதாரணம் சவூதி அரேபியா.";
"FACT_15_TITLE" = "கொடி ஆசாரம்";
"FACT_15_DESC" = "பல நாடுகளில் தேசியக் கொடியை எப்படி நடத்த வேண்டும் என்பதில் கடுமையான விதிகள் உள்ளன.";
"FACT_16_TITLE" = "வெவ்வேறு பக்கங்களைக் கொண்ட கொடி";
"FACT_16_DESC" = "பராகுவேயில் உலகின் ஒரே தேசியக் கொடியின் முகப்பு மற்றும் பின்புறம் வெவ்வேறு வடிவமைப்புகள் உள்ளன.";
"FACT_17_TITLE" = "ஒலிம்பிக் சின்னம்";
"FACT_17_DESC" = "ஒலிம்பிக்கின் ஐந்து வளையங்களும் வெள்ளைப் பின்னணியும் சேர்ந்து ஆறு நிறங்களைக் கொண்டுள்ளன; இவை உலக நாடுகளின் கொடிகளைக் குறிக்கத் தேர்ந்தெடுக்கப்பட்டன.";
"FACT_18_TITLE" = "மெக்சிகோவின் அரசுச் சின்னம்";
"FACT_18_DESC" = "மெக்சிகோவின் கொடியில் கற்றாழை மீது அமர்ந்த கழுகு பாம்பைப் பிடித்திருக்கிறது.";
"FACT_19_TITLE" = "ஒத்த சிவப்பு-வெள்ளைக் கொடிகள்";
"FACT_19_DESC" = "மொனாக்கோ மற்றும் இந்தோனேசியாவின் கொடிகளில் மேலே சிவப்பும் கீழே வெள்ளையும் உள்ளன; ஆனால் அவற்றின் நீள-அகல விகிதங்கள் வேறுபடுகின்றன.";
"FACT_20_TITLE" = "50 நட்சத்திரங்கள் கொண்ட கொடி";
"FACT_20_DESC" = "அமெரிக்கக் கொடியின் 50 நட்சத்திரங்கள் ஒவ்வொரு மாநிலத்தையும் குறிக்கின்றன.";
"FACT_21_TITLE" = "வடக்கே கொடிகள்";
"FACT_21_DESC" = "ஆர்க்டிக் பகுதிகள் தேசிய மற்றும் பிராந்திய கொடிகளை தனித்துவமான அடையாளத்துடன் பயன்படுத்துகின்றன.";
"FACT_22_TITLE" = "சிலுவையுடன் கொடி";
"FACT_22_DESC" = "டென்மார்க், பின்லாந்து, சுவிட்சர்லாந்து உள்ளிட்ட பல நாடுகளின் கொடிகளில் சிலுவை உள்ளது.";
"FACT_23_TITLE" = "மூவர்ணங்கள்";
"FACT_23_DESC" = "பல நாடுகள் ஒரு எளிய மூன்று-கோடு வடிவமைப்பை வரலாற்று ரீதியாக நிலையான கொடி வடிவமாக பயன்படுத்துகின்றன.";
"FACT_24_TITLE" = "பிறை கொண்ட கொடி";
"FACT_24_DESC" = "துருக்கி, பாகிஸ்தான், துனிசியா உள்ளிட்ட பல நாடுகளின் கொடிகளில் பிறை உள்ளது.";
"FACT_25_TITLE" = "சூரியன் சின்னம்";
"FACT_25_DESC" = "ஆசியா மற்றும் தென் அமெரிக்காவில் உள்ள கொடிகளில் சூரியன் மிகவும் பொதுவான சின்னங்களில் ஒன்றாகும்.";
"FACT_26_TITLE" = "ஒரு மரத்துடன் கொடி";
"FACT_26_DESC" = "லெபனானின் தேசியக் கொடியில் சிடார் மரம் உள்ளது.";
"FACT_27_TITLE" = "கத்தார் கொடியின் விகிதம்";
"FACT_27_DESC" = "கத்தாரின் தேசியக் கொடியின் உயரம்-அகல விகிதம் 11:28.";
"FACT_28_TITLE" = "சிக்கலான அரசுச் சின்னங்கள்";
"FACT_28_DESC" = "லத்தீன் அமெரிக்கக் கொடிகளில் உள்ள அரசுச் சின்னங்கள் பல நுணுக்கங்களையும் வரலாற்றுச் சின்னங்களையும் கொண்டிருக்கும்.";
"FACT_29_TITLE" = "வானவில் கொடி";
"FACT_29_DESC" = "பொலிவியாவில் இரண்டு உத்தியோகபூர்வ கொடிகள் உள்ளன - பாரம்பரிய மூவர்ணக் கொடி மற்றும் உள்நாட்டு விபாலா வானவில் கொடி.";
"FACT_30_TITLE" = "ஒரு கட்டிடத்துடன் கொடி";
"FACT_30_DESC" = "கம்போடியாவின் தேசியக் கொடியில் அங்கோர் வாட் கோவில் உள்ளது.";
"FACT_31_TITLE" = "வரலாற்று சர்ச்சைகள்";
"FACT_31_DESC" = "நாடுகளுக்கிடையேயான வரலாற்று மற்றும் அரசியல் சர்ச்சைகள் காரணமாக சில கொடிகளின் வடிவமைப்பு மாறியுள்ளது.";
"FACT_32_TITLE" = "வாள் உள்ள கொடி";
"FACT_32_DESC" = "இலங்கையின் கொடியில் சிங்கம் ஒன்று வாள் ஏந்திய வண்ணம் உள்ளது, இது சிங்கள மக்களின் தைரியத்தை உணர்த்துகிறது.";
"FACT_33_TITLE" = "நீலம் இல்லாத கொடி";
"FACT_33_DESC" = "ஜமைக்கா, ஜப்பான், சுவிட்சர்லாந்து உள்ளிட்ட சில நாடுகளின் கொடிகளில் நீலம் இல்லை.";
"FACT_34_TITLE" = "கொடிகளில் பறவைகள்";
"FACT_34_DESC" = "கொடிகளில் கழுகு மற்றும் பிற பறவைகள் வலிமை, சுதந்திரம் மற்றும் ஆவியின் உன்னதத்தை அடையாளப்படுத்துகின்றன.";
"FACT_35_TITLE" = "அண்டார்டிக் சின்னம்";
"FACT_35_DESC" = "அண்டார்டிகாவில் அதிகாரப்பூர்வ தேசியக் கொடி இல்லை, ஆனால் பல அதிகாரப்பூர்வமற்ற வடிவமைப்புகள் பயன்படுத்தப்படுகின்றன.";
"FACT_36_TITLE" = "கொடிகளில் நட்சத்திரங்கள்";
"FACT_36_DESC" = "உலகெங்கிலும் உள்ள கொடிகளில் நட்சத்திரம் மிகவும் பரவலான சின்னங்களில் ஒன்றாகும்.";
"FACT_37_TITLE" = "ஒத்த வண்ண திட்டங்கள்";
"FACT_37_DESC" = "சில கொடிகள் ஒரே நிறத்தில் இருக்கும் ஆனால் கோடுகள் மற்றும் சின்னங்களின் வரிசையில் வேறுபடுகின்றன.";
"FACT_38_TITLE" = "சர்வதேச அமைப்புகளின் கொடிகள்";
"FACT_38_DESC" = "சூப்பர் நேஷனல் நிறுவனங்களும் பகிரப்பட்ட மதிப்புகளைப் பிரதிபலிக்கும் தங்கள் சொந்தக் கொடிகளைக் கொண்டுள்ளன.";
"FACT_39_TITLE" = "தீவு சின்னம்";
"FACT_39_DESC" = "தீவு நாடுகளின் கொடிகள் பெரும்பாலும் கடல், சூரியன் மற்றும் வழிசெலுத்தலின் சின்னங்களைக் கொண்டுள்ளன.";
"FACT_40_TITLE" = "காலப்போக்கில் மாற்றங்கள்";
"FACT_40_DESC" = "சில தேசியக் கொடிகள் தங்கள் நாட்டின் அரசியல் வரலாற்றில் டஜன் கணக்கான முறை மாறியுள்ளன.";
"FACT_41_TITLE" = "வடக்கு மாசிடோனியா சூரியன்";
"FACT_41_DESC" = "வடக்கு மாசிடோனியா கொடியில் ஒரு புதிய தொடக்கத்திற்காக எட்டு கதிர்கள் கொண்ட சூரியன் உள்ளது.";
"FACT_42_TITLE" = "பெலிஸ் மரம் வெட்டுபவர்கள்";
"FACT_42_DESC" = "மனிதர்கள் இடம்பெறும் சில தேசியக் கொடிகளில் பெலிஸின் கொடியும் ஒன்று; கருவிகளுடன் மரம் வெட்டுபவர்கள் அதில் உள்ளனர்.";
"FACT_43_TITLE" = "ஈக்வடார் காண்டோர்";
"FACT_43_DESC" = "ஈக்வடார் கொடி வலிமை மற்றும் இறையாண்மைக்கான ஆண்டியன் காண்டரை உள்ளடக்கியது.";
"FACT_44_TITLE" = "பொலிவியா விபாலா";
"FACT_44_DESC" = "பொலிவியா மூவர்ணத்துடன் விபாலாவை அதிகாரப்பூர்வ சின்னமாக பயன்படுத்துகிறது.";
"FACT_45_TITLE" = "பிரேசிலின் 27 நட்சத்திரங்கள்";
"FACT_45_DESC" = "பிரேசிலியக் கொடியில் 27 நட்சத்திரங்கள் உள்ளன, ஒவ்வொரு மாநிலத்திற்கும் கூட்டாட்சி மாவட்டத்திற்கும் ஒன்று.";
"FACT_46_TITLE" = "மேப்பிள் இலை";
"FACT_46_DESC" = "கனடாவின் கொடியில் வெள்ளைச் சதுரத்தின் மீது 11 முனைகளைக் கொண்ட சிவப்பு மேப்பிள் இலை உள்ளது.";
"FACT_47_TITLE" = "யூனியன் ஜாக்";
"FACT_47_DESC" = "ஐக்கிய இராச்சியத்தின் கொடி புனித ஜார்ஜ், புனித ஆண்ட்ரூ, புனித பேட்ரிக் ஆகியோரின் சிலுவைகளை இணைக்கிறது.";
"FACT_48_TITLE" = "ஜப்பானின் உதய சூரியன்";
"FACT_48_DESC" = "ஜப்பானின் தேசியக் கொடியில் வெள்ளைப் பின்னணியிலுள்ள சிவப்பு வட்டம் சூரியனைக் குறிக்கிறது.";
"FACT_49_TITLE" = "அசோக சக்கரம்";
"FACT_49_DESC" = "இந்தியாவின் கொடியில் சட்டம் மற்றும் இயக்கத்தை குறிக்கும் 24 ஸ்போக்குகள் கொண்ட சக்கரம் உள்ளது.";
"FACT_50_TITLE" = "ஆஸ்திரேலியாவின் தெற்கு கிராஸ்";
"FACT_50_DESC" = "ஆஸ்திரேலியாவின் கொடியிலுள்ள ஐந்து நட்சத்திரங்கள் தெற்குச் சிலுவை விண்மீன் கூட்டத்தைக் குறிக்கின்றன.";
"FACT_51_TITLE" = "நியூசிலாந்தின் தெற்கு கிராஸ்";
"FACT_51_DESC" = "நியூசிலாந்தின் கொடியிலும் தெற்குச் சிலுவை உள்ளது; அதன் சிவப்பு நட்சத்திரங்களுக்கு வெள்ளை விளிம்புகள் உள்ளன.";
"FACT_52_TITLE" = "தென் கொரியாவின் டேக்யூக்";
"FACT_52_DESC" = "தென் கொரியாவின் கொடி பாரம்பரிய டேகியூக் (யின்-யாங்) சின்னம் மற்றும் ட்ரிகிராம்களைக் கொண்டுள்ளது.";
"FACT_53_TITLE" = "போர்ச்சுகலின் ஆர்மில்லரி கோளம்";
"FACT_53_DESC" = "போர்ச்சுகலின் கொடியானது ஒரு ஆர்மில்லரி கோளத்தைக் கொண்டுள்ளது, இது ஒரு பண்டைய வழிசெலுத்தல் கருவியாகும்.";
"FACT_54_TITLE" = "அல்பேனியாவின் இரட்டை தலை கழுகு";
"FACT_54_DESC" = "அல்பேனியாவின் கொடியானது இறையாண்மையின் சின்னமான இரட்டைத் தலை கழுகு ஒன்றைக் காட்டுகிறது.";
"FACT_55_TITLE" = "கென்யாவின் கவசம்";
"FACT_55_DESC" = "கென்யாவின் கொடியில் மசாய் கேடயம் மற்றும் குறுக்கு ஈட்டிகள் உள்ளன.";
"FACT_56_TITLE" = "வேல்ஸின் டிராகன்";
"FACT_56_DESC" = "வேல்ஸின் கொடியில் வெள்ளை மற்றும் பச்சைப் பின்னணியில் சிவப்பு டிராகன் உள்ளது. இந்த வடிவம் 1959-இல் அதிகாரப்பூர்வமாக அங்கீகரிக்கப்பட்டது.";
"FACT_57_TITLE" = "செயின்ட் ஆண்ட்ரூ சிலுவை";
"FACT_57_DESC" = "ஸ்காட்லாந்தின் கொடியானது செயின்ட் ஆண்ட்ரூவின் சிலுவை, நீல நிறத்தில் உள்ள வெள்ளை மூலைவிட்ட சிலுவையாகும்.";
"FACT_58_TITLE" = "கிரீன்லாந்தின் வட்டம்";
"FACT_58_DESC" = "கிரீன்லாந்தின் கொடியானது பனிக்கு மேல் சூரியனைக் குறிக்கும் சிவப்பு மற்றும் வெள்ளை வட்டத்தைக் கொண்டுள்ளது.";
"FACT_59_TITLE" = "பான்-ஆப்பிரிக்க நிறங்கள்";
"FACT_59_DESC" = "பச்சை, மஞ்சள் மற்றும் சிவப்பு ஆகியவை பெரும்பாலும் பான்-ஆப்பிரிக்க நிறங்கள் என்று அழைக்கப்படுகின்றன மற்றும் பல ஆப்பிரிக்க கொடிகளில் தோன்றும்.";
"FACT_60_TITLE" = "நோர்டிக் சிலுவைகள்";
"FACT_60_DESC" = "ஐந்து நாடுகள் நோர்டிக் சிலுவையைப் பயன்படுத்துகின்றன: டென்மார்க், நார்வே, சுவீடன், பின்லாந்து மற்றும் ஐஸ்லாந்து.";
"FACT_61_TITLE" = "பிரெஞ்சு மூவர்ணக்கொடி";
"FACT_61_DESC" = "பிரெஞ்சு நீலம்-வெள்ளை-சிவப்பு மூவர்ணம் பல புரட்சிகர மற்றும் தேசியக் கொடிகளுக்கு ஒரு மாதிரியாக மாறியது.";
"FACT_62_TITLE" = "ஐநா கொடி";
"FACT_62_DESC" = "நீல நிற பின்னணியில் ஆலிவ் கிளைகளால் சூழப்பட்ட உலகத்தை ஐநா கொடி காட்டுகிறது.";
"FACT_63_TITLE" = "ஐரோப்பிய ஒன்றிய கொடி";
"FACT_63_DESC" = "நீல நிறத்தில் ஒரு வட்டத்தில் பன்னிரண்டு தங்க நட்சத்திரங்கள் ஐரோப்பிய ஒன்றியத்தின் ஒற்றுமையைக் குறிக்கின்றன.";
"FACT_64_TITLE" = "ஒலிம்பிக் கொடி";
"FACT_64_DESC" = "வெள்ளைப் பின்னணியில் உள்ள ஐந்து ஒலிம்பிக் வளையங்கள் ஐந்து கண்டங்களின் ஒற்றுமையையும் உலகெங்குமுள்ள வீரர்களையும் குறிக்கின்றன.";
"FACT_65_TITLE" = "வத்திக்கானின் சதுரக் கொடி";
"FACT_65_DESC" = "வத்திக்கானில் சுவிட்சர்லாந்தைப் போன்று சதுரமான தேசியக் கொடி உள்ளது.";
"FACT_66_TITLE" = "நவுருவின் 12 முனைகள்";
"FACT_66_DESC" = "நவுருவின் கொடியில் உள்ள 12 முனை நட்சத்திரம் 12 பழங்குடிகளைக் குறிக்கிறது.";
"FACT_67_TITLE" = "துர்க்மெனிஸ்தான் கம்பளம்";
"FACT_67_DESC" = "துர்க்மெனிஸ்தானின் கொடியில் கம்பத்திற்கு அருகிலுள்ள பகுதியில் கம்பள வடிவங்கள் உள்ளன.";
"FACT_68_TITLE" = "ஆப்கானிஸ்தான் மசூதி";
"FACT_68_DESC" = "ஆப்கானிஸ்தான் கொடி அதன் வடிவமைப்பில் ஒரு மசூதியைக் கொண்டுள்ளது.";

