/* League motivation messages */
"league_motivation_win_01" = "இந்த வாரம் நீங்கள் சிறந்தவர்களில் ஒருவர். சிறந்த வேலை - இப்போது வேகத்தை வைத்திருங்கள்.";
"league_motivation_win_02" = "முதல் 3 விபத்து அல்ல. இது நிலையான ஆட்டம் மற்றும் நல்ல கவனத்தின் விளைவு.";
"league_motivation_win_03" = "வலுவான வாரம். அதே வேகத்தில் தள்ளுங்கள் - அடுத்த லீக் காத்திருக்கிறது.";
"league_motivation_promotion_01" = "பதவி உயர்வு என்றால் நீங்கள் வளர்ந்து வருகிறீர்கள். அடுத்த லீக் கடினமாக இருக்கும், ஆனால் நீங்கள் தயாராக உள்ளீர்கள்.";
"league_motivation_promotion_02" = "நீங்கள் ஒரு படி மேலே சென்றுள்ளீர்கள். இப்போது இலக்கு உயருவது மட்டுமல்ல, அங்கேயே இருக்க வேண்டும்.";
"league_motivation_stayed_01" = "நீங்கள் உங்கள் பதவியை வகித்தீர்கள். ஒரு உறுதியான அடித்தளம் - இப்போது நிலைத்தன்மையை வளர்ச்சியாக மாற்றவும்.";
"league_motivation_stayed_02" = "பின்னடைவு இல்லாமல் ஒரு வாரம் ஏற்கனவே ஒரு முடிவு. அடுத்த படி: விளம்பர மண்டலத்தை அடையுங்கள்.";
"league_motivation_demotion_01" = "சிறந்த வாரம் அல்ல - அது நடக்கும். முக்கிய விஷயம் நிறுத்தக்கூடாது: அடுத்ததை நீங்கள் வலுவாக எடுக்கலாம்.";
"league_motivation_demotion_02" = "பதவி இறக்கம் என்பது முடிவல்ல. இது ஒரு ரீசெட் பாயிண்ட், அதன் பிறகு சிறந்த ரன்கள் அடிக்கடி பின்பற்றப்படும்.";
"league_motivation_general_01" = "ஒவ்வொரு வாரமும் உயரும் புதிய வாய்ப்பு. தொடருங்கள் - முன்னேற்றம் கூடுகிறது.";

