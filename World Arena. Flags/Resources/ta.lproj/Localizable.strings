"guide.friends.body" = "சுயவிவரம் அல்லது நண்பர் குறியீடு மூலம் நண்பர்களைச் சேர்க்கவும். இருவர் போட்டிக்கு அழைக்க நண்பரின் சுயவிவரத்தைத் திறக்கவும். அழைப்புகள் «சவால்கள்» பகுதியில் தோன்றும். நட்புக் கோரிக்கைகளை ஏற்கலாம் அல்லது நிராகரிக்கலாம்.";
"guide.friends.title" = "நண்பர்களுடன் விளையாடுங்கள்";
"guide.next" = "அடுத்து";
"guide.play.body" = "விளையாட்டைத் தொடங்க «விளையாடு» என்பதைத் தட்டவும்.";
"guide.play.title" = "உங்கள் அடுத்த விளையாட்டு";
"guide.replay" = "பயன்பாட்டு வழிகாட்டி";
"guide.settings.body" = "பகுதி, சிரமம் மற்றும் கேம் பயன்முறையைத் தேர்வுசெய்ய இங்கே தட்டவும்.";
"guide.settings.title" = "இதை உங்கள் விளையாட்டாக ஆக்குங்கள்";
"guide.skip" = "தவிர்";
"guide.streak.body" = "நாட்காட்டி, விளையாடிய நாட்கள் மற்றும் தொடரைப் பாதுகாக்கும் பொருட்களைப் பார்க்க உங்கள் தொடரைத் தட்டவும்.";
"guide.streak.title" = "ஒவ்வொரு நாளும் முக்கியம்";
