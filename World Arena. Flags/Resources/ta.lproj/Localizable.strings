"HELP_GAME_DUEL" = "இருவர் போட்டியில் நீங்களும் நண்பரும் ஒரே கேள்விகளுக்குப் பதிலளித்து முடிவுகளை ஒப்பிடலாம்.\n\n1. நண்பர்கள் பட்டியல், லீக் அல்லது நினைவூட்டலிலிருந்து நண்பரின் சுயவிவரத்தைத் திறக்கவும்.\n2. “இருவர் போட்டிக்கு அழைக்கவும்” என்பதைத் தட்டவும்.\n3. உறுதிசெய்ததும் இருவருக்கும் ஒரே கேள்விகள் வழங்கப்படும்.\n\nமுடிவில் யார் அதிக புள்ளிகள் பெற்றார் என்பதைப் பார்க்கலாம். இந்தப் போட்டி கற்றலை ஊக்குவிக்கும்; உங்கள் தினசரித் தொடரை மீட்டமைக்காது.";
"Как зарабатывать и тратить F-bucks?" = "F-Bucks பெறுவதும் செலவிடுவதும் எப்படி?";
"Внутриигровая валюта" = "விளையாட்டு நாணயம்";
"HELP_PROGRESS_FBUCKS" = "F-Bucks (Flags Bucks) என்பது World Arena Flags விளையாட்டின் நாணயம்.\n\nபெறும் வழிகள்:\n• தகுதியான ஆட்டத்தில் எல்லாக் கேள்விகளுக்கும் சரியாகப் பதிலளிக்கவும்.\n• தொடர்ந்து பல நாட்கள் விளையாடவும்.\n• பணிகளையும் சாதனைகளையும் முடிக்கவும்.\n\nசிறப்பு அவதார் தோற்றங்கள், பொருட்கள், அரிய அணிகலன்கள் மற்றும் காட்சி விளைவுகளை வாங்கலாம்.\n\nF-Bucks உண்மையான பணம் அல்ல. அவற்றைப் பணமாக எடுக்கவோ உண்மையான நாணயமாக மாற்றவோ முடியாது.";
"Как работают квесты и достижения?" = "பணிகளும் சாதனைகளும் எவ்வாறு செயல்படுகின்றன?";
"Месячные задания и артефакты" = "மாதாந்திரப் பணிகளும் சேகரிப்புப் பொருட்களும்";
"HELP_PROGRESS_QUESTS" = "“பணிகள்” பகுதியில் தினசரிப் பணிகள் (இருந்தால்), மாதாந்திரப் பணிகள் மற்றும் 0–40 மொத்த முன்னேற்றத்தைக் காணலாம்.\n\n1. குறிப்பிட்ட எண்ணிக்கையில் விளையாடுவது அல்லது ஒரு பகுதியின் கொடிகளை அடையாளம் காண்பது போன்ற பணிகளை முடிக்கவும்.\n2. ஒவ்வொரு பணியும் முன்னேற்றத்தையும் பரிசுகளையும் வழங்கும்.\n3. மாதாந்திர முன்னேற்றம் வண்ணத் தலைப்பில் பட்டையாகக் காட்டப்படும்.\n\nநீண்ட தினசரித் தொடர்கள், அதிக சரியான பதில்கள், லீக்குகளில் உயர்ந்த இடங்கள் போன்ற நிபந்தனைகளை நிறைவேற்றினால் சாதனைகள் திறக்கப்படும். அவை சுயவிவரத்தில் காட்டப்படும்.";

/* Help Center – notifications */
"Уведомления: какие бывают и как их настроить?" = "அறிவிப்புகள்: வகைகள் மற்றும் அவற்றை எவ்வாறு நிர்வகிப்பது?";
"Ежедневный урок, дуэли и напоминания" = "தினசரி பாடம், சண்டைகள் மற்றும் நினைவூட்டல்கள்";
"HELP_NOTIFICATIONS_TYPES" = "தினசரிப் பயிற்சி, தினசரித் தொடர் மற்றும் நண்பர் நினைவூட்டல்கள், இருவர் போட்டி அழைப்புகள் மற்றும் முடிவுகளுக்கான அறிவிப்புகளை இந்தப் பயன்பாடு வழங்குகிறது.\n\nபயன்பாட்டின் அறிவிப்பு அமைப்புகளில் தேவையான நினைவூட்டல்களைத் தேர்ந்தெடுக்கவும். World Arena Flags அறிவிப்புகளைக் காட்டலாமா என்பதை சாதன அமைப்புகள் கட்டுப்படுத்துகின்றன.\n\nதினசரி நினைவூட்டல்கள் பயிற்சியை நினைவில் வைத்திருக்க உதவும்.";

