"FACT_17_TITLE" = "Olympische Symbolik";
"FACT_17_DESC" = "Die Farben der Olympischen Ringe wurden so gewählt, dass mindestens eine Farbe auf jeder Landesflagge vorkommt.";
"FACT_18_TITLE" = "Flagge mit dem komplexesten Wappen";
"FACT_18_DESC" = "Mexikos Flagge zeigt einen Adler auf einem Kaktus mit einer Schlange – eines der detailliertesten Wappen auf Flaggen.";
"FACT_19_TITLE" = "Kopierte Flagge";
"FACT_19_DESC" = "Die Flaggen Monacos und Indonesiens sind fast identisch – rot oben, weiß unten. Der einzige Unterschied sind die Proportionen.";
"FACT_20_TITLE" = "Flagge mit 50 Sternen";
"FACT_20_DESC" = "Die US-Flagge hat 50 Sterne, einen für jeden Bundesstaat. Das Design wurde seit 1777 27-mal geändert.";
"FACT_21_TITLE" = "Nördlichste Flaggen";
"FACT_21_DESC" = "In arktischen Regionen werden nationale und regionale Flaggen mit einzigartiger Symbolik verwendet.";
"FACT_22_TITLE" = "Flagge mit Kreuz";
"FACT_22_DESC" = "29 Länder haben ein Kreuz auf ihrer Flagge, eines der beliebtesten Symbole auf Nationalflaggen.";
"FACT_23_TITLE" = "Trikoloren";
"FACT_23_DESC" = "Viele Länder nutzen ein einfaches Drei-Streifen-Design als historisch bewährte Flaggenform.";
"FACT_24_TITLE" = "Flagge mit Halbmond";
"FACT_24_DESC" = "Der Halbmond erscheint auf den Flaggen von 12 Ländern, meist muslimischen, und symbolisiert den islamischen Glauben.";
"FACT_25_TITLE" = "Sonnensymbol";
"FACT_25_DESC" = "Die Sonne ist eines der häufigsten Symbole auf Flaggen in Asien und Südamerika.";
"FACT_26_TITLE" = "Flagge mit Baum";
"FACT_26_DESC" = "Der Libanon ist das einzige Land mit einem Baum (der Libanonzeder) auf seiner Flagge, Symbol für Ewigkeit und Frieden.";
"FACT_27_TITLE" = "Schmalste Flagge";
"FACT_27_DESC" = "Katars Flagge hat das ungewöhnlichste Seitenverhältnis aller Nationalflaggen – 11:28.";
"FACT_28_TITLE" = "Komplexe Wappen";
"FACT_28_DESC" = "Wappen auf lateinamerikanischen Flaggen enthalten oft viele Details und historische Symbole.";
"FACT_29_TITLE" = "Regenbogenflagge";
"FACT_29_DESC" = "Bolivien hat zwei offizielle Flaggen – die traditionelle Trikolore und die indigene Wiphala-Regenbogenflagge.";
"FACT_30_TITLE" = "Flagge mit Gebäude";
"FACT_30_DESC" = "Kambodschas Flagge zeigt den Angkor-Wat-Tempel, die einzige Nationalflagge mit einem Gebäude.";
"FACT_31_TITLE" = "Historische Streitigkeiten";
"FACT_31_DESC" = "Das Design einiger Flaggen änderte sich durch historische und politische Auseinandersetzungen.";
"FACT_32_TITLE" = "Flagge mit Schwert";
"FACT_32_DESC" = "Sri Lankas Flagge zeigt einen Löwen mit Schwert und symbolisiert den Mut der Singhalesen.";
"FACT_33_TITLE" = "Flagge ohne Blau";
"FACT_33_DESC" = "Nur vier Länder verwenden kein Blau auf ihren Flaggen: Jamaika, Mauretanien, Sri Lanka und der Vatikan.";
"FACT_34_TITLE" = "Vögel auf Flaggen";
"FACT_34_DESC" = "Adler und andere Vögel auf Flaggen symbolisieren Stärke, Unabhängigkeit und Edelmut.";
"FACT_35_TITLE" = "Antarktis-Symbol";
"FACT_35_DESC" = "Die Antarktis hat keine offizielle Nationalflagge, es werden mehrere inoffizielle Entwürfe genutzt.";
"FACT_36_TITLE" = "Sterne auf Flaggen";
"FACT_36_DESC" = "Der Stern ist eines der verbreitetsten Symbole auf Flaggen weltweit.";
"FACT_37_TITLE" = "Ähnliche Farbschemata";
"FACT_37_DESC" = "Einige Flaggen ähneln sich in den Farben, unterscheiden sich aber in der Anordnung der Streifen und Embleme.";
"FACT_38_TITLE" = "Flaggen internationaler Verbände";
"FACT_38_DESC" = "Überstaatliche Organisationen haben ebenfalls eigene Flaggen mit gemeinsamen Werten.";
"FACT_39_TITLE" = "Insel-Symbolik";
"FACT_39_DESC" = "Flaggen von Inselstaaten zeigen oft Symbole von Ozean, Sonne und Navigation.";
"FACT_40_TITLE" = "Wandel im Lauf der Zeit";
"FACT_40_DESC" = "Einige Nationalflaggen haben sich dutzende Male mit der politischen Geschichte des Landes geändert.";
"FACT_41_TITLE" = "Sonne Nordmazedoniens";
"FACT_41_DESC" = "Die Flagge Nordmazedoniens zeigt eine Sonne mit acht Strahlen für einen Neuanfang.";
"FACT_42_TITLE" = "Holzfäller in Belize";
"FACT_42_DESC" = "Belizes Flagge gehört zu den wenigen, die Menschen zeigen: Holzfäller mit Werkzeugen.";
"FACT_43_TITLE" = "Kondor Ecuadors";
"FACT_43_DESC" = "Ecuadors Flagge zeigt den Andenkondor für Stärke und Souveränität.";
"FACT_44_TITLE" = "Zwei Flaggen Boliviens";
"FACT_44_DESC" = "Bolivien führt die Wiphala neben der Trikolore als offizielles Symbol.";
"FACT_45_TITLE" = "27 Sterne Brasiliens";
"FACT_45_DESC" = "Die brasilianische Flagge hat 27 Sterne, einen für jeden Bundesstaat und den Bundesdistrikt.";
"FACT_46_TITLE" = "Ahornblatt";
"FACT_46_DESC" = "Kanadas Flagge zeigt ein einzelnes 11-zackiges Ahornblatt, einzigartig unter Nationalflaggen.";
"FACT_47_TITLE" = "Union Jack";
"FACT_47_DESC" = "Die britische Flagge vereint die Kreuze dreier Heiliger: England, Schottland und Irland.";
"FACT_48_TITLE" = "Japans aufgehende Sonne";
"FACT_48_DESC" = "Der rote Kreis auf Weiß steht für die aufgehende Sonne und wird in Japan seit dem 7. Jahrhundert verwendet.";
"FACT_49_TITLE" = "Ashoka-Chakra";
"FACT_49_DESC" = "Indiens Flagge zeigt ein 24-speichiges Rad als Symbol für Gesetz und Bewegung.";
"FACT_50_TITLE" = "Südliches Kreuz Australiens";
"FACT_50_DESC" = "Australiens Flagge zeigt das Kreuz des Südens, nur auf der Südhalbkugel sichtbar.";
"FACT_51_TITLE" = "Südliches Kreuz Neuseelands";
"FACT_51_DESC" = "Neuseelands Flagge zeigt ebenfalls das Kreuz des Südens, aber mit roten, weiß gesäumten Sternen.";
"FACT_52_TITLE" = "Taegeuk Südkoreas";
"FACT_52_DESC" = "Südkoreas Flagge zeigt das traditionelle Taegeuk (Yin-Yang) und Trigramme.";
"FACT_53_TITLE" = "Armillarsphäre Portugals";
"FACT_53_DESC" = "Portugals Flagge zeigt eine Armillarsphäre, ein antikes Navigationsinstrument.";
"FACT_54_TITLE" = "Doppelköpfiger Adler Albaniens";
"FACT_54_DESC" = "Albaniens Flagge zeigt einen schwarzen Doppeladler als Symbol der Souveränität.";
"FACT_55_TITLE" = "Schild Kenias";
"FACT_55_DESC" = "Kenyas Flagge zeigt einen Massai-Schild und gekreuzte Speere.";
"FACT_56_TITLE" = "Drache Wales";
"FACT_56_DESC" = "Der rote Drache auf der Flagge Wales ist eines der ältesten nationalen Symbole der Welt.";
"FACT_57_TITLE" = "Andreaskreuz";
"FACT_57_DESC" = "Schottlands Flagge ist ein weißes Schrägkreuz auf Blau, das Kreuz des heiligen Andreas.";
"FACT_58_TITLE" = "Kreis Grönlands";
"FACT_58_DESC" = "Grönlands Flagge hat einen rot-weißen Kreis für die Sonne über dem Eis.";
"FACT_59_TITLE" = "Panafrikanische Farben";
"FACT_59_DESC" = "Grün, Gelb und Rot werden oft als panafrikanische Farben bezeichnet und erscheinen auf vielen afrikanischen Flaggen.";
"FACT_60_TITLE" = "Nordische Kreuze";
"FACT_60_DESC" = "Fünf Länder nutzen das Nordische Kreuz: Dänemark, Norwegen, Schweden, Finnland und Island.";
"FACT_61_TITLE" = "Französische Trikolore";
"FACT_61_DESC" = "Die französische Blau-Weiß-Rot-Trikolore wurde Vorbild für viele revolutionäre und nationale Flaggen.";
"FACT_62_TITLE" = "UN-Flagge";
"FACT_62_DESC" = "Die UN-Flagge zeigt die Welt umgeben von Olivenzweigen auf blauem Grund.";
"FACT_63_TITLE" = "EU-Flagge";
"FACT_63_DESC" = "Zwölf goldene Sterne im Kreis auf Blau symbolisieren die Einheit der Europäischen Union.";
"FACT_64_TITLE" = "Olympische Flagge";
"FACT_64_DESC" = "Die fünf Ringe auf Weiß stehen für die fünf bewohnten Kontinente und den globalen Charakter der Spiele.";
"FACT_65_TITLE" = "Quadratische Flagge des Vatikans";
"FACT_65_DESC" = "Der Vatikan hat wie die Schweiz eine quadratische Nationalflagge.";
"FACT_66_TITLE" = "12 Strahlen Naurus";
"FACT_66_DESC" = "Naurus Flagge hat einen 12-strahligen Stern für die zwölf Stämme der Insel.";
"FACT_67_TITLE" = "Teppichmuster Turkmenistans";
"FACT_67_DESC" = "Turkmenistans Flagge zeigt traditionelle Teppichmuster am Fahnenmast.";
"FACT_68_TITLE" = "Moschee auf Afghanistans Flagge";
"FACT_68_DESC" = "Afghanistans Flagge hat in verschiedenen Epochen eine Moschee gezeigt.";

