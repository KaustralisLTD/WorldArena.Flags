/* 68 interesting facts */
"FACT_01_TITLE" = "Прапор із легендою";
"FACT_01_DESC" = "Легенда пов’язує появу данського прапора з битвою 1219 року.";
"FACT_02_TITLE" = "Квадратні національні прапори";
"FACT_02_DESC" = "Швейцарія та Ватикан мають квадратні національні прапори.";
"FACT_03_TITLE" = "Непрямокутний прапор";
"FACT_03_DESC" = "Непал має єдиний національний прапор у світі, який не є прямокутним.";
"FACT_04_TITLE" = "Без червоного, білого та синього";
"FACT_04_DESC" = "Ямайка — єдина країна з прапором без червоного, білого та синього кольорів.";
"FACT_05_TITLE" = "Прапор, який ніколи не приспускають";
"FACT_05_DESC" = "Прапор Саудівської Аравії ніколи не приспускають до половини щогли через священний напис.";
"FACT_06_TITLE" = "Молодий національний прапор";
"FACT_06_DESC" = "Південний Судан використовує цей державний прапор зі здобуття незалежності у 2011 році.";
"FACT_07_TITLE" = "Прапор з АК-47";
"FACT_07_DESC" = "Мозамбік — єдина країна в світі, на прапорі якої зображено сучасну зброю — автомат Калашникова.";
"FACT_08_TITLE" = "Майже однакові прапори";
"FACT_08_DESC" = "Прапори Румунії та Чаду дуже схожі; їх зазвичай відрізняють за відтінком синього.";
"FACT_09_TITLE" = "Символіка України";
"FACT_09_DESC" = "Синьо-жовтий прапор України традиційно тлумачать як небо над пшеничним полем.";
"FACT_10_TITLE" = "Найпростіший прапор";
"FACT_10_DESC" = "Прапор Лівії з 1977 по 2011 рік складався лише з зеленого кольору без символів чи візерунків.";
"FACT_11_TITLE" = "Прапор з картою";
"FACT_11_DESC" = "На прапорі Кіпру зображено контур острова — рідкісний випадок для державних прапорів.";
"FACT_12_TITLE" = "Прапор з Біблією";
"FACT_12_DESC" = "На прапорі Домініканської Республіки зображено відкриту Біблію, що робить його єдиним національним прапором з релігійною книгою.";
"FACT_13_TITLE" = "Червоний на національних прапорах";
"FACT_13_DESC" = "Червоний є на багатьох національних прапорах, зокрема Канади, Японії та Швейцарії.";
"FACT_14_TITLE" = "Прапор з текстом";
"FACT_14_DESC" = "Текст на національному прапорі зустрічається рідко; один із відомих прикладів — Саудівська Аравія.";
"FACT_15_TITLE" = "Етикет використання прапора";
"FACT_15_DESC" = "У багатьох країнах діють суворі правила поводження з державним прапором.";
"FACT_16_TITLE" = "Прапор з різними сторонами";
"FACT_16_DESC" = "Парагвай має єдиний у світі національний прапор з різними зображеннями на лицьовій та зворотній сторонах.";
"FACT_17_TITLE" = "Олімпійська символіка";
"FACT_17_DESC" = "П’ять олімпійських кілець і біле тло утворюють шість кольорів, обраних для представлення прапорів країн світу.";
"FACT_18_TITLE" = "Герб Мексики";
"FACT_18_DESC" = "На прапорі Мексики зображений орел на кактусі зі змією.";
"FACT_19_TITLE" = "Схожі червоно-білі прапори";
"FACT_19_DESC" = "На прапорах Монако та Індонезії червона смуга розташована над білою, але пропорції прапорів відрізняються.";
"FACT_20_TITLE" = "Прапор з 50 зірками";
"FACT_20_DESC" = "На прапорі США 50 зірок — по одній на кожен штат.";
"FACT_21_TITLE" = "Найпівнічніші прапори";
"FACT_21_DESC" = "В арктичних регіонах використовують як державні, так і регіональні прапори з унікальною символікою.";
"FACT_22_TITLE" = "Прапор з хрестом";
"FACT_22_DESC" = "Хрест зображений на багатьох національних прапорах, зокрема Данії, Фінляндії та Швейцарії.";
"FACT_23_TITLE" = "Триколори";
"FACT_23_DESC" = "Багато країн використовують простий трисмуговий дизайн як історично стійку форму прапора.";
"FACT_24_TITLE" = "Прапор із півмісяцем";
"FACT_24_DESC" = "Півмісяць зображений на прапорах низки країн, зокрема Туреччини, Пакистану та Тунісу.";
"FACT_25_TITLE" = "Символ сонця";
"FACT_25_DESC" = "Сонце — один із найпоширеніших символів на прапорах Азії та Південної Америки.";
"FACT_26_TITLE" = "Прапор з деревом";
"FACT_26_DESC" = "На національному прапорі Лівану зображений кедр.";
"FACT_27_TITLE" = "Пропорції прапора Катару";
"FACT_27_DESC" = "Співвідношення висоти й ширини національного прапора Катару — 11:28.";
"FACT_28_TITLE" = "Складні герби";
"FACT_28_DESC" = "Герби на прапорах Латинської Америки часто включають багато деталей та історичних символів.";
"FACT_29_TITLE" = "Прапор-веселка";
"FACT_29_DESC" = "Болівія має два офіційні прапори — традиційний триколор та веселковий прапор корінних народів Віпала.";
"FACT_30_TITLE" = "Прапор із будівлею";
"FACT_30_DESC" = "На національному прапорі Камбоджі зображений храм Ангкор-Ват.";
"FACT_31_TITLE" = "Історичні суперечки";
"FACT_31_DESC" = "Дизайн деяких прапорів змінювався через історичні та політичні суперечки між країнами.";
"FACT_32_TITLE" = "Прапор з мечем";
"FACT_32_DESC" = "На прапорі Шрі-Ланки зображено лева з мечем — символ мужності сингальського народу.";
"FACT_33_TITLE" = "Прапор без синього";
"FACT_33_DESC" = "На деяких національних прапорах немає синього кольору, наприклад на прапорах Ямайки, Японії та Швейцарії.";
"FACT_34_TITLE" = "Птахи на прапорах";
"FACT_34_DESC" = "Орел та інші птахи на прапорах символізують силу, незалежність та висоту духу.";
"FACT_35_TITLE" = "Антарктичний символ";
"FACT_35_DESC" = "У Антарктиди немає офіційного державного прапора, але використовується кілька неофіційних варіантів.";
"FACT_36_TITLE" = "Зірки на прапорах";
"FACT_36_DESC" = "Зірка — один із найпоширеніших символів на прапорах у всьому світі.";
"FACT_37_TITLE" = "Схожі кольорові схеми";
"FACT_37_DESC" = "Деякі прапори схожі за кольорами, але відрізняються порядком смуг та емблемами.";
"FACT_38_TITLE" = "Прапори міжнародних союзів";
"FACT_38_DESC" = "Наднаціональні об'єднання також мають свої прапори, які відображають спільні цінності учасників.";
"FACT_39_TITLE" = "Острівна символіка";
"FACT_39_DESC" = "На прапорах острівних держав часто присутні символи океану, сонця та навігації.";
"FACT_40_TITLE" = "Зміни в часі";
"FACT_40_DESC" = "Деякі національні прапори змінювалися десятки разів разом з політичною історією країни.";
"FACT_41_TITLE" = "Сонце Північної Македонії";
"FACT_41_DESC" = "На прапорі Північної Македонії зображено сонце з вісьмома променями — символ нового початку.";
"FACT_42_TITLE" = "Люди на прапорі Белізу";
"FACT_42_DESC" = "Прапор Белізу — один з небагатьох, на яких зображено людей: лісоруби з інструментами.";
"FACT_43_TITLE" = "Кондор Еквадору";
"FACT_43_DESC" = "На прапорі Еквадору зображено андійського кондора — символ сили та суверенітету.";
"FACT_44_TITLE" = "Два прапори Болівії";
"FACT_44_DESC" = "Болівія визнає Віпалу нарівні з триколором офіційним символом.";
"FACT_45_TITLE" = "27 зірок Бразилії";
"FACT_45_DESC" = "На прапорі Бразилії 27 зірок: по одній на кожний штат та федеральний округ.";
"FACT_46_TITLE" = "Кленовий лист";
"FACT_46_DESC" = "На прапорі Канади зображено червоний кленовий лист з 11 вершинами на білому квадраті.";
"FACT_47_TITLE" = "Юніон Джек";
"FACT_47_DESC" = "Прапор Великої Британії поєднує хрести святого Георгія, святого Андрія та святого Патрика.";
"FACT_48_TITLE" = "Східне сонце Японії";
"FACT_48_DESC" = "На національному прапорі Японії червоне коло на білому тлі символізує сонце.";
"FACT_49_TITLE" = "Ашока Чакра";
"FACT_49_DESC" = "На прапорі Індії зображено колесо з 24 спицями — символ закону та руху.";
"FACT_50_TITLE" = "Південний Хрест Австралії";
"FACT_50_DESC" = "П’ять зірок на прапорі Австралії зображують сузір’я Південного Хреста.";
"FACT_51_TITLE" = "Південний Хрест Нової Зеландії";
"FACT_51_DESC" = "Прапор Нової Зеландії також має Південний Хрест, але з червоними зірками з білою обводкою.";
"FACT_52_TITLE" = "Інь і ян Південної Кореї";
"FACT_52_DESC" = "На прапорі Південної Кореї зображено традиційний символ тегик (інь-ян) та триграми.";
"FACT_53_TITLE" = "Армілярна сфера Португалії";
"FACT_53_DESC" = "На прапорі Португалії зображено армілярну сферу — старовинний навігаційний інструмент.";
"FACT_54_TITLE" = "Двоголовий орел Албанії";
"FACT_54_DESC" = "На прапорі Албанії зображено чорного двоголового орла — символ суверенітету.";
"FACT_55_TITLE" = "Щит Кенії";
"FACT_55_DESC" = "На прапорі Кенії зображено щит масаїв і схрещені списи.";
"FACT_56_TITLE" = "Дракон Уельсу";
"FACT_56_DESC" = "На прапорі Уельсу зображено червоного дракона на біло-зеленому тлі. Цей варіант офіційно визнано у 1959 році.";
"FACT_57_TITLE" = "Хрест святого Андрія";
"FACT_57_DESC" = "Шотландський прапор — білий діагональний хрест на синьому, символ святого Андрія.";
"FACT_58_TITLE" = "Коло Гренландії";
"FACT_58_DESC" = "Червоно-біле коло на прапорі Гренландії символізує сонце над кригою.";
"FACT_59_TITLE" = "Панафриканські кольори";
"FACT_59_DESC" = "Зелений, жовтий і червоний часто називають панафриканськими кольорами. Вони трапляються на багатьох прапорах Африки.";
"FACT_60_TITLE" = "Скандинавські хрести";
"FACT_60_DESC" = "П'ять країн використовують скандинавський хрест: Данія, Норвегія, Швеція, Фінляндія та Ісландія.";
"FACT_61_TITLE" = "Французький триколор";
"FACT_61_DESC" = "Французький синьо-біло-червоний прапор став зразком для багатьох революційних та національних прапорів.";
"FACT_62_TITLE" = "Прапор ООН";
"FACT_62_DESC" = "На прапорі ООН зображено карту світу в оточенні оливкових гілок на блакитному тлі.";
"FACT_63_TITLE" = "Прапор ЄС";
"FACT_63_DESC" = "12 золотих зірок по колу на синьому — символ єдності Європейського союзу.";
"FACT_64_TITLE" = "Олімпійський прапор";
"FACT_64_DESC" = "П’ять олімпійських кілець на білому тлі символізують єдність п’яти континентів і спортсменів з усього світу.";
"FACT_65_TITLE" = "Квадратний прапор Ватикану";
"FACT_65_DESC" = "Ватикан нарівні зі Швейцарією має квадратний національний прапор.";
"FACT_66_TITLE" = "12 променів Науру";
"FACT_66_DESC" = "На прапорі Науру зображено 12-променеву зірку за кількістю племен острова.";
"FACT_67_TITLE" = "Килимові візерунки Туркменістану";
"FACT_67_DESC" = "На прапорі Туркменістану вздовж древка зображено килимові візерунки.";
"FACT_68_TITLE" = "Мечеть на прапорі Афганістану";
"FACT_68_DESC" = "На прапорі Афганістану в різні періоди зображалася мечеть.";

