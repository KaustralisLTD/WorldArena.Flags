/* 68 interesting facts */
"FACT_01_TITLE" = "Flaga z legendą";
"FACT_01_DESC" = "Legenda wiąże duńską flagę z bitwą z 1219 roku.";
"FACT_02_TITLE" = "Kwadratowe flagi narodowe";
"FACT_02_DESC" = "Szwajcaria i Watykan mają kwadratowe flagi narodowe.";
"FACT_03_TITLE" = "Flaga nieprostokątna";
"FACT_03_DESC" = "Nepal ma jedyną na świecie flagę narodową, która nie jest prostokątna.";
"FACT_04_TITLE" = "Bez czerwieni, bieli ani niebieskiego";
"FACT_04_DESC" = "Jamaika to jedyny kraj z flagą bez czerwieni, bieli i niebieskiego.";
"FACT_05_TITLE" = "Flaga nigdy nieopuszczana do połowy masztu";
"FACT_05_DESC" = "Flaga Arabii Saudyjskiej nigdy nie jest opuszczana do połowy masztu z powodu świętego tekstu.";
"FACT_06_TITLE" = "Młoda flaga narodowa";
"FACT_06_DESC" = "Sudan Południowy używa tej flagi narodowej od uzyskania niepodległości w 2011 roku.";
"FACT_07_TITLE" = "Flaga z AK-47";
"FACT_07_DESC" = "Mozambik to jedyny kraj, na którego fladze widnieje nowoczesna broń – karabin Kałasznikowa.";
"FACT_08_TITLE" = "Prawie identyczne flagi";
"FACT_08_DESC" = "Flagi Rumunii i Czadu są bardzo podobne; rozróżnia je zwykle odcień niebieskiego.";
"FACT_09_TITLE" = "Symbolika Ukrainy";
"FACT_09_DESC" = "Niebiesko-żółta flaga Ukrainy jest tradycyjnie interpretowana jako niebo nad polem zboża.";
"FACT_10_TITLE" = "Najprostsza flaga";
"FACT_10_DESC" = "Flaga Libii w latach 1977–2011 była w całości zielona, bez symboli ani wzorów.";
"FACT_11_TITLE" = "Flaga z mapą";
"FACT_11_DESC" = "Flaga Cypru pokazuje zarys wyspy – rzadki przypadek wśród flag narodowych.";
"FACT_12_TITLE" = "Flaga z Biblią";
"FACT_12_DESC" = "Flaga Dominikany pokazuje otwartą Biblię, to jedyna flaga narodowa z księgą religijną.";
"FACT_13_TITLE" = "Czerwień na flagach narodowych";
"FACT_13_DESC" = "Czerwień występuje na wielu flagach narodowych, między innymi Kanady, Japonii i Szwajcarii.";
"FACT_14_TITLE" = "Flaga z tekstem";
"FACT_14_DESC" = "Tekst na flagach narodowych jest rzadki; znanym przykładem jest Arabia Saudyjska.";
"FACT_15_TITLE" = "Etykieta flag";
"FACT_15_DESC" = "W wielu krajach obowiązują surowe zasady obchodzenia się z flagą narodową.";
"FACT_16_TITLE" = "Flaga z dwiema różnymi stronami";
"FACT_16_DESC" = "Paragwaj ma jedyną na świecie flagę narodową z różnymi wzorami na awersie i rewersie.";
"FACT_17_TITLE" = "Symbolika olimpijska";
"FACT_17_DESC" = "Pięć kół olimpijskich i ich białe tło wykorzystują sześć kolorów, wybranych jako reprezentacja flag państw całego świata.";
"FACT_18_TITLE" = "Herb Meksyku";
"FACT_18_DESC" = "Flaga Meksyku przedstawia orła na kaktusie trzymającego węża.";
"FACT_19_TITLE" = "Podobne czerwono-białe flagi";
"FACT_19_DESC" = "Monako i Indonezja mają na flagach czerwień nad bielą, ale flagi różnią się proporcjami.";
"FACT_20_TITLE" = "Flaga z 50 gwiazdami";
"FACT_20_DESC" = "Flaga Stanów Zjednoczonych ma 50 gwiazd, po jednej na każdy stan.";
"FACT_21_TITLE" = "Flagi najbardziej na północ";
"FACT_21_DESC" = "Regiony arktyczne używają flag narodowych i regionalnych z unikalną symboliką.";
"FACT_22_TITLE" = "Flaga z krzyżem";
"FACT_22_DESC" = "Krzyż występuje na wielu flagach narodowych, między innymi Danii, Finlandii i Szwajcarii.";
"FACT_23_TITLE" = "Trójkolorowe";
"FACT_23_DESC" = "Wiele krajów używa prostego układu trzech pasów jako historycznie trwałej formy flagi.";
"FACT_24_TITLE" = "Flaga z półksiężycem";
"FACT_24_DESC" = "Półksiężyc występuje na kilku flagach narodowych, między innymi Turcji, Pakistanu i Tunezji.";
"FACT_25_TITLE" = "Symbol słońca";
"FACT_25_DESC" = "Słońce to jeden z najczęstszych symboli na flagach w Azji i Ameryce Południowej.";
"FACT_26_TITLE" = "Flaga z drzewem";
"FACT_26_DESC" = "Flaga narodowa Libanu przedstawia cedr.";
"FACT_27_TITLE" = "Proporcje flagi Kataru";
"FACT_27_DESC" = "Flaga narodowa Kataru ma stosunek wysokości do szerokości 11:28.";
"FACT_28_TITLE" = "Złożone herby";
"FACT_28_DESC" = "Herby na flagach Ameryki Łacińskiej często zawierają wiele detali i symboli historycznych.";
"FACT_29_TITLE" = "Flaga tęczowa";
"FACT_29_DESC" = "Boliwia ma dwie oficjalne flagi: tradycyjną trójkolorową oraz rdzenną Wiphalę.";
"FACT_30_TITLE" = "Flaga z budynkiem";
"FACT_30_DESC" = "Flaga narodowa Kambodży przedstawia świątynię Angkor Wat.";
"FACT_31_TITLE" = "Spory historyczne";
"FACT_31_DESC" = "Wygląd niektórych flag zmieniał się z powodu sporów historycznych i politycznych.";
"FACT_32_TITLE" = "Flaga z mieczem";
"FACT_32_DESC" = "Flaga Sri Lanki pokazuje lwa z mieczem, symbolizując odwagę Syngalezów.";
"FACT_33_TITLE" = "Flaga bez niebieskiego";
"FACT_33_DESC" = "Niektóre flagi narodowe nie zawierają niebieskiego, między innymi flagi Jamajki, Japonii i Szwajcarii.";
"FACT_34_TITLE" = "Ptaki na flagach";
"FACT_34_DESC" = "Orzeł i inne ptaki na flagach symbolizują siłę, niezależność i szlachetność.";
"FACT_35_TITLE" = "Symbol Antarktydy";
"FACT_35_DESC" = "Antarktyda nie ma oficjalnej flagi narodowej, używane są różne nieoficjalne wersje.";
"FACT_36_TITLE" = "Gwiazdy na flagach";
"FACT_36_DESC" = "Gwiazda to jeden z najczęstszych symboli na flagach świata.";
"FACT_37_TITLE" = "Podobne schematy kolorów";
"FACT_37_DESC" = "Niektóre flagi są podobne kolorystycznie, ale różnią się układem pasów i emblematów.";
"FACT_38_TITLE" = "Flagi organizacji międzynarodowych";
"FACT_38_DESC" = "Organizacje ponadnarodowe też mają flagi odzwierciedlające wspólne wartości.";
"FACT_39_TITLE" = "Symbolika wyspiarska";
"FACT_39_DESC" = "Flagi państw wyspiarskich często pokazują ocean, słońce i nawigację.";
"FACT_40_TITLE" = "Zmiany w czasie";
"FACT_40_DESC" = "Niektóre flagi narodowe zmieniały się dziesiątki razy wraz z historią polityczną kraju.";
"FACT_41_TITLE" = "Słońce Macedonii Północnej";
"FACT_41_DESC" = "Flaga Macedonii Północnej ma słońce z ośmioma promieniami na nowy początek.";
"FACT_42_TITLE" = "Drwale z Belize";
"FACT_42_DESC" = "Flaga Belize należy do nielicznych z postaciami ludzi: drwale z narzędziami.";
"FACT_43_TITLE" = "Kondor Ekwadoru";
"FACT_43_DESC" = "Flaga Ekwadoru zawiera kondora andyjskiego jako symbol siły i suwerenności.";
"FACT_44_TITLE" = "Dwie flagi Boliwii";
"FACT_44_DESC" = "Boliwia uznaje Wiphalę obok trójkoloru za symbol oficjalny.";
"FACT_45_TITLE" = "27 gwiazd Brazylii";
"FACT_45_DESC" = "Flaga Brazylii ma 27 gwiazd, po jednej na stan i dystrykt federalny.";
"FACT_46_TITLE" = "Liść klonowy";
"FACT_46_DESC" = "Flaga Kanady przedstawia czerwony liść klonu o jedenastu wierzchołkach na białym kwadracie.";
"FACT_47_TITLE" = "Union Jack";
"FACT_47_DESC" = "Flaga Zjednoczonego Królestwa łączy krzyże świętych Jerzego, Andrzeja i Patryka.";
"FACT_48_TITLE" = "Wschodzące słońce Japonii";
"FACT_48_DESC" = "Flaga narodowa Japonii przedstawia czerwone koło symbolizujące słońce na białym tle.";
"FACT_49_TITLE" = "Ashoka Chakra";
"FACT_49_DESC" = "Flaga Indii ma koło z 24 szprychami, symbol prawa i ruchu.";
"FACT_50_TITLE" = "Krzyż Południa Australii";
"FACT_50_DESC" = "Pięć gwiazd na fladze Australii przedstawia gwiazdozbiór Krzyża Południa.";
"FACT_51_TITLE" = "Krzyż Południa Nowej Zelandii";
"FACT_51_DESC" = "Flaga Nowej Zelandii też ma Krzyż Południa, z czerwonymi gwiazdami w białej obwódce.";
"FACT_52_TITLE" = "Taegeuk Korei Południowej";
"FACT_52_DESC" = "Flaga Korei Południowej ma tradycyjny taegeuk (yin-yang) i trigramy.";
"FACT_53_TITLE" = "Sfera armilarna Portugalii";
"FACT_53_DESC" = "Flaga Portugalii ma sferę armilarną, starożytne narzędzie nawigacyjne.";
"FACT_54_TITLE" = "Orzeł dwugłowy Albanii";
"FACT_54_DESC" = "Flaga Albanii pokazuje czarnego orła dwugłowego, symbol suwerenności.";
"FACT_55_TITLE" = "Tarcza Kenii";
"FACT_55_DESC" = "Flaga Kenii ma tarczę Masajów i skrzyżowane włócznie.";
"FACT_56_TITLE" = "Smok Walii";
"FACT_56_DESC" = "Flaga Walii przedstawia czerwonego smoka na biało-zielonym tle. Ten wzór został oficjalnie uznany w 1959 roku.";
"FACT_57_TITLE" = "Krzyż św. Andrzeja";
"FACT_57_DESC" = "Flaga Szkocji to biały krzyż ukośny na niebieskim, krzyż św. Andrzeja.";
"FACT_58_TITLE" = "Koło Grenlandii";
"FACT_58_DESC" = "Flaga Grenlandii ma czerwono-białe koło oznaczające słońce nad lodem.";
"FACT_59_TITLE" = "Kolory panafrykańskie";
"FACT_59_DESC" = "Zielony, żółty i czerwony to tzw. kolory panafrykańskie na wielu flagach afrykańskich.";
"FACT_60_TITLE" = "Krzyże nordyckie";
"FACT_60_DESC" = "Pięć krajów używa krzyża nordyckiego: Dania, Norwegia, Szwecja, Finlandia i Islandia.";
"FACT_61_TITLE" = "Trikolor francuski";
"FACT_61_DESC" = "Francuski niebiesko-biało-czerwony trikolor był wzorem dla wielu flag rewolucyjnych i narodowych.";
"FACT_62_TITLE" = "Flaga ONZ";
"FACT_62_DESC" = "Flaga ONZ pokazuje świat w otoczeniu gałązek oliwnych na niebieskim tle.";
"FACT_63_TITLE" = "Flaga UE";
"FACT_63_DESC" = "Dwanaście złotych gwiazd w kole na niebieskim symbolizuje jedność Unii Europejskiej.";
"FACT_64_TITLE" = "Flaga olimpijska";
"FACT_64_DESC" = "Pięć kół olimpijskich na białym tle symbolizuje jedność pięciu kontynentów i sportowców z całego świata.";
"FACT_65_TITLE" = "Kwadratowa flaga Watykanu";
"FACT_65_DESC" = "Watykan ma kwadratową flagę narodową jak Szwajcaria.";
"FACT_66_TITLE" = "12 ramion gwiazdy Nauru";
"FACT_66_DESC" = "Flaga Nauru ma 12-ramienną gwiazdę dla 12 plemion wyspy.";
"FACT_67_TITLE" = "Wzory dywanów Turkmenistanu";
"FACT_67_DESC" = "Flaga Turkmenistanu ma wzory dywanów wzdłuż drzewca.";
"FACT_68_TITLE" = "Meczet na fladze Afganistanu";
"FACT_68_DESC" = "Flaga Afganistanu przedstawiała meczet w różnych okresach.";

