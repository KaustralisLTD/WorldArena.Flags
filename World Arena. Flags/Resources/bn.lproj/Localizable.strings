"FACT_48_TITLE" = "জাপানের উদীয়মান সূর্য";
"FACT_48_DESC" = "সাদা রঙের লাল বৃত্ত উদীয়মান সূর্যের প্রতিনিধিত্ব করে এবং 7 ম শতাব্দী থেকে জাপানের পতাকায় ব্যবহৃত হয়ে আসছে।";
"FACT_49_TITLE" = "অশোক চক্র";
"FACT_49_DESC" = "ভারতের পতাকায় একটি 24-স্পোক চাকা রয়েছে, যা আইন ও গতির প্রতীক।";
"FACT_50_TITLE" = "অস্ট্রেলিয়ার সাউদার্ন ক্রস";
"FACT_50_DESC" = "অস্ট্রেলিয়ার পতাকা সাউদার্ন ক্রস নক্ষত্রমণ্ডল দেখায়, শুধুমাত্র দক্ষিণ গোলার্ধে দৃশ্যমান।";
"FACT_51_TITLE" = "নিউজিল্যান্ডের সাউদার্ন ক্রস";
"FACT_51_DESC" = "নিউজিল্যান্ডের পতাকায় সাউদার্ন ক্রসও রয়েছে, তবে সাদা রঙের ধারে লাল তারা।";
"FACT_52_TITLE" = "দক্ষিণ কোরিয়ার তাইগেউক";
"FACT_52_DESC" = "দক্ষিণ কোরিয়ার পতাকায় ঐতিহ্যবাহী টেগেউক (ইং-ইয়াং) প্রতীক এবং ট্রিগ্রাম রয়েছে।";
"FACT_53_TITLE" = "পর্তুগালের আর্মিলারি গোলক";
"FACT_53_DESC" = "পর্তুগালের পতাকায় একটি আর্মিলারি গোলক, একটি প্রাচীন ন্যাভিগেশন যন্ত্র রয়েছে।";
"FACT_54_TITLE" = "আলবেনিয়ার দুই মাথাওয়ালা ঈগল";
"FACT_54_DESC" = "আলবেনিয়ার পতাকায় একটি কালো দুই মাথাওয়ালা ঈগল, সার্বভৌমত্বের প্রতীক দেখায়।";
"FACT_55_TITLE" = "কেনিয়ার ঢাল";
"FACT_55_DESC" = "কেনিয়ার পতাকায় একটি মাসাই ঢাল এবং ক্রস করা বর্শা রয়েছে।";
"FACT_56_TITLE" = "ওয়েলসের ড্রাগন";
"FACT_56_DESC" = "ওয়েলসের পতাকায় লাল ড্রাগন বিশ্বের প্রাচীনতম জাতীয় প্রতীকগুলির মধ্যে একটি।";
"FACT_57_TITLE" = "সেন্ট অ্যান্ড্রু ক্রস";
"FACT_57_DESC" = "স্কটল্যান্ডের পতাকা হল নীল রঙের একটি সাদা তির্যক ক্রস, সেন্ট অ্যান্ড্রুর ক্রস।";
"FACT_58_TITLE" = "গ্রীনল্যান্ডের বৃত্ত";
"FACT_58_DESC" = "গ্রিনল্যান্ডের পতাকায় একটি লাল-সাদা বৃত্ত রয়েছে যা বরফের উপর সূর্যের প্রতিনিধিত্ব করে।";
"FACT_59_TITLE" = "প্যান-আফ্রিকান রং";
"FACT_59_DESC" = "সবুজ, হলুদ এবং লালকে প্রায়শই প্যান-আফ্রিকান রঙ বলা হয় এবং অনেক আফ্রিকান পতাকায় প্রদর্শিত হয়।";
"FACT_60_TITLE" = "নর্ডিক ক্রস";
"FACT_60_DESC" = "পাঁচটি দেশ নর্ডিক ক্রস ব্যবহার করে: ডেনমার্ক, নরওয়ে, সুইডেন, ফিনল্যান্ড এবং আইসল্যান্ড।";
"FACT_61_TITLE" = "ফরাসি তিরঙ্গা";
"FACT_61_DESC" = "ফরাসি নীল-সাদা-লাল তেরঙা অনেক বিপ্লবী এবং জাতীয় পতাকার মডেল হয়ে উঠেছে।";
"FACT_62_TITLE" = "জাতিসংঘের পতাকা";
"FACT_62_DESC" = "জাতিসংঘের পতাকা একটি নীল পটভূমিতে জলপাই শাখা দ্বারা বেষ্টিত পৃথিবী দেখায়।";
"FACT_63_TITLE" = "ইইউ পতাকা";
"FACT_63_DESC" = "নীল রঙের একটি বৃত্তে বারোটি সোনালী তারা ইউরোপীয় ইউনিয়নের ঐক্যের প্রতীক।";
"FACT_64_TITLE" = "অলিম্পিক পতাকা";
"FACT_64_DESC" = "সাদা রঙের পাঁচটি রিং পাঁচটি অধ্যুষিত মহাদেশ এবং গেমসের বৈশ্বিক প্রকৃতির প্রতিনিধিত্ব করে।";
"FACT_65_TITLE" = "ভ্যাটিকান স্কোয়ার";
"FACT_65_DESC" = "ভ্যাটিকানের সুইজারল্যান্ডের মতো বর্গাকার জাতীয় পতাকা রয়েছে।";
"FACT_66_TITLE" = "নাউরু ১২ পয়েন্ট";
"FACT_66_DESC" = "নাউরু পতাকায় 12টি উপজাতির জন্য একটি 12-পয়েন্টেড তারকা রয়েছে।";
"FACT_67_TITLE" = "তুর্কমেনিস্তানের কার্পেট";
"FACT_67_DESC" = "তুর্কমেনিস্তানের পতাকা উত্তোলনের পাশে কার্পেটের নিদর্শন রয়েছে।";
"FACT_68_TITLE" = "আফগানিস্তানের মসজিদ";
"FACT_68_DESC" = "আফগানিস্তানের পতাকার নকশায় একটি মসজিদ রয়েছে।";

