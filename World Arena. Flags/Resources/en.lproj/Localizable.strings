/* 68 interesting facts */
"FACT_01_TITLE" = "Oldest continuously used flag";
"FACT_01_DESC" = "Denmark's Dannebrog is considered the oldest national flag in continuous use since 1219.";
"FACT_02_TITLE" = "Only square national flag";
"FACT_02_DESC" = "Switzerland has the only square national flag in the world. The Vatican also has a square flag but is a city-state.";
"FACT_03_TITLE" = "Non-rectangular flag";
"FACT_03_DESC" = "Nepal has the only national flag in the world that is not rectangular.";
"FACT_04_TITLE" = "No red, white or blue";
"FACT_04_DESC" = "Jamaica is the only country with a flag without red, white or blue.";
"FACT_05_TITLE" = "Flag that is never lowered";
"FACT_05_DESC" = "Saudi Arabia's flag is never flown at half-mast because of the sacred text on it.";
"FACT_06_TITLE" = "Young national flag";
"FACT_06_DESC" = "South Sudan's flag was adopted in 2011 after independence.";
"FACT_07_TITLE" = "Flag with AK-47";
"FACT_07_DESC" = "Mozambique is the only country whose flag features a modern weapon—the Kalashnikov rifle.";
"FACT_08_TITLE" = "Almost identical flags";
"FACT_08_DESC" = "The flags of Romania and Chad are very similar; they are usually distinguished by the shade of blue.";
"FACT_09_TITLE" = "Ukraine's symbolism";
"FACT_09_DESC" = "Ukraine's blue and yellow flag is traditionally interpreted as the sky over a wheat field.";
"FACT_10_TITLE" = "Simplest flag";
"FACT_10_DESC" = "Libya's flag from 1977 to 2011 was solid green with no symbols or patterns.";
"FACT_11_TITLE" = "Flag with a map";
"FACT_11_DESC" = "Cyprus's flag shows the outline of the island—a rare case among national flags.";
"FACT_12_TITLE" = "Flag with a Bible";
"FACT_12_DESC" = "The Dominican Republic's flag shows an open Bible, making it the only national flag with a religious book.";
"FACT_13_TITLE" = "Most popular colour";
"FACT_13_DESC" = "Red is the most common colour on national flags worldwide.";
"FACT_14_TITLE" = "Flag with text";
"FACT_14_DESC" = "Text on national flags is rare; one well-known example is Saudi Arabia.";
"FACT_15_TITLE" = "Flag etiquette";
"FACT_15_DESC" = "Many countries have strict rules on how to treat the national flag.";
"FACT_16_TITLE" = "Flag with different sides";
"FACT_16_DESC" = "Paraguay has the only national flag in the world with different designs on the obverse and reverse.";
"FACT_17_TITLE" = "Olympic symbolism";
"FACT_17_DESC" = "Olympic ring colours were chosen so that at least one colour appears on every country's flag.";
"FACT_18_TITLE" = "Flag with the most complex coat of arms";
"FACT_18_DESC" = "Mexico's flag shows an eagle perched on a cactus holding a snake—one of the most detailed coats of arms on any flag.";
"FACT_19_TITLE" = "Copycat flag";
"FACT_19_DESC" = "The flags of Monaco and Indonesia are almost identical—red on top, white below. The only difference is the proportions.";
"FACT_20_TITLE" = "Flag with 50 stars";
"FACT_20_DESC" = "The US flag has 50 stars, one for each state. The design has been changed 27 times since 1777.";
"FACT_21_TITLE" = "Northernmost flags";
"FACT_21_DESC" = "Arctic regions use both national and regional flags with unique symbolism.";
"FACT_22_TITLE" = "Flag with a cross";
"FACT_22_DESC" = "29 countries have a cross on their flag, making it one of the most popular symbols on national flags.";
"FACT_23_TITLE" = "Tricolours";
"FACT_23_DESC" = "Many countries use a simple three-stripe design as a historically stable flag form.";
"FACT_24_TITLE" = "Flag with a crescent";
"FACT_24_DESC" = "The crescent appears on the flags of 12 countries, mostly Muslim, symbolizing the Islamic faith.";
"FACT_25_TITLE" = "Sun symbol";
"FACT_25_DESC" = "The sun is one of the most common symbols on flags in Asia and South America.";
"FACT_26_TITLE" = "Flag with a tree";
"FACT_26_DESC" = "Lebanon is the only country with a tree (the Lebanese cedar) on its flag, symbolizing eternity and peace.";
"FACT_27_TITLE" = "Narrowest flag";
"FACT_27_DESC" = "Qatar's flag has the most unusual aspect ratio of any national flag—11:28.";
"FACT_28_TITLE" = "Complex coats of arms";
"FACT_28_DESC" = "Coats of arms on Latin American flags often include many details and historical symbols.";
"FACT_29_TITLE" = "Rainbow flag";
"FACT_29_DESC" = "Bolivia has two official flags—the traditional tricolour and the indigenous Wiphala rainbow flag.";
"FACT_30_TITLE" = "Flag with a building";
"FACT_30_DESC" = "Cambodia's flag shows Angkor Wat temple, making it the only national flag with a building.";
"FACT_31_TITLE" = "Historical disputes";
"FACT_31_DESC" = "The design of some flags has changed due to historical and political disputes between countries.";
"FACT_32_TITLE" = "Flag with a sword";
"FACT_32_DESC" = "Sri Lanka's flag shows a lion holding a sword, symbolizing the courage of the Sinhalese people.";
"FACT_33_TITLE" = "Flag without blue";
"FACT_33_DESC" = "Only four countries do not use blue on their flags: Jamaica, Mauritania, Sri Lanka and the Vatican.";
"FACT_34_TITLE" = "Birds on flags";
"FACT_34_DESC" = "The eagle and other birds on flags symbolize strength, independence and nobility of spirit.";
"FACT_35_TITLE" = "Antarctic symbol";
"FACT_35_DESC" = "Antarctica has no official national flag, but several unofficial designs are used.";
"FACT_36_TITLE" = "Stars on flags";
"FACT_36_DESC" = "The star is one of the most widespread symbols on flags around the world.";
"FACT_37_TITLE" = "Similar colour schemes";
"FACT_37_DESC" = "Some flags are similar in colour but differ in the order of stripes and emblems.";
"FACT_38_TITLE" = "International union flags";
"FACT_38_DESC" = "Supranational organizations also have their own flags reflecting shared values.";
"FACT_39_TITLE" = "Island symbolism";
"FACT_39_DESC" = "Island nations' flags often feature symbols of the ocean, sun and navigation.";
"FACT_40_TITLE" = "Changes over time";
"FACT_40_DESC" = "Some national flags have changed dozens of times with their country's political history.";
"FACT_41_TITLE" = "North Macedonia sun";
"FACT_41_DESC" = "North Macedonia flag has a sun with eight rays for a new beginning.";
"FACT_42_TITLE" = "Belize woodcutters";
"FACT_42_DESC" = "Belize flag is one of the few showing people: woodcutters with tools.";
"FACT_43_TITLE" = "Ecuador condor";
"FACT_43_DESC" = "Ecuador flag includes the Andean condor for strength and sovereignty.";
"FACT_44_TITLE" = "Bolivia Wiphala";
"FACT_44_DESC" = "Bolivia uses the Wiphala alongside the tricolour as an official symbol.";
"FACT_45_TITLE" = "Brazil's 27 stars";
"FACT_45_DESC" = "The Brazilian flag has 27 stars, one for each state and the federal district.";
"FACT_46_TITLE" = "Maple leaf";
"FACT_46_DESC" = "Canada's flag features a single 11-pointed maple leaf, unique among national flags.";
"FACT_47_TITLE" = "Union Jack";
"FACT_47_DESC" = "The UK flag combines the crosses of three saints: England, Scotland and Ireland.";
"FACT_48_TITLE" = "Japan's rising sun";
"FACT_48_DESC" = "The red circle on white represents the rising sun and has been used on Japan's flag since the 7th century.";
"FACT_49_TITLE" = "Ashoka Chakra";
"FACT_49_DESC" = "India's flag features a 24-spoked wheel, symbolizing law and motion.";
"FACT_50_TITLE" = "Australia's Southern Cross";
"FACT_50_DESC" = "Australia's flag shows the Southern Cross constellation, visible only in the Southern Hemisphere.";
"FACT_51_TITLE" = "New Zealand's Southern Cross";
"FACT_51_DESC" = "New Zealand's flag also features the Southern Cross, but with red stars edged in white.";
"FACT_52_TITLE" = "South Korea's taegeuk";
"FACT_52_DESC" = "South Korea's flag features the traditional taegeuk (yin-yang) symbol and trigrams.";
"FACT_53_TITLE" = "Portugal's armillary sphere";
"FACT_53_DESC" = "Portugal's flag features an armillary sphere, an ancient navigational instrument.";
"FACT_54_TITLE" = "Albania's double-headed eagle";
"FACT_54_DESC" = "Albania's flag shows a black double-headed eagle, a symbol of sovereignty.";
"FACT_55_TITLE" = "Kenya's shield";
"FACT_55_DESC" = "Kenya's flag features a Maasai shield and crossed spears.";
"FACT_56_TITLE" = "Wales's dragon";
"FACT_56_DESC" = "The red dragon on Wales's flag is one of the oldest national symbols in the world.";
"FACT_57_TITLE" = "St Andrew's cross";
"FACT_57_DESC" = "Scotland's flag is a white diagonal cross on blue, the cross of St Andrew.";
"FACT_58_TITLE" = "Greenland's circle";
"FACT_58_DESC" = "Greenland's flag has a red-and-white circle representing the sun over the ice.";
"FACT_59_TITLE" = "Pan-African colours";
"FACT_59_DESC" = "Green, yellow and red are often called Pan-African colours and appear on many African flags.";
"FACT_60_TITLE" = "Nordic crosses";
"FACT_60_DESC" = "Five countries use the Nordic cross: Denmark, Norway, Sweden, Finland and Iceland.";
"FACT_61_TITLE" = "French tricolor";
"FACT_61_DESC" = "The French blue-white-red tricolor became a model for many revolutionary and national flags.";
"FACT_62_TITLE" = "UN flag";
"FACT_62_DESC" = "The UN flag shows the world surrounded by olive branches on a blue background.";
"FACT_63_TITLE" = "EU flag";
"FACT_63_DESC" = "Twelve golden stars in a circle on blue symbolize the unity of the European Union.";
"FACT_64_TITLE" = "Olympic flag";
"FACT_64_DESC" = "The five rings on white represent the five inhabited continents and the global nature of the Games.";
"FACT_65_TITLE" = "Vatican square";
"FACT_65_DESC" = "The Vatican has a square national flag like Switzerland.";
"FACT_66_TITLE" = "Nauru 12 points";
"FACT_66_DESC" = "Nauru flag has a 12-pointed star for the 12 tribes.";
"FACT_67_TITLE" = "Turkmenistan carpet";
"FACT_67_DESC" = "Turkmenistan flag has carpet patterns along the hoist.";
"FACT_68_TITLE" = "Afghanistan mosque";
"FACT_68_DESC" = "Afghanistan flag has featured a mosque in its design.";

