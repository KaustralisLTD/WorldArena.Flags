/* 68 interesting facts */
"FACT_01_TITLE" = "Nejstarší nepřetržitě používaná vlajka";
"FACT_01_DESC" = "Dánský Dannebrog je považován za nejstarší národní vlajku, která se nepřetržitě používá od roku 1219.";
"FACT_02_TITLE" = "Pouze čtvercová státní vlajka";
"FACT_02_DESC" = "Švýcarsko má jedinou čtvercovou státní vlajku na světě. Vatikán má také čtvercovou vlajku, ale je městským státem.";
"FACT_03_TITLE" = "Neobdélníková vlajka";
"FACT_03_DESC" = "Nepál má jedinou státní vlajku na světě, která není obdélníková.";
"FACT_04_TITLE" = "Žádná červená, bílá nebo modrá";
"FACT_04_DESC" = "Jamajka je jedinou zemí s vlajkou bez červené, bílé nebo modré.";
"FACT_05_TITLE" = "Vlajka, která se nikdy nestahuje";
"FACT_05_DESC" = "Vlajka Saúdské Arábie není nikdy stažena na půl žerdi kvůli posvátnému textu na ní.";
"FACT_06_TITLE" = "Mladá státní vlajka";
"FACT_06_DESC" = "Vlajka Jižního Súdánu byla přijata v roce 2011 po nezávislosti.";
"FACT_07_TITLE" = "Vlajka s AK-47";
"FACT_07_DESC" = "Mosambik je jedinou zemí, jejíž vlajka obsahuje moderní zbraň — pušku Kalašnikov.";
"FACT_08_TITLE" = "Téměř identické vlajky";
"FACT_08_DESC" = "Vlajky Rumunska a Čadu jsou velmi podobné; obvykle se odlišují odstínem modré.";
"FACT_09_TITLE" = "Symbolika Ukrajiny";
"FACT_09_DESC" = "Modrá a žlutá vlajka Ukrajiny je tradičně interpretována jako obloha nad pšeničným polem.";
"FACT_10_TITLE" = "Nejjednodušší vlajka";
"FACT_10_DESC" = "Vlajka Libye od roku 1977 do roku 2011 byla sytě zelená bez symbolů nebo vzorů.";
"FACT_11_TITLE" = "Vlajka s mapou";
"FACT_11_DESC" = "Kyperská vlajka ukazuje obrys ostrova – vzácný případ mezi národními vlajkami.";
"FACT_12_TITLE" = "Vlajka s Biblí";
"FACT_12_DESC" = "Na vlajce Dominikánské republiky je zobrazena otevřená Bible, což z ní dělá jedinou státní vlajku s náboženskou knihou.";
"FACT_13_TITLE" = "Nejoblíbenější barva";
"FACT_13_DESC" = "Červená je nejběžnější barva na národních vlajkách po celém světě.";
"FACT_14_TITLE" = "Vlajka s textem";
"FACT_14_DESC" = "Text na státních vlajkách je vzácný; jedním známým příkladem je Saúdská Arábie.";
"FACT_15_TITLE" = "Etiketa vlajky";
"FACT_15_DESC" = "Mnoho zemí má přísná pravidla, jak zacházet se státní vlajkou.";
"FACT_16_TITLE" = "Vlajka s různými stranami";
"FACT_16_DESC" = "Paraguay má jedinou státní vlajku na světě s různými vzory na líci a na rubu.";
"FACT_17_TITLE" = "olympijská symbolika";
"FACT_17_DESC" = "Barvy olympijského prstenu byly vybrány tak, aby se na vlajce každé země objevila alespoň jedna barva.";
"FACT_18_TITLE" = "Vlajka s nejsložitějším erbem";
"FACT_18_DESC" = "Mexická vlajka zobrazuje orla posazeného na kaktusu držícího hada – jeden z nejpodrobnějších erbů na jakékoli vlajce.";
"FACT_19_TITLE" = "Napodobovací vlajka";
"FACT_19_DESC" = "Vlajky Monaka a Indonésie jsou téměř totožné – nahoře červené, dole bílé. Jediným rozdílem jsou proporce.";
"FACT_20_TITLE" = "Vlajka s 50 hvězdami";
"FACT_20_DESC" = "Americká vlajka má 50 hvězd, jednu pro každý stát. Design byl od roku 1777 změněn 27krát.";
"FACT_21_TITLE" = "Nejsevernější vlajky";
"FACT_21_DESC" = "Arktické oblasti používají národní i regionální vlajky s jedinečnou symbolikou.";
"FACT_22_TITLE" = "Vlajka s křížem";
"FACT_22_DESC" = "29 zemí má na své vlajce kříž, což z něj činí jeden z nejoblíbenějších symbolů na státních vlajkách.";
"FACT_23_TITLE" = "Trikolory";
"FACT_23_DESC" = "Mnoho zemí používá jednoduchý design se třemi pruhy jako historicky stabilní formu vlajky.";
"FACT_24_TITLE" = "Vlajka s půlměsícem";
"FACT_24_DESC" = "Půlměsíc se objevuje na vlajkách 12 zemí, většinou muslimských, symbolizujících islámskou víru.";
"FACT_25_TITLE" = "Symbol slunce";
"FACT_25_DESC" = "Slunce je jedním z nejčastějších symbolů na vlajkách v Asii a Jižní Americe.";
"FACT_26_TITLE" = "Vlajka se stromem";
"FACT_26_DESC" = "Libanon je jedinou zemí, která má na vlajce strom (libanonský cedr), který symbolizuje věčnost a mír.";
"FACT_27_TITLE" = "Nejužší vlajka";
"FACT_27_DESC" = "Katarská vlajka má nejneobvyklejší poměr stran ze všech národních vlajek — 11:28.";
"FACT_28_TITLE" = "Složité erby";
"FACT_28_DESC" = "Erby na latinskoamerických vlajkách často obsahují mnoho detailů a historických symbolů.";
"FACT_29_TITLE" = "Duhová vlajka";
"FACT_29_DESC" = "Bolívie má dvě oficiální vlajky – tradiční trikolóru a domorodou duhovou vlajku Wiphaly.";
"FACT_30_TITLE" = "Vlajka s budovou";
"FACT_30_DESC" = "Kambodžská vlajka zobrazuje chrám Angkor Wat, což z něj dělá jedinou státní vlajku s budovou.";
"FACT_31_TITLE" = "Historické spory";
"FACT_31_DESC" = "Design některých vlajek se změnil kvůli historickým a politickým sporům mezi zeměmi.";
"FACT_32_TITLE" = "Vlajka s mečem";
"FACT_32_DESC" = "Vlajka Srí Lanky zobrazuje lva držícího meč, který symbolizuje odvahu sinhálského lidu.";
"FACT_33_TITLE" = "Vlajka bez modré";
"FACT_33_DESC" = "Pouze čtyři země nepoužívají modrou barvu na svých vlajkách: Jamajka, Mauretánie, Srí Lanka a Vatikán.";
"FACT_34_TITLE" = "Ptáci na vlajkách";
"FACT_34_DESC" = "Orel a další ptáci na vlajkách symbolizují sílu, nezávislost a ušlechtilost ducha.";
"FACT_35_TITLE" = "Antarktida symbol";
"FACT_35_DESC" = "Antarktida nemá žádnou oficiální státní vlajku, ale používá se několik neoficiálních vzorů.";
"FACT_36_TITLE" = "Hvězdy na vlajkách";
"FACT_36_DESC" = "Hvězda je jedním z nejrozšířenějších symbolů na vlajkách po celém světě.";
"FACT_37_TITLE" = "Podobná barevná schémata";
"FACT_37_DESC" = "Některé vlajky mají podobnou barvu, ale liší se v pořadí pruhů a emblémů.";
"FACT_38_TITLE" = "Vlajky mezinárodní unie";
"FACT_38_DESC" = "Nadnárodní organizace mají také své vlastní vlajky odrážející sdílené hodnoty.";
"FACT_39_TITLE" = "Ostrovní symbolika";
"FACT_39_DESC" = "Vlajky ostrovních národů často obsahují symboly oceánu, slunce a navigace.";
"FACT_40_TITLE" = "Změny v průběhu času";
"FACT_40_DESC" = "Některé státní vlajky se v souvislosti s politickou historií své země několikrát změnily.";
"FACT_41_TITLE" = "Slunce Severní Makedonie";
"FACT_41_DESC" = "Vlajka Severní Makedonie má slunce s osmi paprsky pro nový začátek.";
"FACT_42_TITLE" = "Belizští dřevorubci";
"FACT_42_DESC" = "Vlajka Belize je jedním z mála lidí, kteří ukazují: dřevorubci s nástroji.";
"FACT_43_TITLE" = "Ekvádorský kondor";
"FACT_43_DESC" = "Ekvádorská vlajka zahrnuje andského kondora pro sílu a suverenitu.";
