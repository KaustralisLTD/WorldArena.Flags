/* 68 interesting facts */
"FACT_01_TITLE" = "أقدم علم مستخدم بشكل مستمر";
"FACT_01_DESC" = "يعتبر علم دانيبروغ الدنماركي أقدم علم وطني قيد الاستخدام المستمر منذ عام 1219.";
"FACT_02_TITLE" = "العلم الوطني مربع فقط";
"FACT_02_DESC" = "تمتلك سويسرا العلم الوطني المربع الوحيد في العالم. الفاتيكان لديه أيضًا علم مربع ولكنه دولة مدينة.";
"FACT_03_TITLE" = "علم غير مستطيل";
"FACT_03_DESC" = "نيبال لديها العلم الوطني الوحيد في العالم الذي ليس مستطيلاً.";
"FACT_04_TITLE" = "لا أحمر ولا أبيض ولا أزرق";
"FACT_04_DESC" = "جامايكا هي الدولة الوحيدة التي لديها علم بدون اللون الأحمر أو الأبيض أو الأزرق.";
"FACT_05_TITLE" = "العلم الذي لا يتم إنزاله أبدًا";
"FACT_05_DESC" = "لا يتم تنكيس العلم السعودي أبدًا بسبب النص المقدس الموجود عليه.";
"FACT_06_TITLE" = "العلم الوطني الشاب";
"FACT_06_DESC" = "تم اعتماد علم جنوب السودان في عام 2011 بعد الاستقلال.";
"FACT_07_TITLE" = "العلم مع AK-47";
"FACT_07_DESC" = "موزمبيق هي الدولة الوحيدة التي يتميز علمها بسلاح حديث – بندقية كلاشينكوف.";
"FACT_08_TITLE" = "أعلام متطابقة تقريبا";
"FACT_08_DESC" = "أعلام رومانيا وتشاد متشابهان جدًا؛ وعادة ما تتميز بظلال اللون الأزرق.";
"FACT_09_TITLE" = "رمزية أوكرانيا";
"FACT_09_DESC" = "يتم تفسير علم أوكرانيا الأزرق والأصفر تقليديا على أنه السماء فوق حقل قمح.";
"FACT_10_TITLE" = "أبسط علم";
"FACT_10_DESC" = "كان علم ليبيا من عام 1977 إلى عام 2011 أخضر اللون بدون أي رموز أو أنماط.";
"FACT_11_TITLE" = "العلم مع الخريطة";
"FACT_11_DESC" = "يُظهر علم قبرص الخطوط العريضة للجزيرة، وهي حالة نادرة بين الأعلام الوطنية.";
"FACT_12_TITLE" = "العلم مع الكتاب المقدس";
"FACT_12_DESC" = "يُظهر علم جمهورية الدومينيكان كتابًا مقدسًا مفتوحًا، مما يجعله العلم الوطني الوحيد الذي يحتوي على كتاب ديني.";
"FACT_13_TITLE" = "اللون الأكثر شعبية";
"FACT_13_DESC" = "الأحمر هو اللون الأكثر شيوعًا في الأعلام الوطنية في جميع أنحاء العالم.";
"FACT_14_TITLE" = "العلم مع النص";
"FACT_14_DESC" = "النص على الأعلام الوطنية نادر. أحد الأمثلة المعروفة هو المملكة العربية السعودية.";
"FACT_15_TITLE" = "آداب العلم";
"FACT_15_DESC" = "لدى العديد من الدول قواعد صارمة بشأن كيفية التعامل مع العلم الوطني.";
"FACT_16_TITLE" = "العلم مع جوانب مختلفة";
"FACT_16_DESC" = "تمتلك باراغواي العلم الوطني الوحيد في العالم بتصميمات مختلفة على الوجه والعكس.";
"FACT_17_TITLE" = "الرمزية الأولمبية";
"FACT_17_DESC" = "تم اختيار ألوان الحلقات الأولمبية بحيث يظهر لون واحد على الأقل على علم كل دولة.";
"FACT_18_TITLE" = "العلم مع شعار النبالة الأكثر تعقيدًا";
"FACT_18_DESC" = "يُظهر علم المكسيك نسرًا جاثمًا على شجرة صبار يحمل ثعبانًا، وهو أحد أكثر شعارات النبالة تفصيلاً على أي علم.";
"FACT_19_TITLE" = "علم مقلد";
"FACT_19_DESC" = "علم موناكو وإندونيسيا متطابقان تقريبًا؛ أحمر في الأعلى، وأبيض في الأسفل. والفرق الوحيد هو النسب.";
"FACT_20_TITLE" = "العلم مع 50 نجمة";
"FACT_20_DESC" = "يحتوي العلم الأمريكي على 50 نجمة، واحدة لكل ولاية. تم تغيير التصميم 27 مرة منذ عام 1777.";
"FACT_21_TITLE" = "أعلام أقصى الشمال";
"FACT_21_DESC" = "تستخدم مناطق القطب الشمالي أعلامًا وطنية وإقليمية ذات رمزية فريدة.";
"FACT_22_TITLE" = "العلم مع الصليب";
"FACT_22_DESC" = "29 دولة لديها صليب على أعلامها، مما يجعلها واحدة من الرموز الأكثر شعبية على الأعلام الوطنية.";
"FACT_23_TITLE" = "الالوان الثلاثة";
"FACT_23_DESC" = "تستخدم العديد من الدول تصميمًا بسيطًا ثلاثي الخطوط كشكل علم مستقر تاريخيًا.";
"FACT_24_TITLE" = "العلم مع الهلال";
"FACT_24_DESC" = "ويظهر الهلال على أعلام 12 دولة أغلبها إسلامية، ويرمز إلى العقيدة الإسلامية.";
"FACT_25_TITLE" = "رمز الشمس";
"FACT_25_DESC" = "الشمس هي أحد الرموز الأكثر شيوعًا على أعلام آسيا وأمريكا الجنوبية.";
"FACT_26_TITLE" = "العلم بشجرة";
"FACT_26_DESC" = "لبنان هو الدولة الوحيدة التي يوجد على علمها شجرة (الأرزة اللبنانية) ترمز إلى الخلود والسلام.";
"FACT_27_TITLE" = "أضيق علم";
"FACT_27_DESC" = "يتميز علم قطر بنسبة العرض إلى الارتفاع الأكثر غرابة بين أي علم وطني - 11:28.";
"FACT_28_TITLE" = "معاطف معقدة من الأسلحة";
"FACT_28_DESC" = "غالبًا ما تتضمن شعارات النبالة على أعلام أمريكا اللاتينية العديد من التفاصيل والرموز التاريخية.";
"FACT_29_TITLE" = "علم قوس قزح";
"FACT_29_DESC" = "يوجد في بوليفيا علمان رسميان - العلم التقليدي ذو الألوان الثلاثة وعلم قوس قزح Wiphala الأصلي.";
"FACT_30_TITLE" = "العلم مع المبنى";
"FACT_30_DESC" = "يُظهر علم كمبوديا معبد أنغكور وات، مما يجعله العلم الوطني الوحيد الذي يحتوي على مبنى.";
"FACT_31_TITLE" = "النزاعات التاريخية";
"FACT_31_DESC" = "لقد تغير تصميم بعض الأعلام بسبب الخلافات التاريخية والسياسية بين الدول.";
"FACT_32_TITLE" = "العلم بالسيف";
"FACT_32_DESC" = "يظهر علم سريلانكا أسدًا يحمل سيفًا، يرمز إلى شجاعة الشعب السنهالي.";
"FACT_33_TITLE" = "العلم بدون اللون الأزرق";
"FACT_33_DESC" = "أربع دول فقط لا تستخدم اللون الأزرق في أعلامها: جامايكا وموريتانيا وسريلانكا والفاتيكان.";
"FACT_34_TITLE" = "الطيور على الأعلام";
"FACT_34_DESC" = "يرمز النسر والطيور الأخرى الموجودة على الأعلام إلى القوة والاستقلال ونبل الروح.";
"FACT_35_TITLE" = "رمز القطب الجنوبي";
"FACT_35_DESC" = "ليس لدى القارة القطبية الجنوبية علم وطني رسمي، ولكن يتم استخدام العديد من التصاميم غير الرسمية.";
"FACT_36_TITLE" = "نجوم على الأعلام";
"FACT_36_DESC" = "النجمة هي واحدة من الرموز الأكثر انتشارًا على الأعلام حول العالم.";
"FACT_37_TITLE" = "أنظمة الألوان مماثلة";
"FACT_37_DESC" = "تتشابه بعض الأعلام في اللون ولكنها تختلف في ترتيب الخطوط والشعارات.";
"FACT_38_TITLE" = "أعلام الاتحاد الدولي";
"FACT_38_DESC" = "المنظمات فوق الوطنية لديها أيضًا أعلامها الخاصة التي تعكس القيم المشتركة.";
"FACT_39_TITLE" = "رمزية الجزيرة";
"FACT_39_DESC" = "غالبًا ما تتميز أعلام الدول الجزرية برموز المحيط والشمس والملاحة.";
"FACT_40_TITLE" = "التغييرات مع مرور الوقت";
"FACT_40_DESC" = "لقد تغيرت بعض الأعلام الوطنية عشرات المرات مع التاريخ السياسي لبلادهم.";
"FACT_41_TITLE" = "شمس مقدونيا الشمالية";
"FACT_41_DESC" = "علم مقدونيا الشمالية لديه شمس بثمانية أشعة لبداية جديدة.";
"FACT_42_TITLE" = "الحطابين بليز";
"FACT_42_DESC" = "علم بليز هو واحد من عدد قليل من الأشخاص الذين يظهرون: الحطابين مع الأدوات.";
"FACT_43_TITLE" = "الاكوادور كوندور";
"FACT_43_DESC" = "يتضمن علم الإكوادور كندور الأنديز للقوة والسيادة.";
"FACT_44_TITLE" = "بوليفيا ويفالا";
"FACT_44_DESC" = "تستخدم بوليفيا Wiphala إلى جانب الألوان الثلاثة كرمز رسمي.";
"FACT_45_TITLE" = "البرازيل 27 نجمة";
"FACT_45_DESC" = "يتكون العلم البرازيلي من 27 نجمة، واحدة لكل ولاية ومنطقة فيدرالية.";
"FACT_46_TITLE" = "ورقة القيقب";
"FACT_46_DESC" = "يتميز علم كندا بورقة قيقب واحدة ذات 11 نقطة، وهي فريدة من نوعها بين الأعلام الوطنية.";
"FACT_47_TITLE" = "يونيون جاك";
"FACT_47_DESC" = "يجمع علم المملكة المتحدة بين صلبان ثلاثة قديسين: إنجلترا واسكتلندا وأيرلندا.";
"FACT_48_TITLE" = "شمس اليابان المشرقة";
"FACT_48_DESC" = "تمثل الدائرة الحمراء باللون الأبيض شروق الشمس وقد تم استخدامها في علم اليابان منذ القرن السابع.";
"FACT_49_TITLE" = "أشوكا شقرا";
"FACT_49_DESC" = "يتميز علم الهند بعجلة ذات 24 شعاعًا، ترمز إلى القانون والحركة.";
"FACT_50_TITLE" = "أستراليا الجنوبية الصليب";
"FACT_50_DESC" = "يُظهر علم أستراليا كوكبة الصليب الجنوبي، التي يمكن رؤيتها فقط في نصف الكرة الجنوبي.";
"FACT_51_TITLE" = "صليب نيوزيلندا الجنوبي";
"FACT_51_DESC" = "يتميز علم نيوزيلندا أيضًا بالصليب الجنوبي، ولكن بنجوم حمراء ذات حواف بيضاء.";
"FACT_52_TITLE" = "تايجوك في كوريا الجنوبية";
"FACT_52_DESC" = "يتميز علم كوريا الجنوبية برمز تايجوك (يين يانغ) التقليدي وأشكاله الثلاثية.";
"FACT_53_TITLE" = "المجال العسكري البرتغالي";
"FACT_53_DESC" = "يتميز علم البرتغال بوجود كرة حربية، وهي أداة ملاحية قديمة.";
"FACT_54_TITLE" = "ألبانيا النسر ذو الرأسين";
"FACT_54_DESC" = "يُظهر علم ألبانيا نسرًا أسود برأسين، رمزًا للسيادة.";
"FACT_55_TITLE" = "درع كينيا";
"FACT_55_DESC" = "يتميز علم كينيا بدرع الماساي والرماح المتقاطعة.";
"FACT_56_TITLE" = "تنين ويلز";
"FACT_56_DESC" = "يعد التنين الأحمر الموجود على علم ويلز أحد أقدم الرموز الوطنية في العالم.";
"FACT_57_TITLE" = "صليب القديس أندرو";
"FACT_57_DESC" = "علم اسكتلندا عبارة عن صليب قطري أبيض على اللون الأزرق، وهو صليب القديس أندرو.";
"FACT_58_TITLE" = "دائرة جرينلاند";
"FACT_58_DESC" = "يحتوي علم جرينلاند على دائرة باللونين الأحمر والأبيض تمثل الشمس فوق الجليد.";
"FACT_59_TITLE" = "الألوان الأفريقية";
"FACT_59_DESC" = "غالبًا ما يُطلق على اللون الأخضر والأصفر والأحمر ألوان عموم أفريقيا وتظهر على العديد من الأعلام الأفريقية.";
"FACT_60_TITLE" = "الصلبان الشمالية";
"FACT_60_DESC" = "تستخدم خمس دول الصليب الشمالي: الدنمارك والنرويج والسويد وفنلندا وأيسلندا.";
"FACT_61_TITLE" = "الالوان الثلاثة الفرنسية";
"FACT_61_DESC" = "أصبح اللون الفرنسي الأزرق والأبيض والأحمر نموذجًا للعديد من الأعلام الثورية والوطنية.";
"FACT_62_TITLE" = "علم الأمم المتحدة";
"FACT_62_DESC" = "يُظهر علم الأمم المتحدة العالم محاطًا بأغصان الزيتون على خلفية زرقاء.";
"FACT_63_TITLE" = "علم الاتحاد الأوروبي";
"FACT_63_DESC" = "ترمز اثنا عشر نجمة ذهبية في دائرة باللون الأزرق إلى وحدة الاتحاد الأوروبي.";
"FACT_64_TITLE" = "العلم الأولمبي";
"FACT_64_DESC" = "تمثل الحلقات الخمس باللون الأبيض القارات الخمس المأهولة والطبيعة العالمية للألعاب.";
"FACT_65_TITLE" = "ساحة الفاتيكان";
"FACT_65_DESC" = "الفاتيكان لديه علم وطني مربع مثل سويسرا.";
"FACT_66_TITLE" = "ناورو 12 نقطة";
"FACT_66_DESC" = "يحتوي علم ناورو على نجمة ذات 12 نقطة للقبائل الـ12.";
"FACT_67_TITLE" = "سجادة تركمانستان";
"FACT_67_DESC" = "يحتوي علم تركمانستان على أنماط سجادة على طول الرافعة.";
"FACT_68_TITLE" = "مسجد أفغانستان";
"FACT_68_DESC" = "وقد ظهر علم أفغانستان على شكل مسجد في تصميمه.";

