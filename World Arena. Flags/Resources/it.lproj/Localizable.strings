"FACT_44_TITLE" = "Due bandiere della Bolivia";
"FACT_44_DESC" = "La Bolivia usa la Wiphala accanto al tricolore come simbolo ufficiale.";
"FACT_45_TITLE" = "27 stelle del Brasile";
