"FACT_57_TITLE" = "Croce di sant'Andrea";
"FACT_57_DESC" = "La bandiera scozzese è una croce diagonale bianca su blu, la croce di sant'Andrea.";
"FACT_58_TITLE" = "Cerchio della Groenlandia";
"FACT_58_DESC" = "La bandiera della Groenlandia ha un cerchio rosso e bianco per il sole sul ghiaccio.";
"FACT_59_TITLE" = "Colori panafricani";
"FACT_59_DESC" = "Verde, giallo e rosso sono spesso detti colori panafricani e compaiono su molte bandiere africane.";
"FACT_60_TITLE" = "Croci nordiche";
"FACT_60_DESC" = "Cinque paesi usano la croce nordica: Danimarca, Norvegia, Svezia, Finlandia e Islanda.";
"FACT_61_TITLE" = "Tricolore francese";
"FACT_61_DESC" = "Il tricolore blu-bianco-rosso francese è stato modello per molte bandiere rivoluzionarie e nazionali.";
"FACT_62_TITLE" = "Bandiera dell'ONU";
"FACT_62_DESC" = "La bandiera dell'ONU mostra il mondo circondato da rami d'ulivo su sfondo blu.";
"FACT_63_TITLE" = "Bandiera dell'UE";
"FACT_63_DESC" = "Dodici stelle d'oro in cerchio su blu simboleggiano l'unità dell'Unione europea.";
"FACT_64_TITLE" = "Bandiera olimpica";
"FACT_64_DESC" = "I cinque anelli olimpici su sfondo bianco simboleggiano l’unione di cinque continenti e di atleti da tutto il mondo.";
"FACT_65_TITLE" = "Bandiera quadrata del Vaticano";
"FACT_65_DESC" = "Il Vaticano ha bandiera nazionale quadrata come la Svizzera.";
"FACT_66_TITLE" = "12 punte di Nauru";
