"FACT_47_TITLE" = "Union Jack";
"FACT_47_DESC" = "La bandiera del Regno Unito combina le croci di san Giorgio, sant’Andrea e san Patrizio.";
"FACT_48_TITLE" = "Sole nascente del Giappone";
"FACT_48_DESC" = "La bandiera nazionale del Giappone presenta un cerchio rosso che rappresenta il sole su uno sfondo bianco.";
"FACT_49_TITLE" = "Ashoka Chakra";
"FACT_49_DESC" = "La bandiera dell'India ha una ruota a 24 raggi, simbolo di legge e movimento.";
"FACT_50_TITLE" = "Croce del Sud dell'Australia";
"FACT_50_DESC" = "Cinque stelle sulla bandiera australiana rappresentano la costellazione della Croce del Sud.";
"FACT_51_TITLE" = "Croce del Sud della Nuova Zelanda";
