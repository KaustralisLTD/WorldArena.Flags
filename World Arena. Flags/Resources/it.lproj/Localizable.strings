"FACT_34_DESC" = "L'aquila e altri uccelli sulle bandiere simboleggiano forza, indipendenza e nobiltà.";
"FACT_35_TITLE" = "Simbolo antartico";
"FACT_35_DESC" = "L'Antartide non ha bandiera nazionale ufficiale, ma si usano diversi disegni non ufficiali.";
"FACT_36_TITLE" = "Stelle sulle bandiere";
