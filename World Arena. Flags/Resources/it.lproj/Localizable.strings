"FACT_37_TITLE" = "Schemi di colore simili";
"FACT_37_DESC" = "Alcune bandiere sono simili nei colori ma differiscono nell'ordine di strisce ed emblemi.";
"FACT_38_TITLE" = "Bandiere di unioni internazionali";
"FACT_38_DESC" = "Anche le organizzazioni sovranazionali hanno bandiere che riflettono valori comuni.";
"FACT_39_TITLE" = "Simbolismo insulare";
"FACT_39_DESC" = "Le bandiere degli stati insulari mostrano spesso oceano, sole e navigazione.";
"FACT_40_TITLE" = "Cambiamenti nel tempo";
