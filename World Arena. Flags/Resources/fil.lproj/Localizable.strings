/* 68 interesting facts */
"FACT_01_TITLE" = "Pinakamatandang patuloy na ginagamit na bandila";
"FACT_01_DESC" = "Ang Dannebrog ng Denmark ay itinuturing na pinakalumang pambansang watawat na patuloy na ginagamit mula noong 1219.";
"FACT_02_TITLE" = "Tanging square national flag";
"FACT_02_DESC" = "Ang Switzerland ang may tanging parisukat na pambansang watawat sa mundo. Ang Vatican ay mayroon ding parisukat na bandila ngunit ito ay isang lungsod-estado.";
"FACT_03_TITLE" = "Watawat na hindi hugis-parihaba";
"FACT_03_DESC" = "Ang Nepal ay may tanging pambansang watawat sa mundo na hindi hugis-parihaba.";
"FACT_04_TITLE" = "Walang pula, puti o asul";
"FACT_04_DESC" = "Ang Jamaica ay ang tanging bansa na may watawat na walang pula, puti o asul.";
"FACT_05_TITLE" = "Bandila na hindi ibinababa";
"FACT_05_DESC" = "Ang watawat ng Saudi Arabia ay hindi kailanman itinataas sa kalahating palo dahil sa sagradong teksto dito.";
"FACT_06_TITLE" = "Batang pambansang watawat";
"FACT_06_DESC" = "Ang bandila ng South Sudan ay pinagtibay noong 2011 pagkatapos ng kalayaan.";
"FACT_07_TITLE" = "I-flag gamit ang AK-47";
"FACT_07_DESC" = "Ang Mozambique ang tanging bansa na ang bandila ay nagtatampok ng modernong sandata—ang Kalashnikov rifle.";
"FACT_08_TITLE" = "Halos magkaparehong mga bandila";
"FACT_08_DESC" = "Ang mga watawat ng Romania at Chad ay halos magkatulad; sila ay karaniwang nakikilala sa pamamagitan ng lilim ng asul.";
"FACT_09_TITLE" = "simbolismo ng Ukraine";
"FACT_09_DESC" = "Ang asul at dilaw na bandila ng Ukraine ay tradisyonal na binibigyang kahulugan bilang kalangitan sa ibabaw ng isang bukid ng trigo.";
"FACT_10_TITLE" = "Pinakasimpleng bandila";
"FACT_10_DESC" = "Ang bandila ng Libya mula 1977 hanggang 2011 ay solidong berde na walang mga simbolo o pattern.";
"FACT_11_TITLE" = "I-flag gamit ang mapa";
"FACT_11_DESC" = "Ang bandila ng Cyprus ay nagpapakita ng balangkas ng isla—isang bihirang kaso sa mga pambansang watawat.";
"FACT_12_TITLE" = "I-flag gamit ang Bibliya";
"FACT_12_DESC" = "Ang bandila ng Dominican Republic ay nagpapakita ng isang bukas na Bibliya, na ginagawa itong ang tanging pambansang watawat na may relihiyosong aklat.";
"FACT_13_TITLE" = "Pinaka sikat na kulay";
"FACT_13_DESC" = "Ang pula ay ang pinakakaraniwang kulay sa mga pambansang watawat sa buong mundo.";
"FACT_14_TITLE" = "I-flag gamit ang text";
"FACT_14_DESC" = "Ang teksto sa mga pambansang watawat ay bihira; isang kilalang halimbawa ay ang Saudi Arabia.";
"FACT_15_TITLE" = "Etiquette sa bandila";
"FACT_15_DESC" = "Maraming bansa ang may mahigpit na alituntunin kung paano ituring ang pambansang watawat.";
"FACT_16_TITLE" = "Bandila na may iba't ibang panig";
"FACT_16_DESC" = "Ang Paraguay ang may tanging pambansang watawat sa mundo na may iba't ibang disenyo sa obverse at reverse.";
"FACT_17_TITLE" = "simbolismo ng Olympic";
"FACT_17_DESC" = "Pinili ang mga kulay ng singsing sa Olympic upang kahit isang kulay ang lumitaw sa bandila ng bawat bansa.";
"FACT_18_TITLE" = "I-flag na may pinakakumplikadong coat of arms";
"FACT_18_DESC" = "Ang watawat ng Mexico ay nagpapakita ng isang agila na nakadapo sa isang cactus na may hawak na ahas—isa sa mga pinakadetalyadong sandata sa anumang bandila.";
"FACT_19_TITLE" = "flag ng copycat";
"FACT_19_DESC" = "Ang mga watawat ng Monaco at Indonesia ay halos magkapareho—pula sa itaas, puti sa ibaba. Ang pagkakaiba lamang ay ang mga sukat.";
"FACT_20_TITLE" = "I-flag na may 50 bituin";
"FACT_20_DESC" = "Ang watawat ng US ay may 50 bituin, isa para sa bawat estado. Ang disenyo ay binago ng 27 beses mula noong 1777.";
"FACT_21_TITLE" = "Mga bandila sa hilagang bahagi";
"FACT_21_DESC" = "Ang mga rehiyon ng Arctic ay gumagamit ng parehong pambansa at rehiyonal na mga watawat na may natatanging simbolismo.";
"FACT_22_TITLE" = "Bandila na may krus";
"FACT_22_DESC" = "29 na bansa ang may krus sa kanilang bandila, na ginagawa itong isa sa mga pinakasikat na simbolo sa mga pambansang watawat.";
"FACT_23_TITLE" = "Mga tatlong kulay";
"FACT_23_DESC" = "Maraming bansa ang gumagamit ng simpleng three-stripe na disenyo bilang isang makasaysayang matatag na anyo ng bandila.";
"FACT_24_TITLE" = "Bandila na may gasuklay";
"FACT_24_DESC" = "Lumilitaw ang gasuklay sa mga watawat ng 12 bansa, karamihan ay Muslim, na sumisimbolo sa pananampalatayang Islam.";
"FACT_25_TITLE" = "Simbolo ng araw";
"FACT_25_DESC" = "Ang araw ay isa sa mga pinakakaraniwang simbolo sa mga watawat sa Asya at Timog Amerika.";
"FACT_26_TITLE" = "Bandila na may puno";
"FACT_26_DESC" = "Ang Lebanon ay ang tanging bansa na may puno (ang Lebanese cedar) sa watawat nito, na sumasagisag sa kawalang-hanggan at kapayapaan.";
"FACT_27_TITLE" = "Pinakamakitid na bandila";
"FACT_27_DESC" = "Ang watawat ng Qatar ay may pinaka-hindi pangkaraniwang aspect ratio ng anumang pambansang watawat—11:28.";
"FACT_28_TITLE" = "Mga kumplikadong coat of arm";
"FACT_28_DESC" = "Ang mga coat of arm sa mga watawat ng Latin America ay kadalasang may kasamang maraming detalye at makasaysayang simbolo.";
"FACT_29_TITLE" = "Watawat ng bahaghari";
"FACT_29_DESC" = "Ang Bolivia ay may dalawang opisyal na watawat—ang tradisyunal na tricolor at ang katutubong Wiphala rainbow flag.";
"FACT_30_TITLE" = "Bandila na may gusali";
"FACT_30_DESC" = "Ang bandila ng Cambodia ay nagpapakita ng templo ng Angkor Wat, na ginagawa itong ang tanging pambansang watawat na may gusali.";
"FACT_31_TITLE" = "Makasaysayang mga pagtatalo";
"FACT_31_DESC" = "Nagbago ang disenyo ng ilang watawat dahil sa mga alitan sa kasaysayan at pulitika sa pagitan ng mga bansa.";
"FACT_32_TITLE" = "Bandila na may espada";
"FACT_32_DESC" = "Ang watawat ng Sri Lanka ay nagpapakita ng isang leon na may hawak na espada, na sumisimbolo sa katapangan ng mga taong Sinhalese.";
"FACT_33_TITLE" = "Bandila na walang asul";
"FACT_33_DESC" = "Apat na bansa lamang ang hindi gumagamit ng asul sa kanilang mga bandila: Jamaica, Mauritania, Sri Lanka at Vatican.";
"FACT_34_TITLE" = "Mga ibon sa mga watawat";
"FACT_34_DESC" = "Ang agila at iba pang mga ibon sa mga watawat ay sumisimbolo sa lakas, kalayaan at maharlika ng espiritu.";
"FACT_35_TITLE" = "Simbolo ng Antarctic";
"FACT_35_DESC" = "Ang Antarctica ay walang opisyal na pambansang watawat, ngunit maraming hindi opisyal na disenyo ang ginagamit.";
"FACT_36_TITLE" = "Mga bituin sa mga watawat";
"FACT_36_DESC" = "Ang bituin ay isa sa pinakalaganap na simbolo sa mga watawat sa buong mundo.";
"FACT_37_TITLE" = "Katulad na mga scheme ng kulay";
"FACT_37_DESC" = "Ang ilang mga bandila ay magkatulad sa kulay ngunit naiiba sa pagkakasunud-sunod ng mga guhit at emblema.";
"FACT_38_TITLE" = "Mga bandila ng internasyonal na unyon";
"FACT_38_DESC" = "Ang mga organisasyong supranasyonal ay mayroon ding sariling mga watawat na nagpapakita ng mga ibinahaging halaga.";
"FACT_39_TITLE" = "Simbolismo ng isla";
"FACT_39_DESC" = "Ang mga watawat ng mga bansa sa isla ay kadalasang nagtatampok ng mga simbolo ng karagatan, araw at nabigasyon.";
"FACT_40_TITLE" = "Mga pagbabago sa paglipas ng panahon";
"FACT_40_DESC" = "Ang ilang mga pambansang watawat ay nagbago ng dose-dosenang beses sa kasaysayan ng pulitika ng kanilang bansa.";
"FACT_41_TITLE" = "Araw ng North Macedonia";
"FACT_41_DESC" = "Ang bandila ng North Macedonia ay may araw na may walong sinag para sa isang bagong simula.";
"FACT_42_TITLE" = "Belize woodcutters";
"FACT_42_DESC" = "Ang bandila ng Belize ay isa sa iilang nagpapakita ng mga tao: mga woodcutter na may mga kasangkapan.";
"FACT_43_TITLE" = "Ecuador condor";
"FACT_43_DESC" = "Kasama sa watawat ng Ecuador ang Andean condor para sa lakas at soberanya.";
"FACT_44_TITLE" = "Bolivia Wiphala";
"FACT_44_DESC" = "Ginagamit ng Bolivia ang Wiphala sa tabi ng tatlong kulay bilang isang opisyal na simbolo.";
"FACT_45_TITLE" = "27 bituin ng Brazil";
"FACT_45_DESC" = "Ang bandila ng Brazil ay may 27 bituin, isa para sa bawat estado at pederal na distrito.";
"FACT_46_TITLE" = "Dahon ng maple";
"FACT_46_DESC" = "Nagtatampok ang watawat ng Canada ng nag-iisang 11-pointed maple leaf, na kakaiba sa mga pambansang watawat.";
"FACT_47_TITLE" = "Union Jack";
"FACT_47_DESC" = "Pinagsasama ng watawat ng UK ang mga krus ng tatlong santo: England, Scotland at Ireland.";
"FACT_48_TITLE" = "Ang pagsikat ng araw ng Japan";
"FACT_48_DESC" = "Ang pulang bilog sa puti ay kumakatawan sa pagsikat ng araw at ginamit sa bandila ng Japan mula pa noong ika-7 siglo.";
"FACT_49_TITLE" = "Ashoka Chakra";
"FACT_49_DESC" = "Nagtatampok ang watawat ng India ng 24-spoke na gulong, na sumisimbolo sa batas at galaw.";
"FACT_50_TITLE" = "Southern Cross ng Australia";
"FACT_50_DESC" = "Ang bandila ng Australia ay nagpapakita ng konstelasyon ng Southern Cross, na makikita lamang sa Southern Hemisphere.";
"FACT_51_TITLE" = "Southern Cross ng New Zealand";
"FACT_51_DESC" = "Nagtatampok din ang bandila ng New Zealand ng Southern Cross, ngunit may mga pulang bituin na may talim sa puti.";
"FACT_52_TITLE" = "taegeuk ng South Korea";
"FACT_52_DESC" = "Itinatampok sa watawat ng South Korea ang tradisyunal na simbolo at trigram na taegeuk (yin-yang).";
"FACT_53_TITLE" = "Ang armillary sphere ng Portugal";
"FACT_53_DESC" = "Nagtatampok ang bandila ng Portugal ng armillary sphere, isang sinaunang instrumento sa pag-navigate.";
"FACT_54_TITLE" = "Ang dobleng ulo na agila ng Albania";
"FACT_54_DESC" = "Ang watawat ng Albania ay nagpapakita ng isang itim na agila na may dalawang ulo, isang simbolo ng soberanya.";
"FACT_55_TITLE" = "kalasag ng Kenya";
"FACT_55_DESC" = "Nagtatampok ang bandila ng Kenya ng isang Maasai shield at crossed spears.";
"FACT_56_TITLE" = "Ang dragon ng Wales";
"FACT_56_DESC" = "Ang pulang dragon sa bandila ng Wales ay isa sa mga pinakalumang pambansang simbolo sa mundo.";
"FACT_57_TITLE" = "krus ni St Andrew";
"FACT_57_DESC" = "Ang bandila ng Scotland ay isang puting dayagonal na krus sa asul, ang krus ng St Andrew.";
"FACT_58_TITLE" = "bilog ng Greenland";
"FACT_58_DESC" = "Ang bandila ng Greenland ay may pula-at-puting bilog na kumakatawan sa araw sa ibabaw ng yelo.";
"FACT_59_TITLE" = "Pan-African na kulay";
"FACT_59_DESC" = "Ang berde, dilaw at pula ay madalas na tinatawag na mga Pan-African na kulay at lumilitaw sa maraming mga bandila ng Africa.";
"FACT_60_TITLE" = "Nordic crosses";
"FACT_60_DESC" = "Limang bansa ang gumagamit ng Nordic cross: Denmark, Norway, Sweden, Finland at Iceland.";
"FACT_61_TITLE" = "French tricolor";
"FACT_61_DESC" = "Ang French blue-white-red tricolor ay naging modelo para sa maraming rebolusyonaryo at pambansang watawat.";
"FACT_62_TITLE" = "bandila ng UN";
"FACT_62_DESC" = "Ang bandila ng UN ay nagpapakita ng mundo na napapalibutan ng mga sanga ng oliba sa isang asul na background.";
"FACT_63_TITLE" = "bandila ng EU";
"FACT_63_DESC" = "Labindalawang ginintuang bituin sa isang bilog sa asul na sumisimbolo sa pagkakaisa ng European Union.";
"FACT_64_TITLE" = "bandila ng Olympic";
"FACT_64_DESC" = "Ang limang singsing sa puti ay kumakatawan sa limang may nakatirang mga kontinente at ang pandaigdigang kalikasan ng Mga Laro.";
"FACT_65_TITLE" = "Vatican square";
"FACT_65_DESC" = "Ang Vatican ay may parisukat na pambansang watawat tulad ng Switzerland.";
"FACT_66_TITLE" = "Nauru 12 puntos";
"FACT_66_DESC" = "Ang bandila ng Nauru ay may 12-pointed star para sa 12 tribo.";
"FACT_67_TITLE" = "Karpet ng Turkmenistan";
"FACT_67_DESC" = "Ang bandila ng Turkmenistan ay may mga pattern ng karpet sa kahabaan ng hoist.";
"FACT_68_TITLE" = "mosque ng Afghanistan";
"FACT_68_DESC" = "Ang bandila ng Afghanistan ay nagtatampok ng isang mosque sa disenyo nito.";

