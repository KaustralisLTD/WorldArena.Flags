/* 68 interesting facts */
"FACT_01_TITLE" = "Самый старый флаг";
"FACT_01_DESC" = "Флаг Дании (Данеброг) считается самым старым государственным флагом в мире, который используется непрерывно с 1219 года.";
"FACT_02_TITLE" = "Единственный квадратный флаг";
"FACT_02_DESC" = "Швейцария имеет единственный квадратный национальный флаг в мире. Ватикан также имеет квадратный флаг, но это город-государство.";
"FACT_03_TITLE" = "Непрямоугольный флаг";
"FACT_03_DESC" = "Флаг Непала — единственный национальный флаг в мире, который не является прямоугольным.";
"FACT_04_TITLE" = "Без красного, белого и синего";
"FACT_04_DESC" = "Ямайка — единственная страна с флагом без красного, белого и синего цветов.";
"FACT_05_TITLE" = "Флаг, который не приспускают";
"FACT_05_DESC" = "Флаг Саудовской Аравии не приспускается до полумачты из-за священной надписи.";
"FACT_06_TITLE" = "Молодой национальный флаг";
"FACT_06_DESC" = "Флаг Южного Судана принят в 2011 году после обретения независимости.";
"FACT_07_TITLE" = "Флаг с AK-47";
"FACT_07_DESC" = "Мозамбик — единственная страна в мире, на флаге которой изображено современное оружие — автомат Калашникова.";
"FACT_08_TITLE" = "Почти одинаковые флаги";
"FACT_08_DESC" = "Флаги Румынии и Чада очень похожи; обычно их отличают по оттенку синего.";
"FACT_09_TITLE" = "Символика Украины";
"FACT_09_DESC" = "Сине-жёлтый флаг Украины традиционно трактуют как небо над пшеничным полем.";
"FACT_10_TITLE" = "Самый простой флаг";
"FACT_10_DESC" = "Флаг Ливии с 1977 по 2011 год состоял только из зелёного цвета без каких-либо символов или узоров.";
"FACT_11_TITLE" = "Флаг с картой";
"FACT_11_DESC" = "На флаге Кипра изображён контур острова — редкий случай для государственных флагов.";
"FACT_12_TITLE" = "Флаг с Библией";
"FACT_12_DESC" = "На флаге Доминиканской Республики изображена открытая Библия, что делает его единственным национальным флагом с религиозной книгой.";
"FACT_13_TITLE" = "Самый популярный цвет";
"FACT_13_DESC" = "Красный — самый частый цвет на национальных флагах мира.";
"FACT_14_TITLE" = "Флаг с текстом";
"FACT_14_DESC" = "Текст на национальном флаге встречается редко; один из известных примеров — Саудовская Аравия.";
"FACT_15_TITLE" = "Этикет использования флага";
"FACT_15_DESC" = "Во многих странах действуют строгие правила обращения с государственным флагом.";
"FACT_16_TITLE" = "Флаг с разными сторонами";
"FACT_16_DESC" = "Парагвай имеет единственный в мире национальный флаг с разными изображениями на лицевой и обратной сторонах.";
"FACT_17_TITLE" = "Олимпийская символика";
"FACT_17_DESC" = "Цвета олимпийских колец подобраны так, чтобы хотя бы один цвет встречался на флаге каждой страны.";
"FACT_18_TITLE" = "Флаг с самым сложным гербом";
"FACT_18_DESC" = "На флаге Мексики изображён орёл, сидящий на кактусе и держащий в клюве змею — один из самых детализированных гербов на флагах.";
"FACT_19_TITLE" = "Флаг-копия";
"FACT_19_DESC" = "Флаг Монако и Индонезии почти идентичны — красная полоса сверху, белая снизу. Различие только в пропорциях.";
"FACT_20_TITLE" = "Флаг с 50 звёздами";
"FACT_20_DESC" = "На флаге США 50 звёзд, по одной на каждый штат. Дизайн флага менялся 27 раз с момента принятия в 1777 году.";
"FACT_21_TITLE" = "Самые северные флаги";
"FACT_21_DESC" = "В арктических регионах используются как государственные, так и региональные флаги с уникальной символикой.";
"FACT_22_TITLE" = "Флаг с крестом";
"FACT_22_DESC" = "29 стран мира имеют крест на своём флаге, что делает его одним из самых популярных символов на национальных флагах.";
"FACT_23_TITLE" = "Триколоры";
"FACT_23_DESC" = "Многие страны используют простой трёхполосный дизайн как исторически устойчивую форму флага.";
"FACT_24_TITLE" = "Флаг с полумесяцем";
"FACT_24_DESC" = "Полумесяц присутствует на флагах 12 стран, в основном мусульманских, символизируя исламскую веру.";
"FACT_25_TITLE" = "Символ солнца";
"FACT_25_DESC" = "Солнце — один из самых распространённых символов на флагах Азии и Южной Америки.";
"FACT_26_TITLE" = "Флаг с деревом";
"FACT_26_DESC" = "Ливан — единственная страна, на флаге которой изображено дерево (ливанский кедр), символизирующее вечность и мир.";
"FACT_27_TITLE" = "Самый узкий флаг";
"FACT_27_DESC" = "Флаг Катара имеет самое необычное соотношение сторон среди всех национальных флагов — 11:28.";
"FACT_28_TITLE" = "Сложные гербы";
"FACT_28_DESC" = "Гербы на флагах Латинской Америки часто включают много деталей и исторических символов.";
"FACT_29_TITLE" = "Флаг-радуга";
"FACT_29_DESC" = "Боливия имеет два официальных флага — традиционный трёхцветный и радужный флаг коренных народов Випала.";
"FACT_30_TITLE" = "Флаг с королевским символом";
"FACT_30_DESC" = "На флаге Камбоджи изображён храм Ангкор-Ват, что делает его единственным национальным флагом со зданием.";
"FACT_31_TITLE" = "Исторические споры";
"FACT_31_DESC" = "Дизайн некоторых флагов менялся из-за исторических и политических споров между странами.";
"FACT_32_TITLE" = "Флаг с мечом";
"FACT_32_DESC" = "На флаге Шри-Ланки изображён лев, держащий меч, что символизирует храбрость сингальского народа.";
"FACT_33_TITLE" = "Флаг без синего";
"FACT_33_DESC" = "Только 4 страны в мире не используют синий цвет на своих флагах: Ямайка, Мавритания, Шри-Ланка и Ватикан.";
"FACT_34_TITLE" = "Птицы на флагах";
"FACT_34_DESC" = "Орёл и другие птицы на флагах символизируют силу, независимость и высоту духа.";
"FACT_35_TITLE" = "Антарктический символ";
"FACT_35_DESC" = "У Антарктиды нет официального государственного флага, но используется несколько неофициальных вариантов.";
"FACT_36_TITLE" = "Звёзды на флагах";
"FACT_36_DESC" = "Звезда — один из самых распространённых символов на флагах по всему миру.";
"FACT_37_TITLE" = "Похожие цветовые схемы";
"FACT_37_DESC" = "Некоторые флаги похожи по цветам, но отличаются порядком полос и эмблемами.";
"FACT_38_TITLE" = "Флаги международных союзов";
"FACT_38_DESC" = "Наднациональные объединения тоже имеют свои флаги, которые отражают общие ценности участников.";
"FACT_39_TITLE" = "Островная символика";
"FACT_39_DESC" = "На флагах островных государств часто присутствуют символы океана, солнца и навигации.";
"FACT_40_TITLE" = "Изменения во времени";
"FACT_40_DESC" = "Некоторые национальные флаги менялись десятки раз вместе с политической историей страны.";
"FACT_41_TITLE" = "Солнце Северной Македонии";
"FACT_41_DESC" = "На флаге Северной Македонии изображено солнце с восемью лучами — символ нового начала.";
"FACT_42_TITLE" = "Люди на флаге Белиза";
"FACT_42_DESC" = "Флаг Белиза — один из немногих, на которых изображены люди: лесорубы с инструментами.";
