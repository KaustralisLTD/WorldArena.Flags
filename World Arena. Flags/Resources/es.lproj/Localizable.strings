/* 68 interesting facts */
"FACT_01_TITLE" = "Bandera nacional más antigua";
"FACT_01_DESC" = "El Dannebrog de Dinamarca se considera la bandera nacional en uso continuo más antigua desde 1219.";
"FACT_02_TITLE" = "Única bandera nacional cuadrada";
"FACT_02_DESC" = "Suiza tiene la única bandera nacional cuadrada del mundo. El Vaticano también tiene bandera cuadrada pero es una ciudad-estado.";
"FACT_03_TITLE" = "Bandera no rectangular";
"FACT_03_DESC" = "Nepal tiene la única bandera nacional del mundo que no es rectangular.";
"FACT_04_TITLE" = "Sin rojo, blanco ni azul";
"FACT_04_DESC" = "Jamaica es el único país con una bandera sin rojo, blanco ni azul.";
"FACT_05_TITLE" = "Bandera que nunca se iza a media asta";
"FACT_05_DESC" = "La bandera de Arabia Saudí nunca se iza a media asta por el texto sagrado.";
"FACT_06_TITLE" = "Bandera nacional joven";
"FACT_06_DESC" = "La bandera de Sudán del Sur se adoptó en 2011 tras la independencia.";
"FACT_07_TITLE" = "Bandera con AK-47";
"FACT_07_DESC" = "Mozambique es el único país cuya bandera muestra un arma moderna: el fusil Kalashnikov.";
"FACT_08_TITLE" = "Banderas casi idénticas";
"FACT_08_DESC" = "Las banderas de Rumanía y Chad son muy similares; se distinguen por el tono de azul.";
"FACT_09_TITLE" = "Simbolismo de Ucrania";
"FACT_09_DESC" = "La bandera azul y amarilla de Ucrania se interpreta tradicionalmente como el cielo sobre un campo de trigo.";
"FACT_10_TITLE" = "Bandera más simple";
"FACT_10_DESC" = "La bandera de Libia de 1977 a 2011 era solo verde sin símbolos ni motivos.";
"FACT_11_TITLE" = "Bandera con mapa";
"FACT_11_DESC" = "La bandera de Chipre muestra el contorno de la isla, un caso raro entre banderas nacionales.";
"FACT_12_TITLE" = "Bandera con Biblia";
"FACT_12_DESC" = "La bandera de República Dominicana muestra una Biblia abierta, la única bandera nacional con un libro religioso.";
"FACT_13_TITLE" = "Color más frecuente";
"FACT_13_DESC" = "El rojo es el color más común en las banderas nacionales del mundo.";
"FACT_14_TITLE" = "Bandera con texto";
"FACT_14_DESC" = "El texto en banderas nacionales es raro; un ejemplo conocido es Arabia Saudí.";
"FACT_15_TITLE" = "Protocolo de banderas";
"FACT_15_DESC" = "Muchos países tienen normas estrictas sobre el uso de la bandera nacional.";
"FACT_16_TITLE" = "Bandera con dos caras distintas";
"FACT_16_DESC" = "Paraguay tiene la única bandera nacional con diseños distintos en anverso y reverso.";
"FACT_17_TITLE" = "Simbolismo olímpico";
"FACT_17_DESC" = "Los colores de los anillos olímpicos se eligieron para que al menos uno figure en cada bandera nacional.";
"FACT_18_TITLE" = "Bandera con el escudo más complejo";
"FACT_18_DESC" = "La bandera de México muestra un águila sobre un cactus con una serpiente, uno de los escudos más detallados.";
"FACT_19_TITLE" = "Banderas copiadas";
"FACT_19_DESC" = "Las banderas de Mónaco e Indonesia son casi idénticas: rojo arriba, blanco abajo. Solo cambian las proporciones.";
"FACT_20_TITLE" = "Bandera con 50 estrellas";
"FACT_20_DESC" = "La bandera de EE. UU. tiene 50 estrellas, una por estado. El diseño ha cambiado 27 veces desde 1777.";
"FACT_21_TITLE" = "Banderas más al norte";
"FACT_21_DESC" = "Las regiones árticas usan banderas nacionales y regionales con simbolismo único.";
"FACT_22_TITLE" = "Bandera con cruz";
"FACT_22_DESC" = "29 países tienen una cruz en su bandera, uno de los símbolos más usados.";
"FACT_23_TITLE" = "Tricolores";
"FACT_23_DESC" = "Muchos países usan un diseño de tres franjas como forma histórica de bandera.";
"FACT_24_TITLE" = "Bandera con media luna";
"FACT_24_DESC" = "La media luna aparece en las banderas de 12 países, mayormente musulmanes, simbolizando la fe islámica.";
"FACT_25_TITLE" = "Símbolo del sol";
"FACT_25_DESC" = "El sol es uno de los símbolos más comunes en banderas de Asia y Sudamérica.";
"FACT_26_TITLE" = "Bandera con árbol";
"FACT_26_DESC" = "Líbano es el único país con un árbol (el cedro) en su bandera, simbolizando eternidad y paz.";
"FACT_27_TITLE" = "Bandera más estrecha";
"FACT_27_DESC" = "La bandera de Catar tiene la proporción más inusual entre banderas nacionales: 11:28.";
"FACT_28_TITLE" = "Escudos complejos";
"FACT_28_DESC" = "Los escudos en banderas latinoamericanas suelen tener muchos detalles y símbolos históricos.";
"FACT_29_TITLE" = "Bandera arcoíris";
"FACT_29_DESC" = "Bolivia tiene dos banderas oficiales: el tricolor tradicional y la Wiphala indígena.";
"FACT_30_TITLE" = "Bandera con edificio";
"FACT_30_DESC" = "La bandera de Camboya muestra el templo de Angkor Wat, la única bandera nacional con un edificio.";
"FACT_31_TITLE" = "Disputas históricas";
"FACT_31_DESC" = "El diseño de algunas banderas ha cambiado por disputas históricas y políticas.";
"FACT_32_TITLE" = "Bandera con espada";
"FACT_32_DESC" = "La bandera de Sri Lanka muestra un león con espada, simbolizando el valor del pueblo cingalés.";
"FACT_33_TITLE" = "Bandera sin azul";
"FACT_33_DESC" = "Solo cuatro países no usan azul en su bandera: Jamaica, Mauritania, Sri Lanka y Vaticano.";
"FACT_34_TITLE" = "Aves en banderas";
"FACT_34_DESC" = "El águila y otras aves en banderas simbolizan fuerza, independencia y nobleza.";
