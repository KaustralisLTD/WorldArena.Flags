/* 68 interesting facts */
"FACT_01_TITLE" = "伝説のある国旗";
"FACT_01_DESC" = "デンマーク国旗は、伝説では1219年の戦いと結び付けられています。";
"FACT_02_TITLE" = "正方形の国旗";
"FACT_02_DESC" = "スイスとバチカン市国の国旗は、どちらも正方形です。";
"FACT_03_TITLE" = "長方形ではない国旗";
"FACT_03_DESC" = "ネパールは世界で唯一、長方形ではない国旗を持っています。";
"FACT_04_TITLE" = "赤、白、青はありません";
"FACT_04_DESC" = "ジャマイカは、赤、白、青のない国旗を持つ唯一の国です。";
"FACT_05_TITLE" = "決して降ろされない旗";
"FACT_05_DESC" = "サウジアラビアの国旗は、神聖な文字が書かれているため、決して半旗で掲揚されることはありません。";
"FACT_06_TITLE" = "若い国旗";
"FACT_06_DESC" = "南スーダンは、2011年の独立以来、この国旗を使用しています。";
"FACT_07_TITLE" = "AK-47の旗";
"FACT_07_DESC" = "モザンビークは、現代兵器であるカラシニコフ銃を国旗に掲げている唯一の国です。";
"FACT_08_TITLE" = "よく似た国旗";
"FACT_08_DESC" = "ルーマニアとチャドの国旗は非常に似ています。通常、青色の色合いによって区別されます。";
"FACT_09_TITLE" = "ウクライナの象徴性";
"FACT_09_DESC" = "ウクライナの青と黄色の国旗は伝統的に小麦畑の上の空を表すと解釈されています。";
"FACT_10_TITLE" = "シンプルな国旗";
"FACT_10_DESC" = "1977年から2011年までのリビアの国旗は緑色一色で、シンボルや模様はなかった。";
"FACT_11_TITLE" = "地図付きの旗";
"FACT_11_DESC" = "キプロスの国旗には島の輪郭が描かれています。国旗としては珍しい例です。";
"FACT_12_TITLE" = "聖書のある旗";
"FACT_12_DESC" = "ドミニカ共和国の国旗には開かれた聖書が描かれており、宗教書が掲載されている唯一の国旗となっています。";
"FACT_13_TITLE" = "国旗に使われる赤";
"FACT_13_DESC" = "赤は、カナダ、日本、スイスなど、多くの国の国旗に使われています。";
"FACT_14_TITLE" = "文字が書かれた国旗";
"FACT_14_DESC" = "国旗に文字が描かれることはまれです。よく知られた例の 1 つはサウジアラビアです。";
"FACT_15_TITLE" = "旗のエチケット";
"FACT_15_DESC" = "多くの国には、国旗の扱いについて厳格な規則があります。";
"FACT_16_TITLE" = "表と裏で異なる国旗";
"FACT_16_DESC" = "パラグアイには、表と裏でデザインが異なる世界で唯一の国旗があります。";
"FACT_17_TITLE" = "オリンピックの象徴性";
"FACT_17_DESC" = "オリンピックの5つの輪と白い背景には、世界の国々の国旗を表すために選ばれた6色が使われています。";
"FACT_18_TITLE" = "メキシコの国章";
"FACT_18_DESC" = "メキシコの国旗には、サボテンの上で蛇をつかむワシが描かれています。";
"FACT_19_TITLE" = "よく似た赤と白の国旗";
"FACT_19_DESC" = "モナコとインドネシアの国旗はどちらも上が赤、下が白ですが、縦横比が異なります。";
"FACT_20_TITLE" = "50 個の星が付いた旗";
"FACT_20_DESC" = "アメリカ合衆国の国旗には50個の星があり、各州を一つずつ表しています。";
"FACT_21_TITLE" = "最北端の旗";
"FACT_21_DESC" = "北極地域では、独自の象徴性を持つ国旗と地域旗の両方が使用されます。";
"FACT_22_TITLE" = "十字の旗";
"FACT_22_DESC" = "デンマーク、フィンランド、スイスなど、多くの国の国旗に十字が描かれています。";
"FACT_23_TITLE" = "トリコロール";
"FACT_23_DESC" = "多くの国は、歴史的に安定した国旗の形として、シンプルな 3 本のストライプのデザインを使用しています。";
"FACT_24_TITLE" = "三日月の旗";
"FACT_24_DESC" = "トルコ、パキスタン、チュニジアなど、いくつかの国の国旗に三日月が描かれています。";
"FACT_25_TITLE" = "太陽のシンボル";
"FACT_25_DESC" = "太陽は、アジアと南米の国旗で最も一般的なシンボルの 1 つです。";
"FACT_26_TITLE" = "木の付いた旗";
"FACT_26_DESC" = "レバノンの国旗には杉の木が描かれています。";
"FACT_27_TITLE" = "カタール国旗の縦横比";
"FACT_27_DESC" = "カタール国旗の縦と横の比率は11対28です。";
"FACT_28_TITLE" = "複雑な紋章";
"FACT_28_DESC" = "ラテンアメリカの国旗の国章には、多くの詳細や歴史的シンボルが含まれていることがよくあります。";
"FACT_29_TITLE" = "レインボーフラッグ";
"FACT_29_DESC" = "ボリビアには、伝統的な三色旗と先住民族のウィファラの虹色の旗という 2 つの公式の国旗があります。";
"FACT_30_TITLE" = "建物のある旗";
"FACT_30_DESC" = "カンボジアの国旗にはアンコールワット寺院が描かれています。";
"FACT_31_TITLE" = "歴史論争";
"FACT_31_DESC" = "国家間の歴史的、政治的紛争により、一部の国旗のデザインが変更されました。";
"FACT_32_TITLE" = "剣を持った旗";
"FACT_32_DESC" = "スリランカの国旗には剣を持ったライオンが描かれており、シンハラ人の勇気を象徴しています。";
"FACT_33_TITLE" = "青のない旗";
"FACT_33_DESC" = "ジャマイカ、日本、スイスなど、青を使っていない国旗もあります。";
"FACT_34_TITLE" = "旗の上の鳥";
"FACT_34_DESC" = "旗に描かれているワシやその他の鳥は、強さ、独立心、そして精神の高貴さを象徴しています。";
"FACT_35_TITLE" = "南極のシンボル";
"FACT_35_DESC" = "南極には公式の国旗はありませんが、いくつかの非公式のデザインが使用されています。";
"FACT_36_TITLE" = "旗の星";
"FACT_36_DESC" = "星は、世界中の国旗で最も広く使われているシンボルの 1 つです。";
"FACT_37_TITLE" = "同様の配色";
"FACT_37_DESC" = "いくつかの旗は色は似ていますが、ストライプとエンブレムの順序が異なります。";
"FACT_38_TITLE" = "国際組織の旗";
"FACT_38_DESC" = "超国家組織には、共通の価値観を反映した独自の旗もあります。";
"FACT_39_TITLE" = "島の象徴性";
"FACT_39_DESC" = "島国の国旗には、海、太陽、航海のシンボルが描かれていることがよくあります。";
"FACT_40_TITLE" = "時間の経過による変化";
"FACT_40_DESC" = "国旗の中には、その国の政治の歴史に応じて何十回も変更されてきたものもあります。";
"FACT_41_TITLE" = "北マケドニアの太陽";
"FACT_41_DESC" = "北マケドニアの国旗には、新たな始まりを表す 8 つの光線を持つ太陽が描かれています。";
"FACT_42_TITLE" = "ベリーズの木こり";
"FACT_42_DESC" = "ベリーズの国旗には、道具を持った木こりが描かれています。人物の描かれた数少ない国旗の一つです。";
"FACT_43_TITLE" = "エクアドルコンドル";
"FACT_43_DESC" = "エクアドルの国旗には、強さと主権を表すアンデスのコンドルが描かれています。";
"FACT_44_TITLE" = "ボリビア ウィファラ";
"FACT_44_DESC" = "ボリビアは公式シンボルとしてトリコロールと並んでウィファラを使用しています。";
"FACT_45_TITLE" = "ブラジルの27の星";
"FACT_45_DESC" = "ブラジルの国旗には 27 個の星があり、それぞれの州と連邦区に 1 つずつ付いています。";
"FACT_46_TITLE" = "カエデの葉";
"FACT_46_DESC" = "カナダの国旗には、白い正方形の中に先端が11個ある赤いカエデの葉が描かれています。";
"FACT_47_TITLE" = "ユニオンジャック";
"FACT_47_DESC" = "イギリスの国旗は、聖ジョージ、聖アンドリュー、聖パトリックの十字を組み合わせています。";
"FACT_48_TITLE" = "日本の日の出";
"FACT_48_DESC" = "日本の国旗は、白地に太陽を表す赤い円が描かれています。";
"FACT_49_TITLE" = "アショカ チャクラ";
"FACT_49_DESC" = "インドの国旗には 24 本のスポークの車輪があり、法と運動を象徴しています。";
"FACT_50_TITLE" = "オーストラリアの南十字星";
"FACT_50_DESC" = "オーストラリア国旗の5つの星は、南十字星を表しています。";
"FACT_51_TITLE" = "ニュージーランドの南十字星";
"FACT_51_DESC" = "ニュージーランドの国旗にも南十字星が描かれていますが、赤い星が白で縁取られています。";
"FACT_52_TITLE" = "韓国の太極";
"FACT_52_DESC" = "韓国の国旗には、伝統的な太極（陰陽）のシンボルと卦が描かれています。";
"FACT_53_TITLE" = "ポルトガルの天球儀";
"FACT_53_DESC" = "ポルトガルの国旗には古代の航海器具である天球儀が描かれています。";
"FACT_54_TITLE" = "アルバニアの双頭の鷲";
"FACT_54_DESC" = "アルバニアの国旗には主権の象徴である黒い双頭の鷲が描かれています。";
"FACT_55_TITLE" = "ケニアの盾";
"FACT_55_DESC" = "ケニアの国旗にはマサイ族の盾と交差した槍が描かれています。";
"FACT_56_TITLE" = "ウェールズのドラゴン";
"FACT_56_DESC" = "ウェールズの旗には、白と緑の背景に赤い竜が描かれています。このデザインは1959年に正式に認められました。";
"FACT_57_TITLE" = "セントアンドリュースの十字架";
"FACT_57_DESC" = "スコットランドの国旗は青地に白の斜め十字、セント・アンドリューの十字架です。";
"FACT_58_TITLE" = "グリーンランドのサークル";
"FACT_58_DESC" = "グリーンランドの国旗には、氷の上の太陽を表す赤と白の円が描かれています。";
"FACT_59_TITLE" = "汎アフリカの色";
"FACT_59_DESC" = "緑、黄、赤は汎アフリカ色と呼ばれ、多くのアフリカの国旗に使用されています。";
"FACT_60_TITLE" = "ノルディッククロス";
"FACT_60_DESC" = "デンマーク、ノルウェー、スウェーデン、フィンランド、アイスランドの 5 か国が北欧十字を使用しています。";
"FACT_61_TITLE" = "フレンチトリコロール";
"FACT_61_DESC" = "フランスの青白赤の三色旗は、多くの革命旗や国旗のモデルとなりました。";
"FACT_62_TITLE" = "国連の旗";
"FACT_62_DESC" = "国連の旗は、青い背景にオリーブの枝に囲まれた世界を示しています。";
"FACT_63_TITLE" = "EUの旗";
"FACT_63_DESC" = "青地に円形に並んだ12個の金色の星は、欧州連合の団結を象徴しています。";
"FACT_64_TITLE" = "オリンピック旗";
"FACT_64_DESC" = "白地に描かれたオリンピックの五輪は、五大陸の結び付きと世界中の選手を象徴しています。";
"FACT_65_TITLE" = "バチカンの正方形の国旗";
"FACT_65_DESC" = "バチカンにはスイスと同じように四角い国旗があります。";
"FACT_66_TITLE" = "ナウルの12芒星";
"FACT_66_DESC" = "ナウルの国旗には12部族を表す12芒星が描かれています。";
"FACT_67_TITLE" = "トルクメニスタンのカーペット";
"FACT_67_DESC" = "トルクメニスタンの国旗には、旗ざお側にじゅうたんの模様が描かれています。";
"FACT_68_TITLE" = "アフガニスタンのモスク";
"FACT_68_DESC" = "アフガニスタンでは、モスクを描いた国旗が使われたことがあります。";

