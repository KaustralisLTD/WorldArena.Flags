/* 68 interesting facts */
"FACT_01_TITLE" = "Η παλαιότερη σημαία που χρησιμοποιείται συνεχώς";
"FACT_01_DESC" = "Η Dannebrog της Δανίας θεωρείται η παλαιότερη εθνική σημαία σε συνεχή χρήση από το 1219.";
"FACT_02_TITLE" = "Μόνο τετράγωνη εθνική σημαία";
"FACT_02_DESC" = "Η Ελβετία έχει τη μοναδική τετράγωνη εθνική σημαία στον κόσμο. Το Βατικανό έχει επίσης τετράγωνη σημαία αλλά είναι πόλη-κράτος.";
"FACT_03_TITLE" = "Μη ορθογώνια σημαία";
"FACT_03_DESC" = "Το Νεπάλ έχει τη μοναδική εθνική σημαία στον κόσμο που δεν είναι ορθογώνια.";
"FACT_04_TITLE" = "Χωρίς κόκκινο, λευκό ή μπλε";
"FACT_04_DESC" = "Η Τζαμάικα είναι η μόνη χώρα με σημαία χωρίς κόκκινο, λευκό ή μπλε.";
"FACT_05_TITLE" = "Σημαία που δεν κατεβαίνει ποτέ";
"FACT_05_DESC" = "Η σημαία της Σαουδικής Αραβίας δεν κυματίζει ποτέ μεσίστιη λόγω του ιερού κειμένου που υπάρχει πάνω της.";
"FACT_06_TITLE" = "Νέα εθνική σημαία";
"FACT_06_DESC" = "Η σημαία του Νοτίου Σουδάν υιοθετήθηκε το 2011 μετά την ανεξαρτησία.";
"FACT_07_TITLE" = "Σημαία με AK-47";
"FACT_07_DESC" = "Η Μοζαμβίκη είναι η μόνη χώρα της οποίας η σημαία φέρει ένα σύγχρονο όπλο—το τουφέκι Καλάσνικοφ.";
"FACT_08_TITLE" = "Σχεδόν πανομοιότυπες σημαίες";
"FACT_08_DESC" = "Οι σημαίες της Ρουμανίας και του Τσαντ είναι πολύ παρόμοιες. συνήθως διακρίνονται από την απόχρωση του μπλε.";
"FACT_09_TITLE" = "Ο συμβολισμός της Ουκρανίας";
"FACT_09_DESC" = "Η μπλε και η κίτρινη σημαία της Ουκρανίας ερμηνεύεται παραδοσιακά ως ο ουρανός πάνω από ένα χωράφι με σιτάρι.";
"FACT_10_TITLE" = "Η πιο απλή σημαία";
"FACT_10_DESC" = "Η σημαία της Λιβύης από το 1977 έως το 2011 ήταν πράσινη χωρίς σύμβολα ή σχέδια.";
"FACT_11_TITLE" = "Σημαία με χάρτη";
"FACT_11_DESC" = "Η σημαία της Κύπρου δείχνει το περίγραμμα του νησιού—μια σπάνια περίπτωση μεταξύ των εθνικών σημαιών.";
"FACT_12_TITLE" = "Σημαία με μια Βίβλο";
"FACT_12_DESC" = "Η σημαία της Δομινικανής Δημοκρατίας δείχνει μια ανοιχτή Βίβλο, καθιστώντας την τη μοναδική εθνική σημαία με θρησκευτικό βιβλίο.";
"FACT_13_TITLE" = "Το πιο δημοφιλές χρώμα";
"FACT_13_DESC" = "Το κόκκινο είναι το πιο κοινό χρώμα στις εθνικές σημαίες παγκοσμίως.";
"FACT_14_TITLE" = "Σημαία με κείμενο";
"FACT_14_DESC" = "Το κείμενο στις εθνικές σημαίες είναι σπάνιο. ένα πολύ γνωστό παράδειγμα είναι η Σαουδική Αραβία.";
"FACT_15_TITLE" = "Εθιμοτυπία σημαίας";
"FACT_15_DESC" = "Πολλές χώρες έχουν αυστηρούς κανόνες για τον τρόπο αντιμετώπισης της εθνικής σημαίας.";
"FACT_16_TITLE" = "Σημαία με διαφορετικές πλευρές";
"FACT_16_DESC" = "Η Παραγουάη έχει τη μοναδική εθνική σημαία στον κόσμο με διαφορετικά σχέδια στην εμπρός και πίσω όψη.";
"FACT_17_TITLE" = "Ολυμπιακός συμβολισμός";
"FACT_17_DESC" = "Τα χρώματα των Ολυμπιακών δαχτυλιδιών επιλέχθηκαν έτσι ώστε τουλάχιστον ένα χρώμα να εμφανίζεται στη σημαία κάθε χώρας.";
"FACT_18_TITLE" = "Σημαία με το πιο περίπλοκο οικόσημο";
"FACT_18_DESC" = "Η σημαία του Μεξικού δείχνει έναν αετό σκαρφαλωμένο σε έναν κάκτο που κρατά ένα φίδι - ένα από τα πιο λεπτομερή οικόσημα σε οποιαδήποτε σημαία.";
"FACT_19_TITLE" = "Σημαία αντιγραφής";
"FACT_19_DESC" = "Οι σημαίες του Μονακό και της Ινδονησίας είναι σχεδόν πανομοιότυπες—κόκκινες στην κορυφή, λευκές κάτω. Η μόνη διαφορά είναι οι αναλογίες.";
"FACT_20_TITLE" = "Σημαία με 50 αστέρια";
"FACT_20_DESC" = "Η σημαία των ΗΠΑ έχει 50 αστέρια, ένα για κάθε πολιτεία. Το σχέδιο έχει αλλάξει 27 φορές από το 1777.";
"FACT_21_TITLE" = "Οι βορειότερες σημαίες";
"FACT_21_DESC" = "Οι περιοχές της Αρκτικής χρησιμοποιούν εθνικές και περιφερειακές σημαίες με μοναδικό συμβολισμό.";
"FACT_22_TITLE" = "Σημαία με σταυρό";
"FACT_22_DESC" = "29 χώρες έχουν ένα σταυρό στη σημαία τους, καθιστώντας το ένα από τα πιο δημοφιλή σύμβολα στις εθνικές σημαίες.";
"FACT_23_TITLE" = "Τρίχρωμα";
"FACT_23_DESC" = "Πολλές χώρες χρησιμοποιούν ένα απλό σχέδιο με τρεις λωρίδες ως ιστορικά σταθερή μορφή σημαίας.";
"FACT_24_TITLE" = "Σημαία με ημισέληνο";
"FACT_24_DESC" = "Η ημισέληνος εμφανίζεται στις σημαίες 12 χωρών, κυρίως μουσουλμανικών, συμβολίζοντας την ισλαμική πίστη.";
"FACT_25_TITLE" = "σύμβολο του ήλιου";
"FACT_25_DESC" = "Ο ήλιος είναι ένα από τα πιο κοινά σύμβολα στις σημαίες στην Ασία και τη Νότια Αμερική.";
"FACT_26_TITLE" = "Σημαία με ένα δέντρο";
"FACT_26_DESC" = "Ο Λίβανος είναι η μόνη χώρα με ένα δέντρο (τον λιβανέζικο κέδρο) στη σημαία του, που συμβολίζει την αιωνιότητα και την ειρήνη.";
"FACT_27_TITLE" = "Η πιο στενή σημαία";
"FACT_27_DESC" = "Η σημαία του Κατάρ έχει την πιο ασυνήθιστη αναλογία διαστάσεων από οποιαδήποτε εθνική σημαία—11:28.";
"FACT_28_TITLE" = "Σύνθετα οικόσημα";
"FACT_28_DESC" = "Τα οικόσημα στις σημαίες της Λατινικής Αμερικής συχνά περιλαμβάνουν πολλές λεπτομέρειες και ιστορικά σύμβολα.";
"FACT_29_TITLE" = "Σημαία του ουράνιου τόξου";
"FACT_29_DESC" = "Η Βολιβία έχει δύο επίσημες σημαίες—την παραδοσιακή τρίχρωμη και την ιθαγενή σημαία του ουράνιου τόξου Wiphala.";
"FACT_30_TITLE" = "Σημαία με ένα κτίριο";
"FACT_30_DESC" = "Η σημαία της Καμπότζης δείχνει τον ναό Angkor Wat, καθιστώντας τον τη μοναδική εθνική σημαία με κτίριο.";
"FACT_31_TITLE" = "Ιστορικές διαμάχες";
"FACT_31_DESC" = "Ο σχεδιασμός ορισμένων σημαιών έχει αλλάξει λόγω ιστορικών και πολιτικών διαφορών μεταξύ των χωρών.";
"FACT_32_TITLE" = "Σημαία με σπαθί";
"FACT_32_DESC" = "Η σημαία της Σρι Λάνκα δείχνει ένα λιοντάρι να κρατά ένα σπαθί, που συμβολίζει το θάρρος του Σινχαλέζικου λαού.";
"FACT_33_TITLE" = "Σημαία χωρίς μπλε";
"FACT_33_DESC" = "Μόνο τέσσερις χώρες δεν χρησιμοποιούν μπλε στις σημαίες τους: Τζαμάικα, Μαυριτανία, Σρι Λάνκα και Βατικανό.";
"FACT_34_TITLE" = "Πουλιά σε σημαίες";
"FACT_34_DESC" = "Ο αετός και άλλα πουλιά στις σημαίες συμβολίζουν τη δύναμη, την ανεξαρτησία και την αρχοντιά του πνεύματος.";
"FACT_35_TITLE" = "Σύμβολο της Ανταρκτικής";
"FACT_35_DESC" = "Η Ανταρκτική δεν έχει επίσημη εθνική σημαία, αλλά χρησιμοποιούνται αρκετά ανεπίσημα σχέδια.";
"FACT_36_TITLE" = "Αστέρια στις σημαίες";
"FACT_36_DESC" = "Το αστέρι είναι ένα από τα πιο διαδεδομένα σύμβολα στις σημαίες σε όλο τον κόσμο.";
"FACT_37_TITLE" = "Παρόμοιοι χρωματικοί συνδυασμοί";
"FACT_37_DESC" = "Ορισμένες σημαίες είναι παρόμοιες στο χρώμα αλλά διαφέρουν ως προς τη σειρά των λωρίδων και των εμβλημάτων.";
"FACT_38_TITLE" = "Σημαίες της διεθνούς ένωσης";
"FACT_38_DESC" = "Οι υπερεθνικοί οργανισμοί έχουν επίσης τις δικές τους σημαίες που αντικατοπτρίζουν κοινές αξίες.";
"FACT_39_TITLE" = "Ο συμβολισμός του νησιού";
"FACT_39_DESC" = "Οι σημαίες των νησιωτικών εθνών συχνά περιέχουν σύμβολα του ωκεανού, του ήλιου και της ναυσιπλοΐας.";
"FACT_40_TITLE" = "Αλλαγές με την πάροδο του χρόνου";
"FACT_40_DESC" = "Ορισμένες εθνικές σημαίες έχουν αλλάξει δεκάδες φορές με την πολιτική ιστορία της χώρας τους.";
"FACT_41_TITLE" = "Ήλιος Βόρειας Μακεδονίας";
"FACT_41_DESC" = "Η σημαία της Βόρειας Μακεδονίας έχει έναν ήλιο με οκτώ ακτίνες για μια νέα αρχή.";
"FACT_42_TITLE" = "Ξυλοκόποι της Μπελίζ";
"FACT_42_DESC" = "Η σημαία της Μπελίζ είναι από τις λίγες που δείχνουν ανθρώπους: ξυλοκόπους με εργαλεία.";
"FACT_43_TITLE" = "Κόνδορας του Εκουαδόρ";
"FACT_43_DESC" = "Η σημαία του Ισημερινού περιλαμβάνει τον κόνδορα των Άνδεων για δύναμη και κυριαρχία.";
"FACT_44_TITLE" = "Βολιβία Wiphala";
"FACT_44_DESC" = "Η Βολιβία χρησιμοποιεί το Wiphala μαζί με το τρίχρωμο ως επίσημο σύμβολο.";
"FACT_45_TITLE" = "Τα 27 αστέρια της Βραζιλίας";
"FACT_45_DESC" = "Η βραζιλιάνικη σημαία έχει 27 αστέρια, ένα για κάθε πολιτεία και την ομοσπονδιακή περιφέρεια.";
"FACT_46_TITLE" = "Φύλλο σφενδάμου";
"FACT_46_DESC" = "Η σημαία του Καναδά διαθέτει ένα μόνο φύλλο σφενδάμου 11 ακτίνων, μοναδικό μεταξύ των εθνικών σημαιών.";
"FACT_47_TITLE" = "αγγλική σημαία";
"FACT_47_DESC" = "Η σημαία του Ηνωμένου Βασιλείου συνδυάζει τους σταυρούς τριών αγίων: της Αγγλίας, της Σκωτίας και της Ιρλανδίας.";
"FACT_48_TITLE" = "Ο ανατέλλοντος ήλιος της Ιαπωνίας";
"FACT_48_DESC" = "Ο κόκκινος κύκλος στο λευκό αντιπροσωπεύει τον ανατέλλοντα ήλιο και χρησιμοποιείται στη σημαία της Ιαπωνίας από τον 7ο αιώνα.";
"FACT_49_TITLE" = "Ασόκα Τσάκρα";
"FACT_49_DESC" = "Η σημαία της Ινδίας διαθέτει έναν τροχό 24 ακτίνων, που συμβολίζει το νόμο και την κίνηση.";
"FACT_50_TITLE" = "Σταυρός του Νότου της Αυστραλίας";
"FACT_50_DESC" = "Η σημαία της Αυστραλίας δείχνει τον αστερισμό του Νότιου Σταυρού, ορατός μόνο στο Νότιο Ημισφαίριο.";
"FACT_51_TITLE" = "Νότιος Σταυρός της Νέας Ζηλανδίας";
"FACT_51_DESC" = "Στη σημαία της Νέας Ζηλανδίας απεικονίζεται επίσης ο Σταυρός του Νότου, αλλά με κόκκινα αστέρια με λευκό χρώμα.";
"FACT_52_TITLE" = "Taegeuk της Νότιας Κορέας";
"FACT_52_DESC" = "Η σημαία της Νότιας Κορέας διαθέτει το παραδοσιακό σύμβολο taegeuk (yin-yang) και τρίγραμμα.";
"FACT_53_TITLE" = "στρατιωτική σφαίρα της Πορτογαλίας";
"FACT_53_DESC" = "Η σημαία της Πορτογαλίας διαθέτει μια οπλική σφαίρα, ένα αρχαίο όργανο ναυσιπλοΐας.";
"FACT_54_TITLE" = "Ο δικέφαλος αετός της Αλβανίας";
"FACT_54_DESC" = "Η σημαία της Αλβανίας δείχνει έναν μαύρο δικέφαλο αετό, σύμβολο της κυριαρχίας.";
"FACT_55_TITLE" = "Η ασπίδα της Κένυας";
"FACT_55_DESC" = "Η σημαία της Κένυας διαθέτει ασπίδα Μασάι και σταυρωμένα δόρατα.";
"FACT_56_TITLE" = "Ο δράκος της Ουαλίας";
"FACT_56_DESC" = "Ο κόκκινος δράκος στη σημαία της Ουαλίας είναι ένα από τα παλαιότερα εθνικά σύμβολα στον κόσμο.";
"FACT_57_TITLE" = "Σταυρός του Αγίου Ανδρέα";
"FACT_57_DESC" = "Η σημαία της Σκωτίας είναι ένας λευκός διαγώνιος σταυρός σε μπλε, ο σταυρός του Αγίου Ανδρέα.";
"FACT_58_TITLE" = "Ο κύκλος της Γροιλανδίας";
"FACT_58_DESC" = "Η σημαία της Γροιλανδίας έχει έναν ερυθρόλευκο κύκλο που αντιπροσωπεύει τον ήλιο πάνω από τον πάγο.";
"FACT_59_TITLE" = "Παναφρικανικά χρώματα";
"FACT_59_DESC" = "Το πράσινο, το κίτρινο και το κόκκινο ονομάζονται συχνά παναφρικανικά χρώματα και εμφανίζονται σε πολλές αφρικανικές σημαίες.";
"FACT_60_TITLE" = "Σκανδιναβικοί σταυροί";
"FACT_60_DESC" = "Πέντε χώρες χρησιμοποιούν τον σκανδιναβικό σταυρό: η Δανία, η Νορβηγία, η Σουηδία, η Φινλανδία και η Ισλανδία.";
"FACT_61_TITLE" = "Γαλλικό τρίχρωμο";
"FACT_61_DESC" = "Το γαλλικό μπλε-λευκό-κόκκινο τρίχρωμο έγινε πρότυπο για πολλές επαναστατικές και εθνικές σημαίες.";
"FACT_62_TITLE" = "Σημαία του ΟΗΕ";
"FACT_62_DESC" = "Η σημαία του ΟΗΕ δείχνει τον κόσμο να περιβάλλεται από κλαδιά ελιάς σε μπλε φόντο.";
"FACT_63_TITLE" = "Σημαία της ΕΕ";
"FACT_63_DESC" = "Δώδεκα χρυσά αστέρια σε κύκλο στο μπλε συμβολίζουν την ενότητα της Ευρωπαϊκής Ένωσης.";
"FACT_64_TITLE" = "Ολυμπιακή σημαία";
"FACT_64_DESC" = "Τα πέντε δαχτυλίδια στο λευκό αντιπροσωπεύουν τις πέντε κατοικημένες ηπείρους και την παγκόσμια φύση των Αγώνων.";
"FACT_65_TITLE" = "Πλατεία Βατικανού";
"FACT_65_DESC" = "Το Βατικανό έχει μια τετράγωνη εθνική σημαία όπως η Ελβετία.";
"FACT_66_TITLE" = "Ναούρου 12 βαθμοί";
"FACT_66_DESC" = "Η σημαία του Ναούρου έχει ένα αστέρι 12 ακτίνων για τις 12 φυλές.";
"FACT_67_TITLE" = "Χαλί του Τουρκμενιστάν";
"FACT_67_DESC" = "Η σημαία του Τουρκμενιστάν έχει σχέδια με χαλιά κατά μήκος της ανύψωσης.";
"FACT_68_TITLE" = "Τζαμί στο Αφγανιστάν";
"FACT_68_DESC" = "Η σημαία του Αφγανιστάν έχει ένα τζαμί στο σχέδιό της.";

