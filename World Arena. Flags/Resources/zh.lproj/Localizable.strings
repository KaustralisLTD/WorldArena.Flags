"FACT_21_DESC" = "北极地区使用具有独特象征意义的国家和地区旗帜。";
"FACT_22_TITLE" = "带十字的国旗";
"FACT_22_DESC" = "29个国家国旗上有十字，是最常见的符号之一。";
"FACT_23_TITLE" = "三色旗";
"FACT_23_DESC" = "许多国家采用简单的三条纹设计作为历史上稳定的旗帜形式。";
"FACT_24_TITLE" = "带新月的国旗";
"FACT_24_DESC" = "新月出现在12国国旗上，多为穆斯林国家，象征伊斯兰信仰。";
"FACT_25_TITLE" = "太阳象征";
"FACT_25_DESC" = "太阳是亚洲和南美国旗上最常见的符号之一。";
"FACT_26_TITLE" = "带树的国旗";
"FACT_26_DESC" = "黎巴嫩是唯一国旗上有树（黎巴嫩雪松）的国家，象征永恒与和平。";
"FACT_27_TITLE" = "最窄的国旗";
"FACT_27_DESC" = "卡塔尔国旗的宽高比在所有国旗中最特别——11:28。";
"FACT_28_TITLE" = "复杂徽章";
"FACT_28_DESC" = "拉丁美洲国旗上的徽章常包含大量细节和历史符号。";
"FACT_29_TITLE" = "彩虹旗";
"FACT_29_DESC" = "玻利维亚有两面官方旗帜——传统三色旗与土著维帕拉彩虹旗。";
"FACT_30_TITLE" = "带建筑的国旗";
"FACT_30_DESC" = "柬埔寨国旗上有吴哥窟，是唯一带建筑的国旗。";
"FACT_31_TITLE" = "历史争议";
"FACT_31_DESC" = "部分国旗设计因历史与政治争议而改变。";
"FACT_32_TITLE" = "带剑的国旗";
"FACT_32_DESC" = "斯里兰卡国旗上有持剑狮子，象征僧伽罗人的勇气。";
"FACT_33_TITLE" = "无蓝色的国旗";
"FACT_33_DESC" = "仅四国国旗不用蓝色：牙买加、毛里塔尼亚、斯里兰卡和梵蒂冈。";
"FACT_34_TITLE" = "国旗上的鸟";
"FACT_34_DESC" = "鹰及其他鸟类在国旗上象征力量、独立与高贵。";
"FACT_35_TITLE" = "南极象征";
"FACT_35_DESC" = "南极洲没有官方国旗，但存在多种非官方设计。";
"FACT_36_TITLE" = "国旗上的星";
"FACT_36_DESC" = "星是全世界国旗上最普遍的符号之一。";
"FACT_37_TITLE" = "相似配色";
"FACT_37_DESC" = "部分国旗颜色相近但条纹顺序与徽章不同。";
"FACT_38_TITLE" = "国际组织旗帜";
"FACT_38_DESC" = "超国家组织也有反映共同价值的旗帜。";
"FACT_39_TITLE" = "岛屿象征";
"FACT_39_DESC" = "岛国国旗常出现海洋、太阳与航海符号。";
"FACT_40_TITLE" = "随时间变化";
"FACT_40_DESC" = "部分国旗随国家政治史变更过数十次。";
"FACT_41_TITLE" = "北马其顿太阳";
"FACT_41_DESC" = "北马其顿国旗上有八道光芒的太阳，象征新的开始。";
"FACT_42_TITLE" = "伯利兹伐木工";
"FACT_42_DESC" = "伯利兹国旗是少数出现人物的国旗之一：持工具的伐木工。";
"FACT_43_TITLE" = "厄瓜多尔神鹰";
"FACT_43_DESC" = "厄瓜多尔国旗上有安第斯神鹰，象征力量与主权。";
"FACT_44_TITLE" = "玻利维亚双旗";
"FACT_44_DESC" = "玻利维亚将维帕拉与三色旗并列为官方象征。";
"FACT_45_TITLE" = "巴西27星";
"FACT_45_DESC" = "巴西国旗有27颗星，每州和联邦区各一。";
"FACT_46_TITLE" = "枫叶";
"FACT_46_DESC" = "加拿大国旗上有唯一的11角枫叶，在各国国旗中独有。";
"FACT_47_TITLE" = "米字旗";
"FACT_47_DESC" = "英国国旗融合了三个圣徒的十字：英格兰、苏格兰与爱尔兰。";
"FACT_48_TITLE" = "日本旭日";
"FACT_48_DESC" = "白底上的红圈代表旭日，日本自7世纪起使用。";
"FACT_49_TITLE" = "阿育王法轮";
"FACT_49_DESC" = "印度国旗上有24辐法轮，象征法与动。";
"FACT_50_TITLE" = "澳大利亚南十字";
"FACT_50_DESC" = "澳大利亚国旗上有南十字星座，仅在南半球可见。";
"FACT_51_TITLE" = "新西兰南十字";
"FACT_51_DESC" = "新西兰国旗也有南十字，但为红星白边。";
"FACT_52_TITLE" = "韩国太极";
"FACT_52_DESC" = "韩国国旗上有传统太极（阴阳）与八卦。";
"FACT_53_TITLE" = "葡萄牙浑天仪";
"FACT_53_DESC" = "葡萄牙国旗上有浑天仪，古代航海仪器。";
"FACT_54_TITLE" = "阿尔巴尼亚双头鹰";
"FACT_54_DESC" = "阿尔巴尼亚国旗上有黑色双头鹰，象征主权。";
"FACT_55_TITLE" = "肯尼亚盾";
"FACT_55_DESC" = "肯尼亚国旗上有马赛盾与交叉长矛。";
"FACT_56_TITLE" = "威尔士红龙";
"FACT_56_DESC" = "威尔士红龙是世界上最古老的国家象征之一。";
"FACT_57_TITLE" = "圣安德烈十字";
"FACT_57_DESC" = "苏格兰国旗为蓝底白斜十字，即圣安德烈十字。";
"FACT_58_TITLE" = "格陵兰圆";
"FACT_58_DESC" = "格陵兰国旗上有红白圆，象征冰原上的太阳。";
"FACT_59_TITLE" = "泛非色彩";
"FACT_59_DESC" = "绿、黄、红常被称为泛非色，出现在许多非洲国旗上。";
"FACT_60_TITLE" = "北欧十字";
"FACT_60_DESC" = "五国使用北欧十字：丹麦、挪威、瑞典、芬兰与冰岛。";
"FACT_61_TITLE" = "法国三色";
"FACT_61_DESC" = "法国蓝白红三色旗成为许多革命与民族旗帜的范本。";
"FACT_62_TITLE" = "联合国旗";
"FACT_62_DESC" = "联合国旗为蓝底上地球与橄榄枝。";
"FACT_63_TITLE" = "欧盟旗";
"FACT_63_DESC" = "蓝底上12颗金星成环，象征欧盟团结。";
"FACT_64_TITLE" = "奥运旗";
"FACT_64_DESC" = "白底五环代表五大洲与奥运的全球性。";
"FACT_65_TITLE" = "梵蒂冈方旗";
"FACT_65_DESC" = "梵蒂冈与瑞士一样使用正方形国旗。";
"FACT_66_TITLE" = "瑙鲁12芒";
"FACT_66_DESC" = "瑙鲁国旗上有12芒星，代表岛上12个部落。";
"FACT_67_TITLE" = "土库曼地毯纹";
"FACT_67_DESC" = "土库曼斯坦国旗沿旗杆一侧有传统地毯图案。";
"FACT_68_TITLE" = "阿富汗清真寺";
"FACT_68_DESC" = "阿富汗国旗在不同时期曾出现清真寺图案。";

