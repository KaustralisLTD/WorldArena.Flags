/* 68 interesting facts */
"FACT_01_TITLE" = "सबसे पुराना लगातार इस्तेमाल किया जाने वाला झंडा";
"FACT_01_DESC" = "डेनमार्क के डैनब्रोग को 1219 से लगातार उपयोग में आने वाला सबसे पुराना राष्ट्रीय ध्वज माना जाता है।";
"FACT_02_TITLE" = "केवल चौकोर राष्ट्रीय ध्वज";
"FACT_02_DESC" = "स्विट्ज़रलैंड के पास दुनिया का एकमात्र वर्गाकार राष्ट्रीय ध्वज है। वेटिकन का झंडा भी चौकोर है लेकिन यह एक शहर-राज्य है।";
"FACT_03_TITLE" = "गैर-आयताकार ध्वज";
"FACT_03_DESC" = "नेपाल का विश्व में एकमात्र राष्ट्रीय ध्वज है जो आयताकार नहीं है।";
"FACT_04_TITLE" = "कोई लाल, सफ़ेद या नीला नहीं";
"FACT_04_DESC" = "जमैका एकमात्र ऐसा देश है जिसका झंडा लाल, सफ़ेद या नीला नहीं है।";
"FACT_05_TITLE" = "वह झंडा जो कभी झुकाया नहीं जाता";
"FACT_05_DESC" = "सऊदी अरब का झंडा उस पर लिखे पवित्र पाठ के कारण कभी आधा झुका नहीं रहता।";
"FACT_06_TITLE" = "युवा राष्ट्रीय ध्वज";
"FACT_06_DESC" = "दक्षिण सूडान का झंडा आज़ादी के बाद 2011 में अपनाया गया था।";
"FACT_07_TITLE" = "एके-47 से झंडा लहराया";
"FACT_07_DESC" = "मोज़ाम्बिक एकमात्र ऐसा देश है जिसके झंडे पर आधुनिक हथियार - कलाश्निकोव राइफल - अंकित है।";
"FACT_08_TITLE" = "लगभग एक जैसे झंडे";
"FACT_08_DESC" = "रोमानिया और चाड के झंडे बहुत समान हैं; वे आमतौर पर नीले रंग की छाया से पहचाने जाते हैं।";
"FACT_09_TITLE" = "यूक्रेन का प्रतीकवाद";
"FACT_09_DESC" = "यूक्रेन के नीले और पीले झंडे को पारंपरिक रूप से गेहूं के खेत के ऊपर आसमान के रूप में समझा जाता है।";
"FACT_10_TITLE" = "सबसे सरल झंडा";
"FACT_10_DESC" = "1977 से 2011 तक लीबिया का झंडा बिना किसी प्रतीक या पैटर्न के ठोस हरा था।";
"FACT_11_TITLE" = "मानचित्र के साथ ध्वजांकित करें";
"FACT_11_DESC" = "साइप्रस का झंडा द्वीप की रूपरेखा दर्शाता है - राष्ट्रीय झंडों के बीच एक दुर्लभ मामला।";
"FACT_12_TITLE" = "बाइबिल के साथ झंडा";
"FACT_12_DESC" = "डोमिनिकन गणराज्य का झंडा एक खुली बाइबिल दिखाता है, जिससे यह धार्मिक पुस्तक वाला एकमात्र राष्ट्रीय ध्वज बन जाता है।";
"FACT_13_TITLE" = "सबसे लोकप्रिय रंग";
"FACT_13_DESC" = "दुनिया भर में राष्ट्रीय झंडों पर लाल सबसे आम रंग है।";
"FACT_14_TITLE" = "पाठ के साथ ध्वजांकित करें";
"FACT_14_DESC" = "राष्ट्रीय झंडों पर पाठ दुर्लभ है; एक प्रसिद्ध उदाहरण सऊदी अरब है।";
"FACT_15_TITLE" = "ध्वज शिष्टाचार";
"FACT_15_DESC" = "कई देशों में राष्ट्रीय ध्वज के साथ कैसा व्यवहार किया जाए इस पर सख्त नियम हैं।";
"FACT_16_TITLE" = "विभिन्न पक्षों वाला झंडा";
"FACT_16_DESC" = "पराग्वे के पास दुनिया का एकमात्र राष्ट्रीय ध्वज है जिसके आगे और पीछे अलग-अलग डिज़ाइन हैं।";
"FACT_17_TITLE" = "ओलंपिक प्रतीकवाद";
"FACT_17_DESC" = "ओलंपिक रिंग के रंग इसलिए चुने गए ताकि हर देश के झंडे पर कम से कम एक रंग दिखाई दे।";
"FACT_18_TITLE" = "हथियारों के सबसे जटिल कोट वाला झंडा";
"FACT_18_DESC" = "मेक्सिको के झंडे में कैक्टस पर बैठे एक बाज को सांप को पकड़े हुए दिखाया गया है - जो किसी भी झंडे पर हथियारों के सबसे विस्तृत कोटों में से एक है।";
"FACT_19_TITLE" = "नकलची झंडा";
"FACT_19_DESC" = "मोनाको और इंडोनेशिया के झंडे लगभग एक जैसे हैं- ऊपर लाल, नीचे सफेद। एकमात्र अंतर अनुपात का है।";
"FACT_20_TITLE" = "50 सितारों वाला झंडा";
"FACT_20_DESC" = "अमेरिकी ध्वज में 50 सितारे हैं, प्रत्येक राज्य के लिए एक। 1777 के बाद से डिज़ाइन को 27 बार बदला गया है।";
"FACT_21_TITLE" = "सबसे उत्तरी झंडे";
"FACT_21_DESC" = "आर्कटिक क्षेत्र अद्वितीय प्रतीकवाद के साथ राष्ट्रीय और क्षेत्रीय दोनों झंडों का उपयोग करते हैं।";
"FACT_22_TITLE" = "क्रॉस वाला झंडा";
"FACT_22_DESC" = "29 देशों के झंडे पर क्रॉस है, जो इसे राष्ट्रीय झंडे पर सबसे लोकप्रिय प्रतीकों में से एक बनाता है।";
"FACT_23_TITLE" = "Tricolors";
"FACT_23_DESC" = "कई देश ऐतिहासिक रूप से स्थिर ध्वज स्वरूप के रूप में एक साधारण तीन-धारी डिज़ाइन का उपयोग करते हैं।";
"FACT_24_TITLE" = "अर्धचंद्राकार ध्वज";
"FACT_24_DESC" = "अर्धचंद्र 12 देशों के झंडों पर दिखाई देता है, जिनमें अधिकतर मुस्लिम हैं, जो इस्लामी आस्था का प्रतीक है।";
"FACT_25_TITLE" = "सूर्य चिन्ह";
"FACT_25_DESC" = "सूरज एशिया और दक्षिण अमेरिका में झंडों पर सबसे आम प्रतीकों में से एक है।";
"FACT_26_TITLE" = "एक पेड़ के साथ झंडा";
"FACT_26_DESC" = "लेबनान एकमात्र ऐसा देश है जिसके झंडे पर एक पेड़ (लेबनानी देवदार) है, जो अनंत काल और शांति का प्रतीक है।";
"FACT_27_TITLE" = "सबसे संकीर्ण झंडा";
"FACT_27_DESC" = "कतर के झंडे का पहलू अनुपात किसी भी राष्ट्रीय ध्वज का सबसे असामान्य है—11:28।";
"FACT_28_TITLE" = "हथियारों के जटिल कोट";
"FACT_28_DESC" = "लैटिन अमेरिकी झंडों पर हथियारों के कोट में अक्सर कई विवरण और ऐतिहासिक प्रतीक शामिल होते हैं।";
"FACT_29_TITLE" = "इंद्रधनुष झंडा";
"FACT_29_DESC" = "बोलीविया के दो आधिकारिक झंडे हैं- पारंपरिक तिरंगा और स्वदेशी विफला इंद्रधनुष झंडा।";
"FACT_30_TITLE" = "एक इमारत के साथ झंडा";
"FACT_30_DESC" = "कंबोडिया के झंडे में अंगकोरवाट मंदिर दिखाया गया है, जिससे यह इमारत वाला एकमात्र राष्ट्रीय ध्वज बन गया है।";
"FACT_31_TITLE" = "ऐतिहासिक विवाद";
"FACT_31_DESC" = "देशों के बीच ऐतिहासिक और राजनीतिक विवादों के कारण कुछ झंडों का डिज़ाइन बदल गया है।";
"FACT_32_TITLE" = "तलवार से झंडा फहराओ";
"FACT_32_DESC" = "श्रीलंका के झंडे में एक शेर को तलवार पकड़े हुए दिखाया गया है, जो सिंहली लोगों के साहस का प्रतीक है।";
"FACT_33_TITLE" = "बिना नीले रंग का झंडा";
"FACT_33_DESC" = "केवल चार देश अपने झंडे पर नीले रंग का उपयोग नहीं करते हैं: जमैका, मॉरिटानिया, श्रीलंका और वेटिकन।";
"FACT_34_TITLE" = "झंडों पर पक्षी";
"FACT_34_DESC" = "झंडों पर ईगल और अन्य पक्षी शक्ति, स्वतंत्रता और आत्मा की कुलीनता का प्रतीक हैं।";
"FACT_35_TITLE" = "अंटार्कटिक प्रतीक";
"FACT_35_DESC" = "अंटार्कटिका का कोई आधिकारिक राष्ट्रीय ध्वज नहीं है, लेकिन कई अनौपचारिक डिजाइनों का उपयोग किया जाता है।";
"FACT_36_TITLE" = "झंडों पर सितारे";
"FACT_36_DESC" = "सितारा दुनिया भर के झंडों पर सबसे व्यापक प्रतीकों में से एक है।";
"FACT_37_TITLE" = "समान रंग योजनाएं";
"FACT_37_DESC" = "कुछ झंडे रंग में समान होते हैं लेकिन पट्टियों और प्रतीक के क्रम में भिन्न होते हैं।";
"FACT_38_TITLE" = "अंतर्राष्ट्रीय संघ के झंडे";
"FACT_38_DESC" = "सुपरनैशनल संगठनों के पास साझा मूल्यों को प्रतिबिंबित करने वाले अपने स्वयं के झंडे भी हैं।";
"FACT_39_TITLE" = "द्वीप प्रतीकवाद";
"FACT_39_DESC" = "द्वीप राष्ट्रों के झंडों में अक्सर समुद्र, सूर्य और नेविगेशन के प्रतीक होते हैं।";
"FACT_40_TITLE" = "समय के साथ बदलता है";
"FACT_40_DESC" = "कुछ राष्ट्रीय झंडे अपने देश के राजनीतिक इतिहास के साथ दर्जनों बार बदले हैं।";
"FACT_41_TITLE" = "उत्तर मैसेडोनिया सूरज";
"FACT_41_DESC" = "उत्तरी मैसेडोनिया के झंडे में एक नई शुरुआत के लिए आठ किरणों वाला सूरज है।";
"FACT_42_TITLE" = "बेलीज़ लकड़हारे";
"FACT_42_DESC" = "बेलीज़ का झंडा दिखाने वाले कुछ लोगों में से एक है: औजारों के साथ लकड़हारे।";
"FACT_43_TITLE" = "इक्वेडोर कोंडोर";
"FACT_43_DESC" = "इक्वाडोर के झंडे में ताकत और संप्रभुता के लिए एंडियन कोंडोर शामिल है।";
"FACT_44_TITLE" = "बोलीविया विफला";
"FACT_44_DESC" = "बोलीविया आधिकारिक प्रतीक के रूप में तिरंगे के साथ विफाला का उपयोग करता है।";
"FACT_45_TITLE" = "ब्राज़ील के 27 सितारे";
"FACT_45_DESC" = "ब्राज़ीलियाई ध्वज में 27 सितारे हैं, प्रत्येक राज्य और संघीय जिले के लिए एक।";
"FACT_46_TITLE" = "मेपल का पत्ता";
"FACT_46_DESC" = "कनाडा के झंडे में 11-नुकीले मेपल का एक पत्ता है, जो राष्ट्रीय झंडों में अद्वितीय है।";
"FACT_47_TITLE" = "यूनियक जैक";
"FACT_47_DESC" = "ब्रिटेन का झंडा तीन संतों के क्रॉस को जोड़ता है: इंग्लैंड, स्कॉटलैंड और आयरलैंड।";
"FACT_48_TITLE" = "जापान का उगता सूरज";
"FACT_48_DESC" = "सफेद पर लाल घेरा उगते सूरज का प्रतिनिधित्व करता है और 7वीं शताब्दी से जापान के झंडे पर इसका इस्तेमाल किया जाता रहा है।";
"FACT_49_TITLE" = "अशोक चक्र";
"FACT_49_DESC" = "भारत के झंडे में 24 तीलियों वाला पहिया है, जो कानून और गति का प्रतीक है।";
"FACT_50_TITLE" = "ऑस्ट्रेलिया का दक्षिणी क्रॉस";
"FACT_50_DESC" = "ऑस्ट्रेलिया का झंडा दक्षिणी क्रॉस तारामंडल को दर्शाता है, जो केवल दक्षिणी गोलार्ध में दिखाई देता है।";
"FACT_51_TITLE" = "न्यूज़ीलैंड का दक्षिणी क्रॉस";
"FACT_51_DESC" = "न्यूज़ीलैंड के झंडे में दक्षिणी क्रॉस भी है, लेकिन सफेद किनारे पर लाल सितारे हैं।";
"FACT_52_TITLE" = "दक्षिण कोरिया का ताएगुक";
"FACT_52_DESC" = "दक्षिण कोरिया के झंडे में पारंपरिक ताएगुक (यिन-यांग) प्रतीक और ट्रिग्राम हैं।";
"FACT_53_TITLE" = "पुर्तगाल का शस्त्रागार क्षेत्र";
"FACT_53_DESC" = "पुर्तगाल के झंडे में एक शस्त्रागार क्षेत्र, एक प्राचीन नौवहन उपकरण है।";
"FACT_54_TITLE" = "अल्बानिया का दो सिर वाला चील";
"FACT_54_DESC" = "अल्बानिया के झंडे में काले दो सिरों वाला ईगल दर्शाया गया है, जो संप्रभुता का प्रतीक है।";
"FACT_55_TITLE" = "केन्या की ढाल";
"FACT_55_DESC" = "केन्या के झंडे में मासाई ढाल और पार किए गए भाले हैं।";
"FACT_56_TITLE" = "वेल्स का ड्रैगन";
"FACT_56_DESC" = "वेल्स के झंडे पर लाल ड्रैगन दुनिया के सबसे पुराने राष्ट्रीय प्रतीकों में से एक है।";
"FACT_57_TITLE" = "सेंट एंड्रयूज क्रॉस";
"FACT_57_DESC" = "स्कॉटलैंड का झंडा नीले रंग पर एक सफेद विकर्ण क्रॉस, सेंट एंड्रयू का क्रॉस है।";
"FACT_58_TITLE" = "ग्रीनलैंड का घेरा";
"FACT_58_DESC" = "ग्रीनलैंड के झंडे में एक लाल और सफेद वृत्त है जो बर्फ के ऊपर सूर्य का प्रतिनिधित्व करता है।";
"FACT_59_TITLE" = "पैन-अफ्रीकी रंग";
"FACT_59_DESC" = "हरे, पीले और लाल को अक्सर पैन-अफ़्रीकी रंग कहा जाता है और ये कई अफ़्रीकी झंडों पर दिखाई देते हैं।";
"FACT_60_TITLE" = "नॉर्डिक क्रॉस";
"FACT_60_DESC" = "पांच देश नॉर्डिक क्रॉस का उपयोग करते हैं: डेनमार्क, नॉर्वे, स्वीडन, फिनलैंड और आइसलैंड।";
"FACT_61_TITLE" = "फ़्रेंच तिरंगा";
"FACT_61_DESC" = "फ्रांसीसी नीला-सफ़ेद-लाल तिरंगा कई क्रांतिकारी और राष्ट्रीय झंडों के लिए एक मॉडल बन गया।";
"FACT_62_TITLE" = "संयुक्त राष्ट्र का झंडा";
"FACT_62_DESC" = "संयुक्त राष्ट्र का झंडा नीले रंग की पृष्ठभूमि पर दुनिया को जैतून की शाखाओं से घिरा हुआ दिखाता है।";
"FACT_63_TITLE" = "यूरोपीय संघ का झंडा";
"FACT_63_DESC" = "नीले रंग पर एक वृत्त में बारह सुनहरे सितारे यूरोपीय संघ की एकता का प्रतीक हैं।";
"FACT_64_TITLE" = "ओलंपिक ध्वज";
"FACT_64_DESC" = "सफेद रंग पर पांच छल्ले पांच बसे हुए महाद्वीपों और खेलों की वैश्विक प्रकृति का प्रतिनिधित्व करते हैं।";
"FACT_65_TITLE" = "वेटिकन स्क्वायर";
"FACT_65_DESC" = "वेटिकन का राष्ट्रीय ध्वज स्विट्जरलैंड की तरह चौकोर है।";
"FACT_66_TITLE" = "नाउरू 12 अंक";
"FACT_66_DESC" = "नाउरू ध्वज में 12 जनजातियों के लिए 12-नोकीय सितारा है।";
"FACT_67_TITLE" = "तुर्कमेनिस्तान कालीन";
"FACT_67_DESC" = "तुर्कमेनिस्तान के झंडे में लहरा के साथ कालीन पैटर्न हैं।";
"FACT_68_TITLE" = "अफगानिस्तान मस्जिद";
"FACT_68_DESC" = "अफगानिस्तान के झंडे के डिजाइन में एक मस्जिद को दर्शाया गया है।";

